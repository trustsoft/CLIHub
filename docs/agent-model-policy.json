{
  "version": 1,
  "_comment": "CLIHub subagent model policy. THREE axes per dispatch: model (which model), effort (reasoning level), and the fallback chain. TWO LAYERS: this file (versioned, human-curated) + .opencode/model-policy.json (gitignored runtime selection). Resolution at dispatch: effective_preset = first override whose window contains now, else active_preset; take the role's ordered list, drop models whose exhausted_until is in the future, try in order. Availability failure (429/quota/billing/auth/not-found) -> mark exhausted_until = now + backoff, try next. Quality failure -> escalate to the next model in the same list. If on_exhaustion is block_and_ask and no acceptable model remains -> STOP and ask the user. Merge rule for the runtime file: the orchestrator owns exhausted_until and session_log; the sidebar owns active_preset and role_overrides; each writer read-modify-writes only its own fields, atomically.",
  "_effort_note": "effort is a normalized level (off|low|medium|high|max) that the resolver maps onto the chosen model's supported `variants` (nearest at or below the level; `off` means `none` when supported, otherwise no variant). A chain entry may override it as `model#variant`. Reasoning level consumes more tokens, so on a metered plan a high effort burns the quota faster; the exhaustion logic does not yet weight this.",
  "active_preset": "default",
  "roles": {
    "planner": { "agents": ["pipe/planner"], "tier": "high", "effort": "high", "on_exhaustion": "block_and_ask" },
    "implementer": { "agents": ["pipe/implementer"], "tier": "high", "effort": "medium", "on_exhaustion": "next" },
    "verifier": { "agents": ["pipe/verifier"], "tier": "high", "effort": "high", "on_exhaustion": "block_and_ask" },
    "explorer": { "agents": ["explore"], "tier": "any", "effort": "low", "on_exhaustion": "next" },
    "research": { "agents": ["general"], "tier": "medium", "effort": "medium", "on_exhaustion": "next" },
    "mechanical": { "agents": [], "tier": "any", "effort": "low", "on_exhaustion": "next" }
  },
