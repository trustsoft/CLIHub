<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.1" />
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SeedPlugins\**\*.json" />
    <EmbeddedResource Include="SeedPlugins\**\*.png" />

    <!-- The user-facing release notes live at the repository root (next to CHANGELOG.md) and are
         embedded by link, so there is one copy of the document rather than a duplicate under src/. -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\RELEASE-NOTES.md"
                      Link="ReleaseNotes\RELEASE-NOTES.md"
                      LogicalName="CLIHub.Core.ReleaseNotes.RELEASE-NOTES.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CLIHub.Tests" />
  </ItemGroup>

</Project>
