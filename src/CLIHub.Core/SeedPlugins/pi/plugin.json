{
  "id": "pi",
  "name": "Pi",
  "description": "AI coding assistant CLI",
  "version": "1.0.0",
  "publisher": "CLIHub",
  "homepage": "https://www.npmjs.com/package/@earendil-works/pi-coding-agent",
  "commands": {
    "launch": { "executable": "pi" },
    "resume": { "executable": "pi", "arguments": "--continue" },
    "version": { "executable": "pi", "arguments": "--version" },
    "update": { "executable": "pi", "arguments": "update" }
  },
  "updateCheck": {
    "source": "npm",
    "package": "@earendil-works/pi-coding-agent"
  },
  "detection": {
    "systemPaths": [
      "%USERPROFILE%\\.pi"
    ],
    "projectIndicators": [
      ".pi"
    ]
  }
}
