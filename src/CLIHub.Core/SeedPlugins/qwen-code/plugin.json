{
  "id": "qwen-code",
  "name": "Qwen Code",
  "description": "Qwen Code CLI",
  "version": "1.0.0",
  "publisher": "CLIHub",
  "homepage": "https://www.npmjs.com/package/@qwen-code/qwen-code",
  "commands": {
    "launch": { "executable": "qwen" },
    "resume": { "executable": "qwen", "arguments": "--continue" },
    "version": { "executable": "qwen", "arguments": "--version" },
    "update": { "executable": "qwen", "arguments": "update" }
  },
  "updateCheck": {
    "source": "npm",
    "package": "@qwen-code/qwen-code"
  },
  "detection": {
    "systemPaths": [
      "%USERPROFILE%\\.qwen",
      "%LOCALAPPDATA%\\qwen-code"
    ],
    "projectIndicators": [
      ".qwen",
      "QWEN.md"
    ]
  }
}
