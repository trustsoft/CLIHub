{
  "id": "cline-cli",
  "name": "Cline CLI",
  "description": "Cline AI coding assistant CLI",
  "commands": {
    "launch": { "executable": "cline" },
    "version": { "executable": "cline", "arguments": "--version" },
    "update": { "executable": "cline", "arguments": "update" }
  },
  "updateCheck": {
    "source": "npm",
    "package": "cline"
  },
  "detection": {
    "systemPaths": [
      "%USERPROFILE%\\.cline",
      "%LOCALAPPDATA%\\cline"
    ],
    "projectIndicators": [
      ".clinerules"
    ]
  }
}
