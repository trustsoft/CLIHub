<Window x:Class="CLIHub.App.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CLIHub"
        Width="720"
        Height="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        KeyDown="OnKeyDown"
        Deactivated="OnDeactivated">
    <Border BorderBrush="#FF3C3C3C" BorderThickness="1" Background="#FFF7F7F7">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="0,0,12,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Projects" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Menu HorizontalAlignment="Right" Background="Transparent">
                            <MenuItem Header="Actions">
                                <MenuItem Header="Add" Command="{Binding AddProjectCommand}" />
                                <MenuItem Header="Remove" Command="{Binding RemoveProjectCommand}" />
                            </MenuItem>
                        </Menu>
                    </DockPanel>
                    <Grid>
                        <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Image Source="{Binding Logo}"
                                               Width="20"
                                               Height="20"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#FF888888" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Нет проектов. Добавьте через Actions -> Add."
                                   Foreground="#FF888888"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Projects.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>

                <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Top" Text="Agents" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding Agents}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0"
                                           Source="{Binding Logo}"
                                           Width="20"
                                           Height="20"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Version}"
                                                   Margin="8,0,0,0"
                                                   FontSize="10"
                                                   Foreground="#FF888888"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="Запустить"
                                            Padding="10,2"
                                            Command="{Binding RunCommand}"
                                            IsEnabled="{Binding CanRun}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <TextBlock Text="CLIHub" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" Foreground="#FF666666" />
            </Grid>
        </Grid>
    </Border>
</Window>
