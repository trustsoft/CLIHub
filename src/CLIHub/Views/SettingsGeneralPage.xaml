<UserControl x:Class="CLIHub.Views.SettingsGeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CLIHub.Controls"
             xmlns:themes="clr-namespace:CLIHub.Themes"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock Style="{StaticResource PageHeader}" Text="General &amp; Startup"/>
        <TextBlock Margin="0,6,0,0"
                   Style="{StaticResource HintText}"
                   Text="Startup behavior and how the window opens."/>

        <controls:SettingCard Margin="0,16,0,8"
                           Title="Start with Windows"
                           Hint="Launch CLIHub automatically when you sign in to Windows."
                           Icon="{x:Static themes:IconGlyphs.Power}">
            <CheckBox HorizontalAlignment="Right"
                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                      Style="{StaticResource SettingsCheck}"/>
        </controls:SettingCard>
        <controls:SettingCard Title="Start minimized to tray"
                           Hint="Start CLIHub minimized in the system tray instead of showing the window."
                           Icon="{x:Static themes:IconGlyphs.ChevronDown}">
            <CheckBox HorizontalAlignment="Right"
                      IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                      Style="{StaticResource SettingsCheck}"/>
        </controls:SettingCard>
    </StackPanel>
</UserControl>
