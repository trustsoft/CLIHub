<UserControl x:Class="CLIHub.Views.SettingsGeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock Style="{StaticResource PageHeader}" Text="General &amp; Startup"/>

        <CheckBox Margin="0,16,0,0"
                  HorizontalAlignment="Left"
                  Content="Start with Windows"
                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                  Style="{StaticResource SettingsCheck}"/>
        <TextBlock Margin="0,6,0,0"
                   Style="{StaticResource HintText}"
                   Text="Launch CLIHub automatically when you sign in to Windows."/>

        <CheckBox Margin="0,16,0,0"
                  HorizontalAlignment="Left"
                  Content="Show window on startup"
                  IsChecked="{Binding ShowWindowOnStartup, Mode=TwoWay}"
                  Style="{StaticResource SettingsCheck}"/>
        <TextBlock Margin="0,6,0,0"
                   Style="{StaticResource HintText}"
                   Text="Show the launch window when CLIHub starts; otherwise it opens in the tray."/>
    </StackPanel>
</UserControl>
