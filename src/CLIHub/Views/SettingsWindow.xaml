<Window x:Class="CLIHub.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:themes="clr-namespace:CLIHub.Themes"
        xmlns:conv="clr-namespace:CLIHub.Converters"
        xmlns:controls="clr-namespace:CLIHub.Controls"
        xmlns:views="clr-namespace:CLIHub.Views"
        mc:Ignorable="d"
        Title="Settings"
        Icon="pack://application:,,,/app.ico"
        Background="{DynamicResource ChromeBgBrush}"
        FontFamily="{StaticResource Sizing.FontFamily.Text}"
        Height="687" Width="888"
        MinHeight="480" MinWidth="640"
        KeyDown="OnKeyDown"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        SourceInitialized="OnSourceInitialized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <conv:UpperCaseTextConverter x:Key="UpperCase"/>

            <!--
                Status indicator chip for the Updates tab header. These styles are window-scoped
                because every reference is inside this window's DataTemplates; Settings pages never
                use them. They are declared before the first DataTemplate that uses them because
                StaticResource has no forward reference inside a resource dictionary. The chip bases
                on the application-level HeaderChip, which a window resource can reach at load time.
            -->
            <Style x:Key="StatusChip" TargetType="Border" BasedOn="{StaticResource HeaderChip}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding UpdateStatusBadgeTone}"
                                 Value="{x:Static controls:SettingBadgeTone.Success}">
                        <Setter Property="Background" Value="{DynamicResource SuccessSelectionBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding UpdateStatusBadgeTone}"
                                 Value="{x:Static controls:SettingBadgeTone.Accent}">
                        <Setter Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StatusChipGlyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Sizing.FontFamily.Icon}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding UpdateStatusBadgeTone}"
                                 Value="{x:Static controls:SettingBadgeTone.Success}">
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding UpdateStatusBadgeTone}"
                                 Value="{x:Static controls:SettingBadgeTone.Accent}">
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StatusChipText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Chip}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding UpdateStatusBadgeTone}"
                                 Value="{x:Static controls:SettingBadgeTone.Success}">
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding UpdateStatusBadgeTone}"
                                 Value="{x:Static controls:SettingBadgeTone.Accent}">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Page-specific metadata shown next to the Updates title. -->
            <DataTemplate x:Key="UpdatesHeaderTitleExtra">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource HeaderChip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource HeaderChipLabel}" Text="Version: "/>
                            <TextBlock Style="{StaticResource HeaderChipValue}"
                                       Text="{Binding Version, StringFormat=v{0}}"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0,0,0" Style="{StaticResource HeaderChip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource HeaderChipLabel}" Text="Channel: "/>
                            <TextBlock Style="{StaticResource HeaderChipValue}" Text="Stable"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- Page-specific actions and status rendered in the fixed page header. -->
            <DataTemplate x:Key="UpdatesHeaderAction">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Border Style="{StaticResource StatusChip}" ToolTip="{Binding UpdateStatusDetail}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource StatusChipGlyph}" Text="{Binding UpdateStatusGlyph}"/>
                                <TextBlock Margin="4,0,0,0"
                                           Style="{StaticResource StatusChipText}"
                                           Text="{Binding UpdateStatusBadge}"/>
                            </StackPanel>
                        </Border>
                        <Button AutomationProperties.Name="Check for updates"
                                Command="{Binding CheckForUpdatesCommand}"
                                Margin="8,0,0,0"
                                Padding="9,7"
                                Style="{StaticResource AccentButton}"
                                ToolTip="Check for updates">
                            <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                       FontSize="14"
                                       Text="{x:Static themes:IconGlyphs.Refresh}"/>
                        </Button>
                    </StackPanel>

                    <Button Grid.Row="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,4,0,0"
                            Command="{Binding ShowReleaseNotesCommand}"
                            Content="View release notes  →"
                            Style="{StaticResource LinkButton}"
                            ToolTip="Open What's New"/>
                </Grid>
            </DataTemplate>

            <!-- Project Discovery actions: add a root or rescan the saved configuration. -->
            <DataTemplate x:Key="ProjectsHeaderAction">
                <controls:SpacedPanel VerticalAlignment="Center"
                                      Orientation="Horizontal"
                                      Spacing="8">
                    <Button Width="{StaticResource Sizing.IconButton.Width}"
                            Height="{StaticResource Sizing.IconButton.Height}"
                            AutomationProperties.Name="Add Directory"
                            Command="{Binding AddWatchedDirectoryFromPickerCommand}"
                            Padding="0"
                            Style="{StaticResource SettingsIconButton}"
                            ToolTip="Add a watched root directory">
                        <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                   FontSize="16"
                                   Text="{x:Static themes:IconGlyphs.FolderAdd}"/>
                    </Button>
                    <Button Width="{StaticResource Sizing.IconButton.Width}"
                            Height="{StaticResource Sizing.IconButton.Height}"
                            AutomationProperties.Name="Scan Now"
                            Command="{Binding ScanNowCommand}"
                            Padding="0"
                            Style="{StaticResource AccentButton}"
                            ToolTip="Rescan every watched folder">
                        <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                   FontSize="16"
                                   Text="{x:Static themes:IconGlyphs.Refresh}"/>
                    </Button>
                </controls:SpacedPanel>
            </DataTemplate>

            <!-- Project Discovery summary cards, pinned to the page header. -->
            <DataTemplate x:Key="ProjectsSummaryCards">
                <controls:SpacedPanel Orientation="Horizontal" Spacing="8" StretchChildren="True">
                    <Border Padding="9"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="{StaticResource Sizing.FontSize.Section}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="PROJECTS"/>
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="{StaticResource Sizing.FontSize.SummaryValue}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding TotalProjectCount}"/>
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource HintText}"
                                           Text="{Binding ProjectMixSummary}"
                                           TextWrapping="Wrap"
                                           ToolTip="Projects found by scanning plus projects added manually"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource ThumbBgBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="{x:Static themes:IconGlyphs.FolderOpen}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Padding="9"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="{StaticResource Sizing.FontSize.Section}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="AGENTS"/>
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="{StaticResource Sizing.FontSize.SummaryValue}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding AgentsInstalledCount}"/>
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource HintText}"
                                           Text="{Binding AgentsSupportSummary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource ThumbBgBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           Text="{x:Static themes:IconGlyphs.Robot}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Padding="9"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="{StaticResource Sizing.FontSize.Section}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="DAEMON"/>
                                <TextBlock Margin="0,2,0,0"
                                           Text="{Binding WatcherStateLabel}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.SummaryValue}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WatcherStateLabel}" Value="Watching">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding WatcherStateLabel}" Value="Scanning">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding WatcherStateLabel}" Value="Error">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource HintText}"
                                           Text="{Binding WatcherDetailText}"
                                           TextWrapping="Wrap"
                                           ToolTip="{Binding WatcherDetailText}"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource ThumbBgBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{x:Static themes:IconGlyphs.Sync}"/>
                            </Border>
                        </Grid>
                    </Border>
                </controls:SpacedPanel>
            </DataTemplate>

            <DataTemplate x:Key="RegistrySummaryCards">
                <controls:SpacedPanel Orientation="Horizontal" Spacing="8" StretchChildren="True">
                    <Border Padding="9"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="{StaticResource Sizing.FontSize.Section}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="PROJECTS"/>
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="{StaticResource Sizing.FontSize.SummaryValue}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding ProjectRegistry.TotalCount}"/>
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource HintText}"
                                           Text="{Binding ProjectRegistry.ProjectMixSummary}"
                                           TextWrapping="Wrap"
                                           ToolTip="Projects found by scanning plus projects added manually"/>
                                <TextBlock Margin="0,2,0,0"
                                           Text="{Binding ProjectRegistry.FolderStatusSummary}"
                                           TextWrapping="Wrap"
                                           ToolTip="Projects whose folder no longer exists"
                                           Visibility="{Binding ProjectRegistry.HasMissingFolders, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProjectRegistry.HasMissingFolders}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource ThumbBgBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="{x:Static themes:IconGlyphs.FolderOpen}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Padding="9"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="{StaticResource Sizing.FontSize.Section}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="MANUAL"/>
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="{StaticResource Sizing.FontSize.SummaryValue}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding ProjectRegistry.ManualCount}"/>
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource HintText}"
                                           Text="Registered manually"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource ThumbBgBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="{x:Static themes:IconGlyphs.FolderAdd}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Padding="9"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="{StaticResource Sizing.FontSize.Section}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="DISCOVERED"/>
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="{StaticResource Sizing.FontSize.SummaryValue}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding ProjectRegistry.DiscoveredCount}"/>
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource HintText}"
                                           Text="Managed by Project Discovery"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource ThumbBgBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{x:Static themes:IconGlyphs.Sync}"/>
                            </Border>
                        </Grid>
                    </Border>
                </controls:SpacedPanel>
            </DataTemplate>

            <!-- CLI Agents summary cards, pinned to the page header. -->
            <DataTemplate x:Key="AgentsSummaryCards">
                <controls:SpacedPanel Orientation="Horizontal" Spacing="8" StretchChildren="True">
                    <Border Padding="9"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="{StaticResource Sizing.FontSize.Section}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="AGENTS"/>
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="{StaticResource Sizing.FontSize.SummaryValue}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding AgentsState.InstalledAgentCount}"/>
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource HintText}"
                                           Text="{Binding AgentsState.AvailabilitySummary}"
                                           TextWrapping="Wrap"
                                           ToolTip="Installed agents and the number of supported plugins"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource ThumbBgBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           Text="{x:Static themes:IconGlyphs.Robot}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Padding="9"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="{StaticResource Sizing.FontSize.Section}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="DEFAULT"/>
                                <TextBlock Margin="0,2,0,0"
                                           Text="{Binding AgentsState.DefaultAgentName}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           ToolTip="{Binding AgentsState.DefaultAgentName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.SummaryValue}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AgentsState.HasDefaultAgent}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource HintText}"
                                           Text="{Binding AgentsState.DefaultAgentDetail}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource ThumbBgBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="{x:Static themes:IconGlyphs.FavoriteStar}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Padding="9"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="{StaticResource Sizing.FontSize.Section}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="PROBE"/>
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="{StaticResource Sizing.FontSize.SummaryValue}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding ProbePolicySummary}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"/>
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource HintText}"
                                           Text="{Binding ProbePolicyDetail}"
                                           TextWrapping="Wrap"
                                           ToolTip="Effective agent probe cache and timeout"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource ThumbBgBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{x:Static themes:IconGlyphs.Diagnostic}"/>
                            </Border>
                        </Grid>
                    </Border>
                </controls:SpacedPanel>
            </DataTemplate>

            <!-- Navigation pages grouped by their group title; group order follows first appearance. -->
            <CollectionViewSource x:Key="NavPages" Source="{Binding Pages}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Group"/>
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource FieldStrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Inset top highlight (shared chrome) -->
            <Rectangle Grid.Row="0" Height="1" Fill="{DynamicResource TopHighlightBrush}"/>

            <!-- Drawn header: app identity, maximize/restore, close, drag -->
            <Grid Grid.Row="1"
                  MouseLeftButtonDown="OnHeaderMouseDown"
                  Style="{StaticResource WindowHeader}">
                <StackPanel Margin="12,0,0,0"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Width="16"
                           Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="pack://application:,,,/app.ico"/>
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="CLIHub - Settings"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Click="OnMaximizeRestoreClick"
                            Style="{StaticResource WindowCloseButton}"
                            ToolTip="Maximize">
                        <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{x:Static themes:IconGlyphs.Maximize}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Text" Value="{x:Static themes:IconGlyphs.Restore}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Click="OnCloseClick"
                            Style="{StaticResource WindowCloseButton}"
                            ToolTip="Close">
                        <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}" FontSize="14" Text="{x:Static themes:IconGlyphs.Close}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="1"
                       Height="1"
                       VerticalAlignment="Bottom"
                       Fill="{DynamicResource HairlineBrush}"/>

            <!-- Body: sidebar navigation + active page -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource PopoverBgBrush}"
                        BorderBrush="{DynamicResource HairlineBrush}"
                        BorderThickness="0,0,1,0">
                    <ScrollViewer Padding="10,0,10,12"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="NavList"
                                 ItemsSource="{Binding Source={StaticResource NavPages}}"
                                 SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                                 Style="{StaticResource SidebarList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Width="18"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding Icon}"/>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Title}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SidebarGroupLabel}"
                                                       Text="{Binding Name, Converter={StaticResource UpperCase}}"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>
                    </ScrollViewer>
                </Border>

                <!-- Active page -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Page header: stays visible while only the content below it scrolls -->
                    <Grid Grid.Row="0" Margin="24,16,24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource PageHeader}" Text="{Binding SelectedPage.Title}"/>
                                <ContentControl Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Content="{Binding}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPage.Key}" Value="updates">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="ContentTemplate" Value="{StaticResource UpdatesHeaderTitleExtra}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </WrapPanel>
                            <TextBlock Margin="0,6,0,0" Text="{Binding SelectedPage.Description}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPage.Description}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <ContentControl Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Stretch"
                                        Content="{Binding}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPage.Key}" Value="updates">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="ContentTemplate" Value="{StaticResource UpdatesHeaderAction}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedPage.Key}" Value="projects">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="ContentTemplate" Value="{StaticResource ProjectsHeaderAction}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>

                        <!-- Summary row: page-specific cards, part of the fixed header above the divider. -->
                        <ContentControl Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,14,0,0"
                                        HorizontalContentAlignment="Stretch"
                                        Content="{Binding}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPage.Key}" Value="projects">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="ContentTemplate" Value="{StaticResource ProjectsSummaryCards}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedPage.Key}" Value="projects-registry">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="ContentTemplate" Value="{StaticResource RegistrySummaryCards}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedPage.Key}" Value="agents">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="ContentTemplate" Value="{StaticResource AgentsSummaryCards}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>

                        <Rectangle Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Height="1"
                                   Margin="0,14,0,0"
                                   Fill="{DynamicResource HairlineBrush}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Padding="24,0,24,24"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <views:SettingsGeneralPage>
                                <views:SettingsGeneralPage.Style>
                                    <Style TargetType="UserControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPage.Key}" Value="general">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:SettingsGeneralPage.Style>
                            </views:SettingsGeneralPage>

                            <views:SettingsHotkeysPage>
                                <views:SettingsHotkeysPage.Style>
                                    <Style TargetType="UserControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPage.Key}" Value="hotkeys">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:SettingsHotkeysPage.Style>
                            </views:SettingsHotkeysPage>

                            <views:SettingsTerminalPage>
                                <views:SettingsTerminalPage.Style>
                                    <Style TargetType="UserControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPage.Key}" Value="terminal">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:SettingsTerminalPage.Style>
                            </views:SettingsTerminalPage>

                            <views:SettingsAgentsPage>
                                <views:SettingsAgentsPage.Style>
                                    <Style TargetType="UserControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPage.Key}" Value="agents">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:SettingsAgentsPage.Style>
                            </views:SettingsAgentsPage>

                            <views:SettingsProjectRegistryPage>
                                <views:SettingsProjectRegistryPage.Style>
                                    <Style TargetType="UserControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPage.Key}" Value="projects-registry">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:SettingsProjectRegistryPage.Style>
                            </views:SettingsProjectRegistryPage>

                            <views:SettingsProjectsPage>
                                <views:SettingsProjectsPage.Style>
                                    <Style TargetType="UserControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPage.Key}" Value="projects">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:SettingsProjectsPage.Style>
                            </views:SettingsProjectsPage>

                            <views:SettingsAppearancePage>
                                <views:SettingsAppearancePage.Style>
                                    <Style TargetType="UserControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPage.Key}" Value="appearance">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:SettingsAppearancePage.Style>
                            </views:SettingsAppearancePage>

                            <views:SettingsUpdatesPage>
                                <views:SettingsUpdatesPage.Style>
                                    <Style TargetType="UserControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPage.Key}" Value="updates">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:SettingsUpdatesPage.Style>
                            </views:SettingsUpdatesPage>

                            <views:SettingsLogsPage>
                                <views:SettingsLogsPage.Style>
                                    <Style TargetType="UserControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPage.Key}" Value="telemetry">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:SettingsLogsPage.Style>
                            </views:SettingsLogsPage>

                            <views:SettingsPlaceholderPage>
                                <views:SettingsPlaceholderPage.Style>
                                    <Style TargetType="UserControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPage.IsImplemented}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:SettingsPlaceholderPage.Style>
                            </views:SettingsPlaceholderPage>
                        </Grid>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               Margin="24,0,24,12"
                               Text="{Binding ValidationError}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ErrorText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ValidationError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ValidationError}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <!-- Footer: brand + version chip, Save/Cancel -->
            <Border Grid.Row="3" Style="{StaticResource FooterStrip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BrandText}" Text="CLIHub"/>
                        <Border Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource VersionChipBorder}">
                            <TextBlock Style="{StaticResource VersionChipText}" Text="{Binding Version}"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding SaveCommand}"
                            Content="Save"
                            IsDefault="True"
                            Margin="0,0,10,0"
                            Style="{StaticResource AccentButton}"/>
                    <Button Grid.Column="2"
                            Command="{Binding CancelCommand}"
                            Content="Cancel"
                            Style="{StaticResource NeutralButton}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
