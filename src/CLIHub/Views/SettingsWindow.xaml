<Window x:Class="CLIHub.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:themes="clr-namespace:CLIHub.Themes"
        xmlns:conv="clr-namespace:CLIHub.Converters"
        xmlns:controls="clr-namespace:CLIHub.Controls"
        xmlns:views="clr-namespace:CLIHub.Views"
        mc:Ignorable="d"
        Title="Settings"
        Icon="pack://application:,,,/app.ico"
        Background="{DynamicResource ChromeBgBrush}"
        FontFamily="{StaticResource Sizing.FontFamily.Text}"
        Height="687" Width="888"
        MinHeight="480" MinWidth="640"
        KeyDown="OnKeyDown"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        SourceInitialized="OnSourceInitialized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <conv:UpperCaseTextConverter x:Key="UpperCase"/>

            <!--
                Status indicator chip for the Updates tab header. These styles are window-scoped
                because every reference is inside this window's DataTemplates; Settings pages never
                use them. They are declared before the first DataTemplate that uses them because
                StaticResource has no forward reference inside a resource dictionary. The chip bases
                on the application-level HeaderChip, which a window resource can reach at load time.
            -->
            <Style x:Key="StatusChip" TargetType="Border" BasedOn="{StaticResource HeaderChip}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding UpdateCard.Tone}"
                                 Value="{x:Static controls:SettingBadgeTone.Success}">
                        <Setter Property="Background" Value="{DynamicResource SuccessSelectionBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding UpdateCard.Tone}"
                                 Value="{x:Static controls:SettingBadgeTone.Accent}">
                        <Setter Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StatusChipGlyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Sizing.FontFamily.Icon}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding UpdateCard.Tone}"
                                 Value="{x:Static controls:SettingBadgeTone.Success}">
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding UpdateCard.Tone}"
                                 Value="{x:Static controls:SettingBadgeTone.Accent}">
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StatusChipText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Chip}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding UpdateCard.Tone}"
                                 Value="{x:Static controls:SettingBadgeTone.Success}">
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding UpdateCard.Tone}"
                                 Value="{x:Static controls:SettingBadgeTone.Accent}">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Page-specific metadata shown next to the Updates title. -->
            <DataTemplate x:Key="UpdatesHeaderTitleExtra">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource HeaderChip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource HeaderChipLabel}" Text="Version: "/>
                            <TextBlock Style="{StaticResource HeaderChipValue}"
                                       Text="{Binding Version, StringFormat=v{0}}"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0,0,0" Style="{StaticResource HeaderChip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource HeaderChipLabel}" Text="Channel: "/>
                            <TextBlock Style="{StaticResource HeaderChipValue}" Text="Stable"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- Page-specific actions and status rendered in the fixed page header. -->
            <DataTemplate x:Key="UpdatesHeaderAction">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Border Style="{StaticResource StatusChip}" ToolTip="{Binding UpdateCard.Detail}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource StatusChipGlyph}" Text="{Binding UpdateCard.Glyph}"/>
                                <TextBlock Margin="4,0,0,0"
                                           Style="{StaticResource StatusChipText}"
                                           Text="{Binding UpdateCard.Badge}"/>
                            </StackPanel>
                        </Border>
                        <Button AutomationProperties.Name="Check for updates"
                                Command="{Binding CheckForUpdatesCommand}"
                                Margin="8,0,0,0"
                                Padding="9,7"
                                Style="{StaticResource AccentButton}"
                                ToolTip="Check for updates">
                            <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                       FontSize="{StaticResource Sizing.FontSize.GlyphSmall}"
                                       Text="{x:Static themes:IconGlyphs.Refresh}"/>
                        </Button>
                    </StackPanel>

                    <Button Grid.Row="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,4,0,0"
                            Command="{Binding ShowReleaseNotesCommand}"
                            Content="View release notes  →"
                            Style="{StaticResource LinkButton}"
                            ToolTip="Open What's New"/>
                </Grid>
            </DataTemplate>

            <!-- Project Scanning actions: add a root or rescan the saved configuration. -->
            <DataTemplate x:Key="ProjectsHeaderAction">
                <controls:SpacedPanel VerticalAlignment="Center"
                                      Orientation="Horizontal"
                                      Spacing="8">
                    <Button Width="{StaticResource Sizing.IconButton.Width}"
                            Height="{StaticResource Sizing.IconButton.Height}"
                            AutomationProperties.Name="Add Directory"
                            Command="{Binding Scanning.AddWatchedDirectoryFromPickerCommand}"
                            Padding="0"
                            Style="{StaticResource SettingsIconButton}"
                            ToolTip="Add a watched root">
                        <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                   FontSize="{StaticResource Sizing.FontSize.Glyph}"
                                   Text="{x:Static themes:IconGlyphs.FolderAdd}"/>
                    </Button>
                    <Button Width="{StaticResource Sizing.IconButton.Width}"
                            Height="{StaticResource Sizing.IconButton.Height}"
                            AutomationProperties.Name="Scan Now"
                            Command="{Binding Scanning.ScanNowCommand}"
                            Padding="0"
                            Style="{StaticResource AccentButton}"
                            ToolTip="Rescan every watched root">
                        <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                   FontSize="{StaticResource Sizing.FontSize.Glyph}"
                                   Text="{x:Static themes:IconGlyphs.Refresh}"/>
                    </Button>
                </controls:SpacedPanel>
            </DataTemplate>

            <!-- Project Scanning summary cards, pinned to the page header. -->
            <DataTemplate x:Key="ProjectsSummaryCards">
                <controls:SpacedPanel Orientation="Horizontal" Spacing="8" StretchChildren="True">
                    <controls:SummaryCard Detail="{Binding Scanning.ProjectMixSummary}"
                                          DetailToolTip="Found by scanning or added manually"
                                          Icon="{x:Static themes:IconGlyphs.Code}"
                                          Label="PROJECTS"
                                          Value="{Binding Scanning.TotalProjectCount}"/>

                    <controls:SummaryCard Detail="{Binding AgentsSupportSummary}"
                                          Icon="{x:Static themes:IconGlyphs.Robot}"
                                          Label="AGENTS"
                                          Value="{Binding AgentsInstalledCount}"/>

                    <controls:SummaryCard Detail="{Binding Scanning.WatcherDetailText}"
                                          DetailToolTip="{Binding Scanning.WatcherDetailText}"
                                          Icon="{x:Static themes:IconGlyphs.Eye}"
                                          Label="DAEMON"
                                          Value="{Binding Scanning.WatcherStateLabel}"/>
                </controls:SpacedPanel>
            </DataTemplate>

            <DataTemplate x:Key="RegistrySummaryCards">
                <controls:SpacedPanel Orientation="Horizontal" Spacing="8" StretchChildren="True">
                    <controls:SummaryCard Alert="{Binding ProjectRegistry.FolderStatusSummary}"
                                          AlertToolTip="Projects with missing folders"
                                          Detail="{Binding ProjectRegistry.ProjectMixSummary}"
                                          DetailToolTip="Found by scanning or added manually"
                                          Icon="{x:Static themes:IconGlyphs.Code}"
                                          IsAlertVisible="{Binding ProjectRegistry.HasMissingFolders}"
                                          Label="PROJECTS"
                                          Value="{Binding ProjectRegistry.TotalCount}"/>

                    <controls:SummaryCard Detail="Registered manually"
                                          Icon="{x:Static themes:IconGlyphs.Edit}"
                                          Label="MANUAL"
                                          Value="{Binding ProjectRegistry.ManualCount}"/>

                    <controls:SummaryCard Detail="Managed by Project Scanning"
                                          Icon="{x:Static themes:IconGlyphs.Search}"
                                          Label="DISCOVERED"
                                          Value="{Binding ProjectRegistry.DiscoveredCount}"/>
                </controls:SpacedPanel>
            </DataTemplate>

            <!-- CLI Agents summary cards, pinned to the page header. -->
            <DataTemplate x:Key="AgentsSummaryCards">
                <controls:SpacedPanel Orientation="Horizontal" Spacing="8" StretchChildren="True">
                    <controls:SummaryCard Detail="{Binding AgentsState.AvailabilitySummary}"
                                          DetailToolTip="Installed agents and supported plugin count"
                                          Icon="{x:Static themes:IconGlyphs.Robot}"
                                          Label="AGENTS"
                                          Value="{Binding AgentsState.InstalledAgentCount}"/>

                    <controls:SummaryCard Detail="{Binding AgentsState.DefaultAgentDetail}"
                                          Icon="{x:Static themes:IconGlyphs.FavoriteStar}"
                                          Label="DEFAULT"
                                          Value="{Binding AgentsState.DefaultAgentName}"
                                          ValueTone="{Binding AgentsState.DefaultAgentValueTone}"
                                          ValueToolTip="{Binding AgentsState.DefaultAgentName}"/>

                    <controls:SummaryCard Detail="{Binding ProbePolicyDetail}"
                                          DetailToolTip="Effective cache and version-check timeout"
                                          Icon="{x:Static themes:IconGlyphs.Refresh}"
                                          Label="DETECTION"
                                          Value="{Binding ProbePolicySummary}"/>
                </controls:SpacedPanel>
            </DataTemplate>

            <!-- Navigation pages grouped by their group title; group order follows first appearance. -->
            <CollectionViewSource x:Key="NavPages" Source="{Binding Pages}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Group"/>
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource FieldStrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Inset top highlight (shared chrome) -->
            <Rectangle Grid.Row="0" Height="1" Fill="{DynamicResource TopHighlightBrush}"/>

            <!-- Drawn header: app identity, maximize/restore, close, drag -->
            <Grid Grid.Row="1"
                  MouseLeftButtonDown="OnHeaderMouseDown"
                  Style="{StaticResource WindowHeader}">
                <StackPanel Margin="12,0,0,0"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Width="16"
                           Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="pack://application:,,,/app.ico"/>
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="CLIHub - Settings"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Click="OnMaximizeRestoreClick"
                            Style="{StaticResource WindowCloseButton}"
                            ToolTip="Maximize">
                        <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{x:Static themes:IconGlyphs.Maximize}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Text" Value="{x:Static themes:IconGlyphs.Restore}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Click="OnCloseClick"
                            Style="{StaticResource WindowCloseButton}"
                            ToolTip="Close">
                        <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}" FontSize="{StaticResource Sizing.FontSize.GlyphSmall}" Text="{x:Static themes:IconGlyphs.Close}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="1"
                       Height="1"
                       VerticalAlignment="Bottom"
                       Fill="{DynamicResource HairlineBrush}"/>

            <!-- Body: sidebar navigation + active page -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource PopoverBgBrush}"
                        BorderBrush="{DynamicResource HairlineBrush}"
                        BorderThickness="0,0,1,0">
                    <ScrollViewer Padding="10,0,10,12"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="NavList"
                                 ItemsSource="{Binding Source={StaticResource NavPages}}"
                                 SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                                 Style="{StaticResource SidebarList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Width="18"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding Icon}"/>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Title}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SidebarGroupLabel}"
                                                       Text="{Binding Name, Converter={StaticResource UpperCase}}"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>
                    </ScrollViewer>
                </Border>

                <!-- Active page -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Page header: stays visible while only the content below it scrolls -->
                    <Grid Grid.Row="0" Margin="24,16,24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource PageHeader}" Text="{Binding SelectedPage.Title}"/>
                                <ContentControl Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Content="{Binding}"
                                                Visibility="{Binding SelectedPage.HeaderTitleExtraKey, Converter={StaticResource EmptyToCollapsedVisibility}}">
                                    <ContentControl.ContentTemplate>
                                        <MultiBinding Converter="{StaticResource ResourceKeyToTemplate}">
                                            <Binding Path="SelectedPage.HeaderTitleExtraKey"/>
                                            <!-- The slot element resolves the key, so the window-scoped template is reachable. -->
                                            <Binding RelativeSource="{RelativeSource Self}"/>
                                        </MultiBinding>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </WrapPanel>
                            <TextBlock Margin="0,6,0,0" Text="{Binding SelectedPage.Description}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPage.Description}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <ContentControl Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Stretch"
                                        Content="{Binding}"
                                        Visibility="{Binding SelectedPage.HeaderActionKey, Converter={StaticResource EmptyToCollapsedVisibility}}">
                            <ContentControl.ContentTemplate>
                                <MultiBinding Converter="{StaticResource ResourceKeyToTemplate}">
                                    <Binding Path="SelectedPage.HeaderActionKey"/>
                                    <Binding RelativeSource="{RelativeSource Self}"/>
                                </MultiBinding>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!-- Summary row: page-specific cards, part of the fixed header above the divider. -->
                        <ContentControl Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,14,0,0"
                                        HorizontalContentAlignment="Stretch"
                                        Content="{Binding}"
                                        Visibility="{Binding SelectedPage.SummaryRowKey, Converter={StaticResource EmptyToCollapsedVisibility}}">
                            <ContentControl.ContentTemplate>
                                <MultiBinding Converter="{StaticResource ResourceKeyToTemplate}">
                                    <Binding Path="SelectedPage.SummaryRowKey"/>
                                    <Binding RelativeSource="{RelativeSource Self}"/>
                                </MultiBinding>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <Rectangle Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Height="1"
                                   Margin="0,14,0,0"
                                   Fill="{DynamicResource HairlineBrush}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Padding="24,0,24,24"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <views:SettingsGeneralPage Visibility="{Binding SelectedPage.Key, Converter={StaticResource PageKeyVisibility}, ConverterParameter=general}"/>

                            <views:SettingsHotkeysPage Visibility="{Binding SelectedPage.Key, Converter={StaticResource PageKeyVisibility}, ConverterParameter=hotkeys}"/>

                            <views:SettingsTerminalPage Visibility="{Binding SelectedPage.Key, Converter={StaticResource PageKeyVisibility}, ConverterParameter=terminal}"/>

                            <views:SettingsAgentsPage Visibility="{Binding SelectedPage.Key, Converter={StaticResource PageKeyVisibility}, ConverterParameter=agents}"/>

                            <views:SettingsProjectRegistryPage Visibility="{Binding SelectedPage.Key, Converter={StaticResource PageKeyVisibility}, ConverterParameter=projects-registry}"/>

                            <views:SettingsProjectsPage Visibility="{Binding SelectedPage.Key, Converter={StaticResource PageKeyVisibility}, ConverterParameter=projects}"/>

                            <views:SettingsAppearancePage Visibility="{Binding SelectedPage.Key, Converter={StaticResource PageKeyVisibility}, ConverterParameter=appearance}"/>

                            <views:SettingsUpdatesPage Visibility="{Binding SelectedPage.Key, Converter={StaticResource PageKeyVisibility}, ConverterParameter=updates}"/>

                            <views:SettingsLogsPage Visibility="{Binding SelectedPage.Key, Converter={StaticResource PageKeyVisibility}, ConverterParameter=telemetry}"/>

                            <!-- Shown for a page whose settings are not implemented yet. -->
                            <views:SettingsPlaceholderPage Visibility="{Binding IsPlaceholderPageVisible, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               Margin="24,0,24,12"
                               Text="{Binding ValidationError}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ErrorText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ValidationError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ValidationError}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <!-- Footer: brand + version chip, Save/Cancel -->
            <Border Grid.Row="3" Style="{StaticResource FooterStrip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Margin="{StaticResource Sizing.Footer.BrandMargin}"
                                Orientation="Horizontal"
                                UseLayoutRounding="True"
                                VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BrandText}"
                                   Text="CLIHub"
                                   VerticalAlignment="Center"/>
                        <Border Margin="{StaticResource Sizing.Footer.VersionChipMargin}"
                                VerticalAlignment="Center"
                                Style="{StaticResource VersionChipBorder}">
                            <TextBlock Style="{StaticResource VersionChipText}"
                                       Text="{Binding Version}"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Margin="{StaticResource Sizing.Footer.ActionsMargin}"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Command="{Binding SaveCommand}"
                                Content="Save"
                                IsDefault="True"
                                Margin="0,0,10,0"
                                Style="{StaticResource AccentButton}"/>
                        <Button Command="{Binding CancelCommand}"
                                Content="Cancel"
                                Style="{StaticResource NeutralButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
