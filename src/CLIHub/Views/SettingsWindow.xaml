<Window x:Class="CLIHub.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:themes="clr-namespace:CLIHub.Themes"
        xmlns:conv="clr-namespace:CLIHub.Converters"
        xmlns:views="clr-namespace:CLIHub.Views"
        mc:Ignorable="d"
        Title="Settings"
        Background="{StaticResource ChromeBgBrush}"
        FontFamily="{StaticResource Sizing.FontFamily.Text}"
        Height="560" Width="760"
        MinHeight="480" MinWidth="640"
        KeyDown="OnKeyDown"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        SourceInitialized="OnSourceInitialized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <conv:UpperCaseTextConverter x:Key="UpperCase"/>

            <!-- Navigation pages grouped by their group title; group order follows first appearance. -->
            <CollectionViewSource x:Key="NavPages" Source="{Binding Pages}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Group"/>
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{StaticResource FieldStrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Inset top highlight (shared chrome) -->
            <Rectangle Grid.Row="0" Height="1" Fill="{StaticResource TopHighlightBrush}"/>

            <!-- Drawn header: title, close button, drag -->
            <Grid Grid.Row="1"
                  MouseLeftButtonDown="OnHeaderMouseDown"
                  Style="{StaticResource WindowHeader}">
                <TextBlock Style="{StaticResource WindowTitle}" Text="Settings"/>
                <Button HorizontalAlignment="Right"
                        Click="OnCloseClick"
                        Style="{StaticResource WindowCloseButton}"
                        ToolTip="Close">
                    <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}" FontSize="14" Text="{x:Static themes:IconGlyphs.Close}"/>
                </Button>
            </Grid>

            <Rectangle Grid.Row="1"
                       Height="1"
                       VerticalAlignment="Bottom"
                       Fill="{StaticResource HairlineBrush}"/>

            <!-- Body: sidebar navigation + active page -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="{StaticResource PopoverBgBrush}"
                        BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="0,0,1,0">
                    <ScrollViewer Padding="10,12,10,12"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="NavList"
                                 ItemsSource="{Binding Source={StaticResource NavPages}}"
                                 SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                                 Style="{StaticResource SidebarList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SidebarGroupLabel}"
                                                       Text="{Binding Name, Converter={StaticResource UpperCase}}"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>
                    </ScrollViewer>
                </Border>

                <!-- Active page -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  Padding="24,20,24,16"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <views:SettingsGeneralPage>
                                <views:SettingsGeneralPage.Style>
                                    <Style TargetType="UserControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPage.Key}" Value="general">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:SettingsGeneralPage.Style>
                            </views:SettingsGeneralPage>

                            <views:SettingsHotkeysPage>
                                <views:SettingsHotkeysPage.Style>
                                    <Style TargetType="UserControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPage.Key}" Value="hotkeys">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:SettingsHotkeysPage.Style>
                            </views:SettingsHotkeysPage>

                            <views:SettingsTerminalPage>
                                <views:SettingsTerminalPage.Style>
                                    <Style TargetType="UserControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPage.Key}" Value="terminal">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:SettingsTerminalPage.Style>
                            </views:SettingsTerminalPage>

                            <views:SettingsAgentsPage>
                                <views:SettingsAgentsPage.Style>
                                    <Style TargetType="UserControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPage.Key}" Value="agents">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:SettingsAgentsPage.Style>
                            </views:SettingsAgentsPage>

                            <views:SettingsAppearancePage>
                                <views:SettingsAppearancePage.Style>
                                    <Style TargetType="UserControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPage.Key}" Value="appearance">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:SettingsAppearancePage.Style>
                            </views:SettingsAppearancePage>

                            <views:SettingsUpdatesPage>
                                <views:SettingsUpdatesPage.Style>
                                    <Style TargetType="UserControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPage.Key}" Value="updates">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:SettingsUpdatesPage.Style>
                            </views:SettingsUpdatesPage>

                            <views:SettingsPlaceholderPage>
                                <views:SettingsPlaceholderPage.Style>
                                    <Style TargetType="UserControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPage.IsImplemented}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:SettingsPlaceholderPage.Style>
                            </views:SettingsPlaceholderPage>
                        </Grid>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1"
                               Margin="24,0,24,12"
                               Style="{StaticResource ErrorText}"
                               Text="{Binding ValidationError}"/>
                </Grid>
            </Grid>

            <!-- Footer: brand + version chip, Save/Cancel -->
            <Border Grid.Row="3" Style="{StaticResource FooterStrip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BrandText}" Text="CLIHub"/>
                        <Border Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource VersionChipBorder}">
                            <TextBlock Style="{StaticResource VersionChipText}" Text="{Binding Version}"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding SaveCommand}"
                            Content="Save"
                            IsDefault="True"
                            Margin="0,0,10,0"
                            Style="{StaticResource AccentButton}"/>
                    <Button Grid.Column="2"
                            Command="{Binding CancelCommand}"
                            Content="Cancel"
                            Style="{StaticResource NeutralButton}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
