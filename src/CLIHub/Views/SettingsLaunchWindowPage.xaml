<UserControl x:Class="CLIHub.Views.SettingsLaunchWindowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CLIHub.Controls"
             xmlns:behaviors="clr-namespace:CLIHub.Behaviors"
             xmlns:themes="clr-namespace:CLIHub.Themes"
             mc:Ignorable="d">
    <StackPanel>
        <controls:SettingsGroup Margin="0,18,0,8">
            <controls:SettingCard Title="Launcher shortcut"
                               Hint="Global hotkey. Press a combination; Esc cancels capture."
                               Icon="{x:Static themes:IconGlyphs.Keyboard}"
                               Grouped="True">
                <Border x:Name="HotkeyField"
                        MouseLeftButtonDown="HotkeyField_MouseLeftButtonDown"
                        PreviewKeyDown="HotkeyField_PreviewKeyDown"
                        Style="{StaticResource HotkeyField}">
                    <!-- -6 cancels the last chip's trailing margin, so the left and right insets stay equal -->
                    <ItemsControl Margin="0,0,-6,0" ItemsSource="{Binding HotkeyParts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource HotkeyChip}">
                                    <TextBlock Style="{StaticResource HotkeyChipText}" Text="{Binding}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </controls:SettingCard>
            <controls:SettingCard Title="Launcher placement"
                               Hint="Where the window opens. The active monitor follows the pointer."
                               Icon="{x:Static themes:IconGlyphs.Location}"
                               Grouped="True">
                <ComboBox HorizontalAlignment="Right"
                          ItemsSource="{Binding PopupPositions}"
                          SelectedItem="{Binding SelectedPopupPosition, Mode=TwoWay}"
                          Style="{StaticResource SettingsComboBox}"
                          behaviors:ComboBoxBehaviors.AutoWidthToItems="True">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </controls:SettingCard>
            <controls:SettingCard Title="Project path shortening"
                               Hint="How long paths are shortened in project rows."
                               Icon="{x:Static themes:IconGlyphs.FolderOpen}"
                               Grouped="True">
                <ComboBox HorizontalAlignment="Right"
                          ItemsSource="{Binding PathDisplays}"
                          SelectedItem="{Binding SelectedPathDisplay, Mode=TwoWay}"
                          Style="{StaticResource SettingsComboBox}"
                          behaviors:ComboBoxBehaviors.AutoWidthToItems="True">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </controls:SettingCard>
        </controls:SettingsGroup>
    </StackPanel>
</UserControl>
