<UserControl x:Class="CLIHub.Views.SettingsLaunchWindowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CLIHub.Controls"
             xmlns:behaviors="clr-namespace:CLIHub.Behaviors"
             xmlns:themes="clr-namespace:CLIHub.Themes"
             mc:Ignorable="d">
    <StackPanel>
        <controls:SectionHeader Text="POSITION"/>
        <controls:SettingCard Title="Launcher window position"
                           Hint="Where the launch window appears when it is shown."
                           Icon="{x:Static themes:IconGlyphs.Location}">
            <ComboBox HorizontalAlignment="Right"
                      ItemsSource="{Binding PopupPositions}"
                      SelectedItem="{Binding SelectedPopupPosition, Mode=TwoWay}"
                      Style="{StaticResource SettingsComboBox}"
                      behaviors:ComboBoxBehaviors.AutoWidthToItems="True">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingCard>

        <controls:SectionHeader Text="PROJECT PATHS"/>
        <controls:SettingCard Title="Path display"
                           Hint="How long project paths are shortened in the launch window."
                           Icon="{x:Static themes:IconGlyphs.FolderOpen}">
            <ComboBox HorizontalAlignment="Right"
                      ItemsSource="{Binding PathDisplays}"
                      SelectedItem="{Binding SelectedPathDisplay, Mode=TwoWay}"
                      Style="{StaticResource SettingsComboBox}"
                      behaviors:ComboBoxBehaviors.AutoWidthToItems="True">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingCard>
    </StackPanel>
</UserControl>
