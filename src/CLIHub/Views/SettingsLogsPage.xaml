<UserControl x:Class="CLIHub.Views.SettingsLogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CLIHub.Controls"
             xmlns:behaviors="clr-namespace:CLIHub.Behaviors"
             xmlns:themes="clr-namespace:CLIHub.Themes"
             mc:Ignorable="d">
    <StackPanel>
        <controls:SectionHeader Text="LOGGING"/>
        <controls:SettingCard Title="Log level"
                           Hint="Takes effect after the next start."
                           Icon="{x:Static themes:IconGlyphs.Diagnostic}">
            <ComboBox HorizontalAlignment="Right"
                      ItemsSource="{Binding LogLevels}"
                      SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}"
                      Style="{StaticResource SettingsComboBox}"
                      behaviors:ComboBoxBehaviors.AutoWidthToItems="True">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingCard>

        <controls:SettingCard Title="Retention &amp; size"
                           Hint="Daily log files to keep and the per-file limit (0 = unlimited)."
                           Icon="{x:Static themes:IconGlyphs.Page}"
                           Placement="Stacked">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Retention"/>
                    <controls:NumericField Margin="0,6,0,0"
                                           MinWidth="120"
                                           Minimum="1"
                                           Text="{Binding LogRetentionDaysText, UpdateSourceTrigger=PropertyChanged}"
                                           Unit="days"
                                           Width="{Binding ElementName=LogSizeLabel, Path=ActualWidth}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="LogSizeLabel" Style="{StaticResource FieldLabel}" Text="Size limit"/>
                    <controls:NumericField Margin="0,6,0,0"
                                           MinWidth="120"
                                           Minimum="0"
                                           Text="{Binding LogFileSizeLimitText, UpdateSourceTrigger=PropertyChanged}"
                                           Unit="MB"
                                           Width="{Binding ElementName=LogSizeLabel, Path=ActualWidth}"/>
                </StackPanel>
            </Grid>
        </controls:SettingCard>

        <controls:SectionHeader Text="LOG FILE"/>
        <controls:SettingCard Title="Log file"
                           Hint="The current log file path."
                           Icon="{x:Static themes:IconGlyphs.Document}"
                           Placement="Stacked">
            <controls:SpacedPanel Orientation="Horizontal"
                                  Spacing="{StaticResource Sizing.Spacing}">
                <Border MinWidth="320"
                        Padding="8,6"
                        Background="{DynamicResource PopoverBgBrush}"
                        BorderBrush="{DynamicResource FieldStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Sizing.CornerRadius.Chip}">
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding LogFilePath}"/>
                </Border>
                <Button
                        Command="{Binding CopyLogPathCommand}"
                        Style="{StaticResource SettingsIconButton}"
                        ToolTip="Copy path">
                    <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                               FontSize="14"
                               Text="{x:Static themes:IconGlyphs.Copy}"/>
                </Button>
                <Button
                        Command="{Binding OpenLogFolderCommand}"
                        Style="{StaticResource SettingsIconButton}"
                        ToolTip="Open log folder">
                    <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                               FontSize="14"
                               Text="{x:Static themes:IconGlyphs.FolderOpen}"/>
                </Button>
            </controls:SpacedPanel>
        </controls:SettingCard>
    </StackPanel>
</UserControl>
