<UserControl x:Class="CLIHub.Views.SettingsLogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:CLIHub.Views"
             xmlns:themes="clr-namespace:CLIHub.Themes"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock Style="{StaticResource PageHeader}" Text="Logs"/>
        <TextBlock Margin="0,6,0,0"
                   Style="{StaticResource HintText}"
                   Text="Log level, retention, and the log file."/>

        <views:SectionHeader Text="LOGGING"/>
        <views:SettingCard Title="Log level"
                           Hint="Takes effect after the next start."
                           Icon="{x:Static themes:IconGlyphs.Diagnostic}"
                           Placement="Stacked">
            <ListBox ItemsSource="{Binding LogLevels}"
                     SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}"
                     Style="{StaticResource SegmentGroup}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </views:SettingCard>

        <views:SettingCard Title="Retention &amp; size"
                           Hint="Daily log files to keep and the per-file limit (0 = unlimited)."
                           Icon="{x:Static themes:IconGlyphs.Page}"
                           Placement="Stacked">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Retention, days"/>
                    <TextBox Margin="0,6,0,0"
                             Style="{StaticResource SettingsInput}"
                             Text="{Binding LogRetentionDaysText, UpdateSourceTrigger=PropertyChanged}"
                             Width="{Binding ElementName=LogSizeLabel, Path=ActualWidth}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="LogSizeLabel" Style="{StaticResource FieldLabel}" Text="Size limit, MB (0 = none)"/>
                    <TextBox Margin="0,6,0,0"
                             Style="{StaticResource SettingsInput}"
                             Text="{Binding LogFileSizeLimitText, UpdateSourceTrigger=PropertyChanged}"
                             Width="{Binding ElementName=LogSizeLabel, Path=ActualWidth}"/>
                </StackPanel>
            </Grid>
        </views:SettingCard>

        <views:SectionHeader Text="LOG FILE"/>
        <views:SettingCard Title="Log file"
                           Hint="The current log file path."
                           Icon="{x:Static themes:IconGlyphs.Document}"
                           Placement="Stacked">
            <StackPanel Orientation="Horizontal">
                <Border MinWidth="320"
                        Padding="8,6"
                        Background="{DynamicResource PopoverBgBrush}"
                        BorderBrush="{DynamicResource FieldStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Sizing.CornerRadius.Chip}">
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding LogFilePath}"/>
                </Border>
                <Button Margin="8,0,0,0"
                        Command="{Binding CopyLogPathCommand}"
                        Style="{StaticResource SettingsIconButton}"
                        ToolTip="Copy path">
                    <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                               FontSize="14"
                               Text="{x:Static themes:IconGlyphs.Copy}"/>
                </Button>
                <Button Margin="8,0,0,0"
                        Command="{Binding OpenLogFolderCommand}"
                        Style="{StaticResource SettingsIconButton}"
                        ToolTip="Open log folder">
                    <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                               FontSize="14"
                               Text="{x:Static themes:IconGlyphs.FolderOpen}"/>
                </Button>
            </StackPanel>
        </views:SettingCard>
    </StackPanel>
</UserControl>
