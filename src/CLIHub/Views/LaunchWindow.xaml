<Window x:Class="CLIHub.Views.LaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:themes="clr-namespace:CLIHub.Themes"
        mc:Ignorable="d"
        Title="CLIHub"
        Background="{StaticResource ChromeBgBrush}"
        FontFamily="{StaticResource Sizing.FontFamily.Text}"
        KeyDown="OnKeyDown"
        Deactivated="OnDeactivated"
        PreviewMouseLeftButtonDown="OnWindowMouseDown"
        PreviewMouseLeftButtonUp="OnSplitterMouseUp"
        PreviewMouseMove="OnSplitterMouseMove"
        MinHeight="240"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        SourceInitialized="OnSourceInitialized"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Window-scoped styles: the dark theme applies to this window only. -->
                <ResourceDictionary Source="/Themes/LaunchWindowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
                Pane-list scrollbar thumbs use the row hover tone. The app-level implicit ScrollBar
                style reads this key dynamically, so this window-scoped override reaches it.
            -->
            <SolidColorBrush x:Key="ScrollThumbBrush"
                             Color="{Binding Color, Source={StaticResource HoverOverlayBrush}}"/>

            <!--
                Actions-menu item templates. They live here, not in the styles dictionary, because an
                entry wires the window's click handler, which only a window with code-behind can
                resolve. Each entry is rendered by a ContentControl that swaps template by kind.
            -->
            <DataTemplate x:Key="ActionsMenuActionTemplate">
                <Button Click="OnMenuActionInvoked"
                        Command="{Binding Command}"
                        Style="{StaticResource ActionsMenuEntryButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="16"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                   FontSize="14"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding Glyph}"/>
                        <TextBlock VerticalAlignment="Center" Text="{Binding Label}"/>
                    </StackPanel>
                </Button>
            </DataTemplate>

            <DataTemplate x:Key="ActionsMenuToggleTemplate">
                <ToggleButton Click="OnMenuActionInvoked"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              Style="{StaticResource ActionsMenuEntryToggle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="16"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                   FontSize="14"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding Glyph}"/>
                        <TextBlock VerticalAlignment="Center" Text="{Binding Label}"/>
                    </StackPanel>
                </ToggleButton>
            </DataTemplate>

            <DataTemplate x:Key="ActionsMenuSeparatorTemplate">
                <Rectangle Height="1" Margin="8,4" Fill="{StaticResource RowDividerBrush}"/>
            </DataTemplate>

            <DataTemplate x:Key="ActionsMenuItemTemplate">
                <ContentControl Content="{Binding}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource ActionsMenuActionTemplate}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource ActionsMenuSeparatorTemplate}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCheckable}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource ActionsMenuToggleTemplate}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{StaticResource FieldStrokeBrush}" BorderThickness="1">
        <StackPanel>

            <!-- Inset top highlight (mockup chrome) -->
            <Rectangle Height="1" Fill="{StaticResource TopHighlightBrush}"/>

            <!-- Panes -->
            <Grid x:Name="PanesGrid">
                <Grid.ColumnDefinitions>
                    <!-- Projects pane hugs its list; the splitter still resizes it on drag, but never
                         below the width its list needs. -->
                    <ColumnDefinition Width="Auto" MinWidth="{StaticResource Sizing.ProjectPane.MinWidth}"/>
                    <!-- Optional splitter column: sized by the thumb, so the drag area is wider than the hairline. -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Agents pane and its rows are content sized too, so the window fits its content. -->
                    <ColumnDefinition Width="Auto" MinWidth="{StaticResource Sizing.AgentPane.MinWidth}"/>
                </Grid.ColumnDefinitions>

                <!-- Projects pane -->
                <Border Grid.Column="0" Style="{StaticResource PaneSurface}">
                    <DockPanel Margin="{StaticResource Sizing.Pane.Margin}">
                        <Grid DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                            <TextBlock Margin="2,0,0,0" Style="{StaticResource SectionLabel}" Text="PROJECTS"/>
                            <ToggleButton x:Name="ProjectsActionsButton"
                                          HorizontalAlignment="Right"
                                          Content="ACTIONS"
                                          Style="{StaticResource PaneActionsToggle}"/>
                            <Popup x:Name="ProjectsActionsPopup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsChecked, ElementName=ProjectsActionsButton, Mode=TwoWay}"
                                   Opened="OnActionsPopupOpened"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=ProjectsActionsButton}"
                                   PopupAnimation="Fade"
                                   StaysOpen="False"
                                   VerticalOffset="-1">
                                <Grid PreviewKeyDown="OnActionsMenuPreviewKeyDown">
                                    <Border Style="{StaticResource ActionsPopover}">
                                        <ItemsControl ItemTemplate="{StaticResource ActionsMenuItemTemplate}"
                                                      ItemsSource="{Binding ProjectsActions}"/>
                                    </Border>
                                    <!-- Masks the card's top border under the open Actions control,
                                         so the control and the card read as one panel with no seam. -->
                                    <Rectangle Width="{Binding ActualWidth, ElementName=ProjectsActionsButton}"
                                               Height="2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               Fill="{StaticResource PopoverOpenBrush}"/>
                                </Grid>
                            </Popup>
                        </Grid>

                        <ListBox ItemContainerStyle="{StaticResource ProjectRowContainer}"
                                 ItemsSource="{Binding Projects}"
                                 MinWidth="{StaticResource Sizing.ProjectList.MinWidth}"
                                 SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                 Style="{StaticResource PaneList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="{StaticResource Sizing.ProjectLogo.Height}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Fixed gap column: the text column's measured width then equals
                                                 exactly the space the path may fill, with no chrome arithmetic
                                                 in the converter. -->
                                            <ColumnDefinition Width="{StaticResource Sizing.ProjectRow.TextGap}"/>
                                            <!-- Star column so the row fills the list width, while the
                                                 item's own desired width stays content driven. -->
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="{StaticResource Sizing.ProjectLogo.Width}"
                                                Height="{StaticResource Sizing.ProjectLogo.Height}"
                                                Background="{StaticResource ThumbBgBrush}"
                                                BorderBrush="{StaticResource FieldStrokeBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Sizing.ProjectLogo.CornerRadius}">
                                            <Border Margin="1" CornerRadius="{StaticResource Sizing.ProjectLogo.CornerRadius}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding LogoPath, Converter={StaticResource PathToImage}}"
                                                                Stretch="Uniform"/>
                                                </Border.Background>
                                            </Border>
                                        </Border>

                                        <StackPanel
                                                    x:Name="TextHost"
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center">
                                            <TextBlock FontSize="{StaticResource Sizing.FontSize.Name}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <!-- TextTrimming is only a transient fallback while the converter catches
                                                 up after a width change (one layout pass, e.g. mid-splitter-drag);
                                                 the authoritative trimming is the converter's. -->
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="{StaticResource Sizing.FontSize.Body}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource PathDisplay}">
                                                        <Binding Path="Path"/>
                                                        <!-- The text host's measured width: it stretches over the text column,
                                                             so it equals exactly the space the path may fill. The row is stretched
                                                             to the list, so the width follows the pane's width and the path is
                                                             re-trimmed on every change of it. -->
                                                        <Binding ElementName="TextHost" Path="ActualWidth"/>
                                                        <Binding Path="DataContext.DisplayStyle"
                                                                 RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                                                        <!-- The TextBlock measures the text. -->
                                                        <Binding RelativeSource="{RelativeSource Self}"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Text="★"
                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Pane divider: hairline with a wider splitter hit area -->
                <Border Grid.Column="1" Background="{StaticResource StripBgBrush}"/>
                <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Center" Fill="{StaticResource FieldStrokeBrush}"/>
                <Rectangle x:Name="PaneSplitter"
                           Grid.Column="1"
                           Width="{StaticResource Sizing.Splitter.HitWidth}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Stretch"
                           Cursor="SizeWE"
                           Fill="Transparent"/>

                <!-- Agents pane -->
                <Border Grid.Column="2" Style="{StaticResource PaneSurface}">
                    <DockPanel Margin="{StaticResource Sizing.Pane.Margin}">
                        <Grid DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                            <TextBlock Margin="2,0,0,0" Style="{StaticResource SectionLabel}" Text="AGENTS"/>
                            <ToggleButton x:Name="AgentsActionsButton"
                                          HorizontalAlignment="Right"
                                          Content="ACTIONS"
                                          Style="{StaticResource PaneActionsToggle}"/>
                            <Popup x:Name="AgentsActionsPopup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsChecked, ElementName=AgentsActionsButton, Mode=TwoWay}"
                                   Opened="OnActionsPopupOpened"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=AgentsActionsButton}"
                                   PopupAnimation="Fade"
                                   StaysOpen="False"
                                   VerticalOffset="-1">
                                <Grid PreviewKeyDown="OnActionsMenuPreviewKeyDown">
                                    <Border Style="{StaticResource ActionsPopover}">
                                        <ItemsControl ItemTemplate="{StaticResource ActionsMenuItemTemplate}"
                                                      ItemsSource="{Binding AgentsActions}"/>
                                    </Border>
                                    <!-- Masks the card's top border under the open Actions control,
                                         so the control and the card read as one panel with no seam. -->
                                    <Rectangle Width="{Binding ActualWidth, ElementName=AgentsActionsButton}"
                                               Height="2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               Fill="{StaticResource PopoverOpenBrush}"/>
                                </Grid>
                            </Popup>
                        </Grid>

                        <ListBox AlternationCount="100000"
                                 ItemContainerStyle="{StaticResource AgentRowContainer}"
                                 ItemsSource="{Binding Agents}"
                                 SelectedItem="{Binding SelectedAgent, Mode=TwoWay}"
                                 Style="{StaticResource PaneList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="{StaticResource Sizing.AgentRow.Height}" Opacity="{Binding RowOpacity}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Spacer: pushes the action buttons to the row's right edge,
                                                 while the row's own width stays content driven. -->
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Width="{StaticResource Sizing.AgentLogo.Width}"
                                               Height="{StaticResource Sizing.AgentLogo.Height}"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding LogoPath, Converter={StaticResource PathToImage}}"
                                               Stretch="Uniform"/>

                                        <StackPanel Grid.Column="1"
                                                    Margin="{StaticResource Sizing.AgentRow.TextMargin}"
                                                    MaxWidth="{StaticResource Sizing.AgentRow.TextMaxWidth}"
                                                    VerticalAlignment="Center">
                                            <TextBlock FontSize="{StaticResource Sizing.FontSize.Name}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="0,1,0,0"
                                                       FontSize="{StaticResource Sizing.FontSize.Section}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="{Binding Version}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <Button Margin="0,0,6,0"
                                                    Command="{Binding DataContext.LaunchAgentCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource AgentActionButton}"
                                                    ToolTip="Launch">
                                                <Path Width="10"
                                                      Height="10"
                                                      Data="{StaticResource PlayGlyph}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Stretch="Uniform"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.ResumeAgentCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource AgentActionButton}"
                                                    ToolTip="Resume session">
                                                <Grid Width="14" Height="14">
                                                    <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                             StrokeThickness="1.4"/>
                                                    <Path Width="6"
                                                          Height="6"
                                                          Margin="1.5,0,0,0"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="{StaticResource PlayGlyph}"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Stretch="Uniform"/>
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <Rectangle Height="1" Fill="{StaticResource HairlineBrush}"/>

            <!-- Footer: brand and version left, update check beside it, status centered, actions right -->
            <Grid Height="{StaticResource Sizing.Footer.Height}" Background="{StaticResource StripBgBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Style="{StaticResource BrandText}" Text="CLIHub"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Margin="10,2,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding UpdateControl.UpdateControlCommand}"
                        Content="{Binding UpdateControl.UpdateButtonText}"
                        Style="{StaticResource FooterTextButton}"
                        ToolTip="Check for updates"/>

                <TextBlock Grid.Column="2"
                           Margin="12,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource Sizing.FontSize.Body}"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="{Binding StatusMessage}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="3"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Command="{Binding OpenDataFolderCommand}"
                            Style="{StaticResource PopupIconButton}"
                            ToolTip="Open data folder">
                        <TextBlock Style="{StaticResource FooterIcon}" Text="{x:Static themes:IconGlyphs.FolderOpen}"/>
                    </Button>
                    <Button Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource PopupIconButton}"
                            ToolTip="Settings">
                        <TextBlock Style="{StaticResource FooterIcon}" Text="{x:Static themes:IconGlyphs.Settings}"/>
                    </Button>
                    <ToggleButton IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                  Style="{StaticResource PopupToggleIconButton}"
                                  ToolTip="Keep the window open when it loses focus">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource FooterIcon}" TargetType="TextBlock">
                                    <Setter Property="Text" Value="{x:Static themes:IconGlyphs.Pin}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Text" Value="{x:Static themes:IconGlyphs.Pinned}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ToggleButton>
                    <Button Command="{Binding ExitCommand}"
                            Style="{StaticResource PopupIconButton}"
                            ToolTip="Exit CLIHub">
                        <TextBlock Style="{StaticResource FooterIcon}" Text="{x:Static themes:IconGlyphs.Exit}"/>
                    </Button>
                </StackPanel>
            </Grid>

        </StackPanel>
    </Border>
</Window>
