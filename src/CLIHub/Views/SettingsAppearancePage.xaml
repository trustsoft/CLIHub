<UserControl x:Class="CLIHub.Views.SettingsAppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CLIHub.Controls"
             xmlns:behaviors="clr-namespace:CLIHub.Behaviors"
             xmlns:themes="clr-namespace:CLIHub.Themes"
             mc:Ignorable="d">
    <StackPanel>
        <controls:SectionHeader Text="THEME"/>
        <controls:SettingCard Title="Application theme"
                           Hint="Select the visual palette and luminosity mode. Applies immediately on save; System Sync follows Windows."
                           Icon="{x:Static themes:IconGlyphs.Brightness}"
                           Placement="Stacked">
            <ListBox Margin="0,0,-8,0"
                     ItemsSource="{Binding AppThemes}"
                     SelectedItem="{Binding SelectedAppTheme, Mode=TwoWay}"
                     Style="{StaticResource ThemeOptionGroup}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Palette sample: each card previews its own theme through fixed brushes -->
                            <Border Height="56"
                                    Background="{Binding PreviewCardBrush, Converter={StaticResource ThemeBrushKey}}"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Sizing.CornerRadius.Control}">

                                <Grid>
                                    <StackPanel Margin="12,0" VerticalAlignment="Center" Orientation="Horizontal">
                                        <!--
                                            The dot follows the live accent brush, so it keeps tracking an
                                            accent change instead of freezing the brush at load time. System
                                            previews the muted swatch because it is not a palette of its own.
                                        -->
                                        <Ellipse Width="9" Height="9">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UsesAccentPreviewDot}" Value="False">
                                                            <Setter Property="Fill" Value="{StaticResource ThemePreviewDotMutedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <Rectangle Width="30"
                                                   Height="5"
                                                   Margin="7,0,0,0"
                                                   Fill="{Binding PreviewBarBrush, Converter={StaticResource ThemeBrushKey}}"
                                                   RadiusX="2.5"
                                                   RadiusY="2.5"/>
                                    </StackPanel>

                                    <!-- Selection marker, shown by the owning ListBoxItem -->
                                    <Border Width="18"
                                            Height="18"
                                            Margin="0,6,6,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            CornerRadius="9">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                                   FontSize="9"
                                                   Foreground="White"
                                                   Text="{x:Static themes:IconGlyphs.Checkmark}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="0,9,0,0">
                                <TextBlock FontSize="{StaticResource Sizing.FontSize.Body}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding Name}"/>
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource HintText}"
                                           Text="{Binding Description}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </controls:SettingCard>

        <controls:SettingCard Title="Accent color"
                           Hint="Applied to active states, focus rings, toggles, and primary actions. Applies immediately on save."
                           Badge="{Binding ActiveAccentLabel}"
                           BadgeTone="Accent"
                           Icon="{x:Static themes:IconGlyphs.Palette}"
                           Placement="Stacked">
            <StackPanel>
                <ListBox Margin="0,0,-8,-8"
                         ItemsSource="{Binding AccentOptions}"
                         SelectedItem="{Binding SelectedAccent, Mode=TwoWay}"
                         Style="{StaticResource AccentOptionGroup}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="26" Height="26" VerticalAlignment="Center">
                                    <Ellipse x:Name="Swatch"
                                             Width="26"
                                             Height="26"
                                             Fill="{Binding Hex}"/>
                                    <Border x:Name="CustomSwatch"
                                            Width="26"
                                            Height="26"
                                            Background="{DynamicResource ThumbBgBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="13"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="CustomGlyph"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                                   FontSize="{StaticResource Sizing.FontSize.GlyphTiny}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{x:Static themes:IconGlyphs.Palette}"/>
                                    </Border>
                                    <TextBlock x:Name="Check"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                               FontSize="10"
                                               Foreground="White"
                                               Text="{x:Static themes:IconGlyphs.Checkmark}"
                                               Visibility="Collapsed"/>
                                </Grid>

                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock FontSize="{StaticResource Sizing.FontSize.Body}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}"/>
                                    <TextBlock Margin="0,1,0,0"
                                               Style="{StaticResource HintText}"
                                               Text="{Binding Hint}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                    <Setter TargetName="Swatch" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="CustomSwatch" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="CustomGlyph" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedAccent.IsCustom}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource FieldLabel}"
                               Text="Custom color"/>
                    <TextBox Width="120"
                             Margin="10,0,0,0"
                             Style="{StaticResource SettingsInput}"
                             Tag="#RRGGBB"
                             Text="{Binding AccentText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Custom accent color as #RRGGBB"/>
                </StackPanel>
            </StackPanel>
        </controls:SettingCard>

        <controls:SectionHeader Text="PATHS"/>
        <controls:SettingCard Title="Path display"
                           Hint="How long project paths are shortened in the launch window."
                           Icon="{x:Static themes:IconGlyphs.FolderOpen}">
            <ComboBox HorizontalAlignment="Right"
                      ItemsSource="{Binding PathDisplays}"
                      SelectedItem="{Binding SelectedPathDisplay, Mode=TwoWay}"
                      Style="{StaticResource SettingsComboBox}"
                      behaviors:ComboBoxBehaviors.AutoWidthToItems="True">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingCard>
    </StackPanel>
</UserControl>
