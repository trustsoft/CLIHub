<UserControl x:Class="CLIHub.Views.SettingsAppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CLIHub.Controls"
             xmlns:themes="clr-namespace:CLIHub.Themes"
             mc:Ignorable="d">
    <StackPanel>
        <controls:SettingCard Margin="0,18,0,8"
                           Title="Theme"
                           Hint="System follows the Windows light/dark mode."
                           Icon="{x:Static themes:IconGlyphs.Brightness}"
                           Placement="Stacked">
            <ListBox Margin="0,0,-8,0"
                     ItemsSource="{Binding AppThemes}"
                     SelectedItem="{Binding SelectedAppTheme, Mode=TwoWay}"
                     Style="{StaticResource ThemeOptionGroup}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel AutomationProperties.HelpText="{Binding Description}"
                                    ToolTip="{Binding Description}">

                            <!-- Palette sample: each card previews its own theme through fixed brushes -->
                            <Border Height="48"
                                    Background="{Binding PreviewCardBrush, Converter={StaticResource ThemeBrushKey}}"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Sizing.CornerRadius.Control}">

                                <Grid>
                                    <StackPanel Margin="12,0" VerticalAlignment="Center" Orientation="Horizontal">
                                        <!--
                                            The dot follows the live accent brush, so it keeps tracking an
                                            accent change instead of freezing the brush at load time. System
                                            previews the muted swatch because it is not a palette of its own.
                                        -->
                                        <Ellipse Width="9" Height="9">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UsesAccentPreviewDot}" Value="False">
                                                            <Setter Property="Fill" Value="{StaticResource ThemePreviewDotMutedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <Rectangle Width="30"
                                                   Height="5"
                                                   Margin="7,0,0,0"
                                                   Fill="{Binding PreviewBarBrush, Converter={StaticResource ThemeBrushKey}}"
                                                   RadiusX="2.5"
                                                   RadiusY="2.5"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Margin="2,4,0,0"
                                       FontSize="{StaticResource Sizing.FontSize.Body}"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding Name}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </controls:SettingCard>

        <controls:SettingCard Title="Accent color"
                           Hint="Used for selection, focus, and emphasis."
                           Badge="{Binding Accent.ActiveAccentLabel}"
                           BadgeTone="Accent"
                           Icon="{x:Static themes:IconGlyphs.Palette}"
                           Placement="Stacked">
            <StackPanel>
                <ListBox Margin="0,0,-8,-8"
                         ItemsSource="{Binding Accent.AccentOptions}"
                         SelectedItem="{Binding Accent.SelectedAccent, Mode=TwoWay}"
                         Style="{StaticResource AccentOptionGroup}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="26" Height="26" VerticalAlignment="Center">
                                    <Ellipse x:Name="Swatch"
                                             Width="26"
                                             Height="26"
                                             Fill="{Binding Hex}"/>
                                    <Border x:Name="CustomSwatch"
                                            Width="26"
                                            Height="26"
                                            Background="{DynamicResource ThumbBgBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="13"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="CustomGlyph"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                                   FontSize="{StaticResource Sizing.FontSize.GlyphTiny}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{x:Static themes:IconGlyphs.Palette}"/>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock FontSize="{StaticResource Sizing.FontSize.Body}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}"/>
                                    <TextBlock Margin="0,1,0,0"
                                               Style="{StaticResource HintText}"
                                               Text="{Binding Hint}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                    <Setter TargetName="Swatch" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="CustomSwatch" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Accent.SelectedAccent.IsCustom}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource FieldLabel}"
                               Text="Custom color"/>
                    <TextBox Width="120"
                             Margin="10,0,0,0"
                             Style="{StaticResource SettingsInput}"
                             Tag="#RRGGBB"
                             Text="{Binding Accent.AccentText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Hex color, e.g. #4CC2FF"/>
                </StackPanel>
            </StackPanel>
        </controls:SettingCard>
    </StackPanel>
</UserControl>
