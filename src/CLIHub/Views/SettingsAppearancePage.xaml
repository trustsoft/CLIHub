<UserControl x:Class="CLIHub.Views.SettingsAppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CLIHub.Controls"
             xmlns:behaviors="clr-namespace:CLIHub.Behaviors"
             xmlns:themes="clr-namespace:CLIHub.Themes"
             mc:Ignorable="d">
    <StackPanel>
        <controls:SectionHeader Text="THEME"/>
        <controls:SettingCard Title="Application theme"
                           Hint="Takes effect after the next start. System follows Windows."
                           Icon="{x:Static themes:IconGlyphs.Brightness}">
            <ListBox ItemsSource="{Binding AppThemes}"
                     SelectedItem="{Binding SelectedAppTheme, Mode=TwoWay}"
                     Style="{StaticResource SegmentGroup}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </controls:SettingCard>

        <controls:SettingCard Title="Accent color"
                           Hint="Pick a preset or enter #RRGGBB. Applies immediately on save."
                           Icon="{x:Static themes:IconGlyphs.Palette}"
                           HorizontalContentAlignment="Left"
                           Placement="Stacked">
            <StackPanel>
                <ListBox ItemsSource="{Binding AccentOptions}"
                         SelectedItem="{Binding SelectedAccent, Mode=TwoWay}"
                         Style="{StaticResource SegmentGroup}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="14"
                                        Height="14"
                                        Margin="0,0,7,0"
                                        CornerRadius="7"
                                        Background="{Binding Hex}"/>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBox Margin="0,8,0,0"
                         HorizontalAlignment="Left"
                         Width="140"
                         Style="{StaticResource SettingsInput}"
                         Text="{Binding AccentText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </controls:SettingCard>

        <controls:SectionHeader Text="PATHS"/>
        <controls:SettingCard Title="Path display"
                           Hint="How long project paths are shortened in the launch window."
                           Icon="{x:Static themes:IconGlyphs.FolderOpen}">
            <ComboBox HorizontalAlignment="Right"
                      ItemsSource="{Binding PathDisplays}"
                      SelectedItem="{Binding SelectedPathDisplay, Mode=TwoWay}"
                      Style="{StaticResource SettingsComboBox}"
                      behaviors:ComboBoxBehaviors.AutoWidthToItems="True">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingCard>
    </StackPanel>
</UserControl>
