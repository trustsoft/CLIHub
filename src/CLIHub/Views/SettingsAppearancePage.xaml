<UserControl x:Class="CLIHub.Views.SettingsAppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock Style="{StaticResource PageHeader}" Text="Appearance"/>

        <TextBlock Margin="0,16,0,8"
                   Style="{StaticResource FieldLabel}"
                   Text="Application theme"/>
        <ListBox HorizontalAlignment="Left"
                 ItemsSource="{Binding AppThemes}"
                 SelectedItem="{Binding SelectedAppTheme, Mode=TwoWay}"
                 Style="{StaticResource SegmentGroup}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Margin="0,8,0,0"
                   Style="{StaticResource HintText}"
                   Text="Takes effect after the next start. System follows Windows."/>

        <TextBlock Margin="0,20,0,8"
                   Style="{StaticResource FieldLabel}"
                   Text="Accent color"/>
        <ListBox HorizontalAlignment="Left"
                 ItemsSource="{Binding AccentOptions}"
                 SelectedItem="{Binding SelectedAccent, Mode=TwoWay}"
                 Style="{StaticResource SegmentGroup}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="14"
                                Height="14"
                                Margin="0,0,7,0"
                                CornerRadius="7"
                                Background="{Binding Hex}"/>
                        <TextBlock Text="{Binding Name}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBox Margin="0,8,0,0"
                 HorizontalAlignment="Left"
                 Width="140"
                 Style="{StaticResource SettingsInput}"
                 Text="{Binding AccentText, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Margin="0,8,0,0"
                   Style="{StaticResource HintText}"
                   Text="Enter #RRGGBB for a custom accent. Applies immediately on save."/>

        <TextBlock Margin="0,20,0,8"
                   Style="{StaticResource FieldLabel}"
                   Text="Path display"/>
        <ListBox HorizontalAlignment="Left"
                 ItemsSource="{Binding PathDisplays}"
                 SelectedItem="{Binding SelectedPathDisplay, Mode=TwoWay}"
                 Style="{StaticResource SegmentGroup}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Segment}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Margin="0,8,0,0"
                   Style="{StaticResource HintText}"
                   Text="How long project paths are shortened in the launch window."/>
    </StackPanel>
</UserControl>
