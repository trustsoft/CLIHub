<UserControl x:Class="CLIHub.Views.SettingsHotkeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CLIHub.Controls"
             xmlns:themes="clr-namespace:CLIHub.Themes"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock Style="{StaticResource PageHeader}" Text="Hotkeys &amp; Quick Launcher"/>
        <TextBlock Margin="0,6,0,0"
                   Style="{StaticResource HintText}"
                   Text="The global hotkey and where the launcher appears."/>

        <controls:SectionHeader Text="ACTIVATION"/>
        <controls:SettingCard Title="Global hotkey"
                           Hint="Press a combination in the field. Esc cancels capture."
                           Icon="{x:Static themes:IconGlyphs.Keyboard}">
            <Border x:Name="HotkeyField"
                    MouseLeftButtonDown="HotkeyField_MouseLeftButtonDown"
                    PreviewKeyDown="HotkeyField_PreviewKeyDown"
                    Style="{StaticResource HotkeyField}">
                <!-- -6 cancels the last chip's trailing margin, so the left and right insets stay equal -->
                <ItemsControl Margin="0,0,-6,0" ItemsSource="{Binding HotkeyParts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HotkeyChip}">
                                <TextBlock Style="{StaticResource HotkeyChipText}" Text="{Binding}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </controls:SettingCard>

        <controls:SectionHeader Text="POPUP"/>
        <controls:SettingCard Title="Popup screen position"
                           Hint="Where the launch window appears when it is shown."
                           Icon="{x:Static themes:IconGlyphs.Location}"
                           HorizontalContentAlignment="Left"
                           Placement="Stacked">
            <ListBox ItemsSource="{Binding PopupPositions}"
                     SelectedItem="{Binding SelectedPopupPosition, Mode=TwoWay}"
                     Style="{StaticResource SegmentGroup}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </controls:SettingCard>
    </StackPanel>
</UserControl>
