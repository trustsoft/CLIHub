<UserControl x:Class="CLIHub.Views.SettingsProjectRegistryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CLIHub.Controls"
             xmlns:themes="clr-namespace:CLIHub.Themes"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ProjectProvenanceMark" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Section}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Style.Triggers>
                <!-- Manual provenance colors the mark; CanRemove is true exactly for manual
                     projects (discovered projects are read-only). -->
                <DataTrigger Binding="{Binding CanRemove}" Value="True">
                    <!-- Same brush as the selected Settings sidebar item: the accent color
                         with that selection's alpha channel. -->
                    <Setter Property="Foreground" Value="{DynamicResource AccentSelectionBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The "Folder not found" chip: visible while the row's enriched snapshot reports the
             folder unavailable, so no inverted converter is needed. -->
        <Style x:Key="ProjectMissingChip" TargetType="Border" BasedOn="{StaticResource HeaderChip}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFolderAvailable}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProjectMissingChipText" TargetType="TextBlock" BasedOn="{StaticResource HeaderChipLabel}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <controls:SectionHeader Text="REGISTERED PROJECTS"/>

        <TextBlock Margin="0,0,0,4"
                   Style="{StaticResource HintText}"
                   Text="Project changes apply immediately. Save and Cancel only affect the other settings."
                   TextWrapping="Wrap"/>

        <TextBlock Margin="0,0,0,10"
                   Style="{StaticResource HintText}"
                   Text="Discovered projects are managed by Project Discovery and are read-only here."
                   TextWrapping="Wrap"/>

        <Grid MinHeight="44" Margin="0,0,0,4">
            <Rectangle RadiusX="8"
                       RadiusY="8"
                       Stroke="{DynamicResource FieldStrokeBrush}"
                       StrokeDashArray="3 3"
                       StrokeThickness="1"/>
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="{x:Static themes:IconGlyphs.Add}"/>

                <TextBox Grid.Column="1"
                         Margin="4,0"
                         VerticalAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         Style="{StaticResource SettingsInput}"
                         Tag="Enter absolute directory path (e.g., C:\repos)…"
                         Text="{Binding ProjectRegistry.NewProjectPath, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{Binding ProjectRegistry.BrowseCommand}"
                        Content="Browse…"
                        Style="{StaticResource NeutralButton}"/>

                <Button Grid.Column="3"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding ProjectRegistry.RegisterCommand}"
                        Content="Register"
                        Style="{StaticResource AccentButton}"/>
            </Grid>
        </Grid>

        <TextBlock Margin="0,0,0,8"
                   Style="{StaticResource ErrorText}"
                   Text="{Binding ProjectRegistry.ErrorText}"
                   Visibility="{Binding ProjectRegistry.HasError, Converter={StaticResource BoolToVisibility}}"/>

        <ItemsControl ItemsSource="{Binding ProjectRegistry.Projects}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8"
                            Padding="10"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="32"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ThumbBgBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{x:Static themes:IconGlyphs.FolderOpen}"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0"
                                        VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                    <TextBlock MaxWidth="{StaticResource Sizing.SettingsProjectRow.NameMaxWidth}"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource Sizing.FontSize.Name}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}"/>

                                    <TextBlock Margin="8,0,0,0"
                                               Style="{StaticResource ProjectProvenanceMark}"
                                               AutomationProperties.Name="{Binding SourceLabel}"
                                               Text="{Binding SourceMark}"
                                               ToolTip="{Binding SourceLabel}"/>

                                    <Border Margin="8,0,0,0"
                                            Style="{StaticResource ProjectMissingChip}">
                                        <TextBlock Style="{StaticResource ProjectMissingChipText}"
                                                   Text="Folder not found"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Margin="0,1,0,0"
                                           Style="{StaticResource HintText}"
                                           Text="{Binding DisplayPath}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DisplayPath}"/>
                            </StackPanel>

                            <controls:SpacedPanel Grid.Column="2"
                                                  Margin="0,0,-2,0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Orientation="Horizontal"
                                                  Spacing="2">
                                <Button Width="{StaticResource Sizing.IconButton.Width}"
                                        Height="{StaticResource Sizing.IconButton.Height}"
                                        AutomationProperties.Name="Open project folder"
                                        Command="{Binding DataContext.ProjectRegistry.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ChipRemoveButton}"
                                        ToolTip="Open project folder">
                                    <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                               FontSize="16"
                                               Text="{x:Static themes:IconGlyphs.FolderOpen}"/>
                                </Button>

                                <Button Width="{StaticResource Sizing.IconButton.Width}"
                                        Height="{StaticResource Sizing.IconButton.Height}"
                                        AutomationProperties.Name="Remove project"
                                        Command="{Binding DataContext.ProjectRegistry.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ChipRemoveButton}"
                                        ToolTip="Remove project"
                                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                               FontSize="16"
                                               Text="{x:Static themes:IconGlyphs.Delete}"/>
                                </Button>
                            </controls:SpacedPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Margin="0,0,0,8"
                   Text="No projects registered yet.">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ProjectRegistry.Projects.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
