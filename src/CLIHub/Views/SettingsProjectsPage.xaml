<UserControl x:Class="CLIHub.Views.SettingsProjectsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CLIHub.Controls"
             xmlns:behaviors="clr-namespace:CLIHub.Behaviors"
             xmlns:themes="clr-namespace:CLIHub.Theming"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock Margin="0,2,0,0"
                   Style="{StaticResource HintText}"
                   Text="Changes apply immediately. Save and Cancel only affect the other pages."
                   TextWrapping="Wrap"/>

        <Grid>
            <controls:SectionHeader Text="WATCHED FOLDERS"/>
            <TextBlock Margin="0,18,0,8"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Style="{StaticResource HintText}"
                       Text="{Binding Scanning.WatchedRootsSummary}"
                       TextWrapping="NoWrap"/>
        </Grid>

        <ItemsControl ItemsSource="{Binding Scanning.WatchedDirectories}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8"
                            Padding="14"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="40"
                                    Height="40"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ThumbBgBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                           FontSize="15"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{x:Static themes:IconGlyphs.FolderOpen}"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="14,0,14,0"
                                        VerticalAlignment="Center">
                                <TextBlock FontSize="{StaticResource Sizing.FontSize.Name}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding Path}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Path}"/>
                                <controls:SpacedPanel Margin="0"
                                                      Orientation="Horizontal"
                                                      Spacing="2">
                                    <ComboBox ItemsSource="{Binding DepthOptions}"
                                              SelectedItem="{Binding SelectedDepth, Mode=TwoWay}"
                                              Style="{StaticResource SettingsChipComboBox}"
                                              Tag="{Binding DepthChipLabel}"
                                              ToolTip="Folder scan depth"/>
                                    <ComboBox ItemsSource="{Binding DiscoveryOptions}"
                                              SelectedItem="{Binding SelectedDiscovery, Mode=TwoWay}"
                                              Style="{StaticResource SettingsChipComboBox}"
                                              Tag="{Binding DiscoveryChipLabel}"
                                              ToolTip="What counts as a repository"/>
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource HintText}"
                                               Text="{Binding DiscoveredSummary}"/>
                                </controls:SpacedPanel>
                            </StackPanel>

                            <controls:SpacedPanel Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  Orientation="Horizontal"
                                                  Spacing="2">
                                <Button Width="{StaticResource Sizing.IconButton.Width}"
                                        Height="{StaticResource Sizing.IconButton.Height}"
                                        AutomationProperties.Name="Rescan this watched folder"
                                        Command="{Binding DataContext.Scanning.ScanWatchedDirectoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Path}"
                                        Style="{StaticResource ChipRemoveButton}"
                                        ToolTip="Rescan this folder only">
                                    <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                               FontSize="{StaticResource Sizing.FontSize.Glyph}"
                                               Text="{x:Static themes:IconGlyphs.Refresh}"/>
                                </Button>

                                <Button Width="{StaticResource Sizing.IconButton.Width}"
                                        Height="{StaticResource Sizing.IconButton.Height}"
                                        AutomationProperties.Name="Remove watched folder"
                                        Command="{Binding DataContext.Scanning.RemoveWatchedDirectoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Path}"
                                        Style="{StaticResource ChipRemoveButton}"
                                        ToolTip="Remove watched folder">
                                    <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                               FontSize="{StaticResource Sizing.FontSize.Glyph}"
                                               Text="{x:Static themes:IconGlyphs.Delete}"/>
                                </Button>
                            </controls:SpacedPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid MinHeight="44" Margin="0,4,0,0">
            <Rectangle RadiusX="8"
                       RadiusY="8"
                       Stroke="{DynamicResource FieldStrokeBrush}"
                       StrokeDashArray="3 3"
                       StrokeThickness="1"/>
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                           FontSize="{StaticResource Sizing.FontSize.GlyphTiny}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="{x:Static themes:IconGlyphs.Add}"/>

                <TextBox Grid.Column="1"
                         Margin="4,0"
                         VerticalAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         Style="{StaticResource SettingsInput}"
                         Tag="Absolute folder path, e.g. C:\repos"
                         Text="{Binding Scanning.NewWatchedDirectoryText, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{Binding Scanning.BrowseWatchedDirectoryCommand}"
                        Content="Browse…"
                        Style="{StaticResource NeutralButton}"/>

                <Button Grid.Column="3"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding Scanning.AddWatchedDirectoryCommand}"
                        Content="Add"
                        Style="{StaticResource AccentButton}"/>
            </Grid>
        </Grid>

        <TextBlock Margin="0,6,0,0"
                   Style="{StaticResource ErrorText}"
                   Text="{Binding Scanning.WatchedDirectoryError}"
                   Visibility="{Binding Scanning.HasWatchedDirectoryError, Converter={StaticResource BoolToVisibility}}"/>

        <controls:SectionHeader Text="SCANNING RULES"/>
        <TextBlock Margin="0,0,0,10"
                   Style="{StaticResource HintText}"
                   Text="Depth and discovery are defaults for new folders; each row can override them."
                   TextWrapping="Wrap"/>
        <controls:SettingsGroup>
            <controls:SettingCard Title="Scan depth"
                           Hint="Levels below a watched folder to search."
                           Icon="{x:Static themes:IconGlyphs.Zoom}"
                           Grouped="True">
            <ComboBox HorizontalAlignment="Right"
                      ItemsSource="{Binding Scanning.ScanDepthOptions}"
                      SelectedItem="{Binding Scanning.SelectedScanDepth, Mode=TwoWay}"
                      Style="{StaticResource SettingsComboBox}"
                      behaviors:ComboBoxBehaviors.AutoWidthToItems="True">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingCard>

        <controls:SettingCard Title="Discovery"
                           Hint="Git repositories, AI agent folders (.claude, .opencode), or both."
                           Icon="{x:Static themes:IconGlyphs.Filter}"
                           Grouped="True">
            <ComboBox HorizontalAlignment="Right"
                      ItemsSource="{Binding Scanning.DiscoveryModes}"
                      SelectedItem="{Binding Scanning.SelectedDiscoveryMode, Mode=TwoWay}"
                      Style="{StaticResource SettingsComboBox}"
                      behaviors:ComboBoxBehaviors.AutoWidthToItems="True">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingCard>

        <controls:SettingCard Title="Ignored patterns"
                           Hint="Folder names skipped in every scan. Case-insensitive; * is a wildcard."
                           Icon="{x:Static themes:IconGlyphs.Blocked}"
                           Grouped="True"
                           Placement="Stacked">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Scanning.IgnoredPatterns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}">
                                <ContentControl.Template>
                                    <ControlTemplate TargetType="ContentControl">
                                        <Border x:Name="ChipBorder"
                                                Margin="0,0,8,8"
                                                Padding="8,4"
                                                Background="{DynamicResource ChipBgBrush}"
                                                BorderBrush="{DynamicResource FieldStrokeBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                                                Focusable="True"
                                                FocusVisualStyle="{x:Null}">
                                            <Grid>
                                                <!-- Sizing layer: TextBlock only (chip hugs text) -->
                                                <TextBlock x:Name="PatternText"
                                                           VerticalAlignment="Center"
                                                           FontSize="{StaticResource Sizing.FontSize.Chip}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="{TemplateBinding Content}"/>
                                                <!-- Overlay layer: centered remove button -->
                                                <Button x:Name="RemoveButton"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="Hidden"
                                                        AutomationProperties.Name="Remove pattern"
                                                        Command="{Binding DataContext.Scanning.RemoveIgnoredPatternCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}"
                                                        Style="{StaticResource ChipRemoveButton}"
                                                        ToolTip="Remove pattern">
                                                    <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                                               FontSize="8"
                                                               Text="{x:Static themes:IconGlyphs.Close}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger SourceName="ChipBorder" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PatternText" Property="Visibility" Value="Hidden"/>
                                                <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <Trigger SourceName="ChipBorder" Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="PatternText" Property="Visibility" Value="Hidden"/>
                                                <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ContentControl.Template>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid MinHeight="40" HorizontalAlignment="Left">
                    <Rectangle RadiusX="6"
                               RadiusY="6"
                               Stroke="{DynamicResource FieldStrokeBrush}"
                               StrokeDashArray="3 3"
                               StrokeThickness="1"/>
                    <StackPanel Margin="8,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{x:Static themes:IconGlyphs.Add}"/>
                        <TextBox Width="160"
                                 Margin="8,0"
                                 VerticalAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Style="{StaticResource SettingsInput}"
                                 Tag="Add pattern"
                                 Text="{Binding Scanning.NewIgnoredPatternText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button VerticalAlignment="Center"
                                Padding="12,5"
                                Command="{Binding Scanning.AddIgnoredPatternCommand}"
                                Content="Add"
                                Style="{StaticResource NeutralButton}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </controls:SettingCard>
        </controls:SettingsGroup>
    </StackPanel>
</UserControl>
