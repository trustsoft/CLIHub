<UserControl x:Class="CLIHub.Views.SettingsProjectsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CLIHub.Controls"
             xmlns:behaviors="clr-namespace:CLIHub.Behaviors"
             xmlns:themes="clr-namespace:CLIHub.Themes"
             mc:Ignorable="d">
    <StackPanel>
        <Grid>
            <controls:SectionHeader Text="WATCHED REPOSITORY DIRECTORIES"/>
            <TextBlock Margin="0,18,0,8"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Style="{StaticResource HintText}"
                       Text="{Binding WatchedRootsSummary}"
                       TextWrapping="NoWrap"/>
        </Grid>

        <ItemsControl ItemsSource="{Binding WatchedDirectories}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8"
                            Padding="14"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="40"
                                    Height="40"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ThumbBgBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                           FontSize="15"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{x:Static themes:IconGlyphs.FolderOpen}"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="14,0,14,0"
                                        VerticalAlignment="Center">
                                <TextBlock FontSize="{StaticResource Sizing.FontSize.Name}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding}"/>
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource HintText}"
                                           Text="{Binding DataContext.ScanSummary, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           TextWrapping="NoWrap"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Remove watched root"
                                    Command="{Binding DataContext.RemoveWatchedDirectoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource ChipRemoveButton}"
                                    ToolTip="Remove watched root">
                                <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                           FontSize="12"
                                           Text="{x:Static themes:IconGlyphs.Delete}"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid MinHeight="44" Margin="0,4,0,0">
            <Rectangle RadiusX="8"
                       RadiusY="8"
                       Stroke="{DynamicResource FieldStrokeBrush}"
                       StrokeDashArray="3 3"
                       StrokeThickness="1"/>
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="{x:Static themes:IconGlyphs.Add}"/>

                <TextBox Grid.Column="1"
                         Margin="10,0"
                         VerticalAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         Style="{StaticResource SettingsInput}"
                         Tag="Enter absolute directory path (e.g., C:\repos)…"
                         Text="{Binding NewWatchedDirectoryText, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{Binding BrowseWatchedDirectoryCommand}"
                        Content="Browse…"
                        Style="{StaticResource NeutralButton}"/>

                <Button Grid.Column="3"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding AddWatchedDirectoryCommand}"
                        Content="Register"
                        Style="{StaticResource AccentButton}"/>
            </Grid>
        </Grid>

        <TextBlock Margin="0,6,0,0"
                   Style="{StaticResource ErrorText}"
                   Text="{Binding WatchedDirectoryError}"
                   Visibility="{Binding HasWatchedDirectoryError, Converter={StaticResource BoolToVisibility}}"/>

        <controls:SectionHeader Text="DISCOVERY &amp; SCANNING RULES"/>

        <controls:SettingCard Title="Repository scan depth"
                           Hint="Folder depth scanned for .git boundaries and root indicators."
                           Icon="{x:Static themes:IconGlyphs.Zoom}">
            <ComboBox HorizontalAlignment="Right"
                      ItemsSource="{Binding ScanDepthOptions}"
                      SelectedItem="{Binding SelectedScanDepth, Mode=TwoWay}"
                      Style="{StaticResource SettingsComboBox}"
                      behaviors:ComboBoxBehaviors.AutoWidthToItems="True">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingCard>

        <controls:SettingCard Title="Repository discovery"
                           Hint="Which directories count as repositories: Git repositories (.git), Agent folders (plugin markers), or Both."
                           Icon="{x:Static themes:IconGlyphs.Filter}">
            <ComboBox HorizontalAlignment="Right"
                      ItemsSource="{Binding DiscoveryModes}"
                      SelectedItem="{Binding SelectedDiscoveryMode, Mode=TwoWay}"
                      Style="{StaticResource SettingsComboBox}"
                      behaviors:ComboBoxBehaviors.AutoWidthToItems="True">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingCard>

        <controls:SettingCard Title="Ignored directory patterns"
                           Hint="Folders skipped while scanning. Globs are matched case-insensitively; '*' matches any characters."
                           Badge="Globs supported"
                           Icon="{x:Static themes:IconGlyphs.Blocked}"
                           Placement="Stacked">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding IgnoredPatterns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,8,8"
                                    Padding="8,4,4,4"
                                    Background="{DynamicResource ChipBgBrush}"
                                    BorderBrush="{DynamicResource FieldStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Sizing.CornerRadius.Chip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="{StaticResource Sizing.FontSize.Body}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding}"/>
                                    <Button Margin="4,0,0,0"
                                            AutomationProperties.Name="Remove pattern"
                                            Command="{Binding DataContext.RemoveIgnoredPatternCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ChipRemoveButton}"
                                            ToolTip="Remove pattern">
                                        <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                                   FontSize="8"
                                                   Text="{x:Static themes:IconGlyphs.Close}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid MinHeight="40" HorizontalAlignment="Left">
                    <Rectangle RadiusX="6"
                               RadiusY="6"
                               Stroke="{DynamicResource FieldStrokeBrush}"
                               StrokeDashArray="3 3"
                               StrokeThickness="1"/>
                    <StackPanel Margin="8,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{x:Static themes:IconGlyphs.Add}"/>
                        <TextBox Width="160"
                                 Margin="8,0"
                                 VerticalAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Style="{StaticResource SettingsInput}"
                                 Tag="Add pattern"
                                 Text="{Binding NewIgnoredPatternText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button VerticalAlignment="Center"
                                Padding="12,5"
                                Command="{Binding AddIgnoredPatternCommand}"
                                Content="Add"
                                Style="{StaticResource NeutralButton}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </controls:SettingCard>
    </StackPanel>
</UserControl>
