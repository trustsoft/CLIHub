<UserControl x:Class="CLIHub.Views.SettingsProjectsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CLIHub.Controls"
             xmlns:behaviors="clr-namespace:CLIHub.Behaviors"
             xmlns:themes="clr-namespace:CLIHub.Themes"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock Style="{StaticResource PageHeader}" Text="Projects &amp; Paths"/>
        <TextBlock Margin="0,6,0,0"
                   Style="{StaticResource HintText}"
                   Text="Watched directories, discovery rules, and the background watcher."/>

        <Rectangle Height="1"
                   Margin="0,14,0,0"
                   Fill="{DynamicResource HairlineBrush}"/>

        <controls:SectionHeader Text="REPOSITORIES"/>
        <controls:SettingCard Title="Watched directories"
                           Hint="Root folders CLIHub scans for repositories. Nothing is watched while this list is empty."
                           Icon="{x:Static themes:IconGlyphs.FolderOpen}"
                           Placement="Stacked">
            <StackPanel>
                <ListBox MinHeight="84"
                         ItemsSource="{Binding WatchedDirectories}"
                         SelectedItem="{Binding SelectedWatchedDirectory, Mode=TwoWay}"
                         Style="{StaticResource SettingsList}"/>
                <controls:SpacedPanel Margin="0,8,0,0"
                                      Orientation="Horizontal"
                                      Spacing="{StaticResource Sizing.Spacing}">
                    <Button Command="{Binding AddWatchedDirectoryCommand}"
                            Content="Add folder…"
                            Style="{StaticResource NeutralButton}"/>
                    <Button Command="{Binding RemoveWatchedDirectoryCommand}"
                            Content="Remove"
                            Style="{StaticResource NeutralButton}"/>
                </controls:SpacedPanel>
            </StackPanel>
        </controls:SettingCard>

        <controls:SettingCard Title="Repository scan depth"
                           Hint="How many directory levels below each watched root are scanned (1-8)."
                           Icon="{x:Static themes:IconGlyphs.Zoom}">
            <controls:NumericField HorizontalAlignment="Left"
                                   Width="120"
                                   Maximum="8"
                                   Minimum="1"
                                   Step="1"
                                   Text="{Binding ScanDepthText, UpdateSourceTrigger=PropertyChanged}"/>
        </controls:SettingCard>

        <controls:SettingCard Title="Repository discovery"
                           Hint="Which directories count as repositories: Git repositories (.git), Agent folders (plugin markers), or Both."
                           Icon="{x:Static themes:IconGlyphs.Filter}">
            <ComboBox HorizontalAlignment="Right"
                      ItemsSource="{Binding DiscoveryModes}"
                      SelectedItem="{Binding SelectedDiscoveryMode, Mode=TwoWay}"
                      Style="{StaticResource SettingsComboBox}"
                      behaviors:ComboBoxBehaviors.AutoWidthToItems="True">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingCard>

        <controls:SettingCard Title="Ignored directory patterns"
                           Hint="Folder names skipped while scanning. '*' matches any characters; matching is case-insensitive."
                           Icon="{x:Static themes:IconGlyphs.Blocked}"
                           Placement="Stacked">
            <StackPanel>
                <ListBox MinHeight="64"
                         ItemsSource="{Binding IgnoredPatterns}"
                         SelectedItem="{Binding SelectedIgnoredPattern, Mode=TwoWay}"
                         Style="{StaticResource SettingsList}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Style="{StaticResource SettingsInput}"
                             Tag="Folder name or pattern"
                             Text="{Binding NewIgnoredPatternText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Command="{Binding AddIgnoredPatternCommand}"
                            Content="Add"
                            Style="{StaticResource NeutralButton}"/>
                    <Button Grid.Column="2"
                            Margin="8,0,0,0"
                            Command="{Binding RemoveIgnoredPatternCommand}"
                            Content="Remove"
                            Style="{StaticResource NeutralButton}"/>
                </Grid>
            </StackPanel>
        </controls:SettingCard>

        <controls:SectionHeader Text="BACKGROUND WATCHER"/>
        <controls:SettingCard Title="Watcher status"
                           Hint="Status is read-only; watching starts automatically when at least one directory is configured."
                           Icon="{x:Static themes:IconGlyphs.Sync}"
                           Placement="Stacked">
            <TextBlock Style="{StaticResource StatusLine}" Text="{Binding WatcherStatusText}"/>
        </controls:SettingCard>
    </StackPanel>
</UserControl>
