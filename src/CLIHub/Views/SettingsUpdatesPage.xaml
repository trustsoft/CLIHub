<UserControl x:Class="CLIHub.Views.SettingsUpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CLIHub.Controls"
             xmlns:themes="clr-namespace:CLIHub.Themes"
             mc:Ignorable="d">
    <StackPanel>
        <controls:SectionHeader Text="UPDATE PREFERENCES"/>
        <controls:SettingsGroup>
            <controls:SettingCard Title="Check for updates on startup"
                               Hint="Look for a new version when CLIHub starts."
                               Icon="{x:Static themes:IconGlyphs.Sync}"
                               Grouped="True">
                <CheckBox HorizontalAlignment="Right"
                          IsChecked="{Binding CheckForUpdatesOnStartup, Mode=TwoWay}"
                          Style="{StaticResource ToggleCheckBox}"/>
            </controls:SettingCard>
            <controls:SettingCard Title="Automatically download updates"
                               Hint="Download an available update in the background."
                               Icon="{x:Static themes:IconGlyphs.Update}"
                               Grouped="True">
                <CheckBox HorizontalAlignment="Right"
                          IsChecked="{Binding AutoDownloadUpdates, Mode=TwoWay}"
                          Style="{StaticResource ToggleCheckBox}"/>
            </controls:SettingCard>
            <controls:SettingCard Title="Notify about stable releases"
                               Hint="Show a notification when a stable update is available."
                               Icon="{x:Static themes:IconGlyphs.Ringer}"
                               Grouped="True">
                <CheckBox HorizontalAlignment="Right"
                          IsChecked="{Binding NotifyStableUpdates, Mode=TwoWay}"
                          Style="{StaticResource ToggleCheckBox}"/>
            </controls:SettingCard>
            <!-- Pre-release builds are not published yet (stable-only releases), so the option
                 cannot change the update check or its notification; re-enable with a beta channel. -->
            <controls:SettingCard Title="Notify about pre-release versions"
                               Hint="Not available yet: CLIHub publishes stable releases only."
                               Icon="{x:Static themes:IconGlyphs.Info}"
                               Grouped="True"
                               Opacity="0.6">
                <CheckBox HorizontalAlignment="Right"
                          IsChecked="{Binding NotifyPrereleaseUpdates, Mode=TwoWay}"
                          IsEnabled="False"
                          Style="{StaticResource ToggleCheckBox}"/>
            </controls:SettingCard>
        </controls:SettingsGroup>
    </StackPanel>
</UserControl>
