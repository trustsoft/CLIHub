<UserControl x:Class="CLIHub.Views.SettingsUpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CLIHub.Controls"
             xmlns:themes="clr-namespace:CLIHub.Themes"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock Style="{StaticResource PageHeader}" Text="Updates"/>
        <TextBlock Margin="0,6,0,0"
                   Style="{StaticResource HintText}"
                   Text="Update checks, downloads, and notifications."/>
        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
            <TextBlock Style="{StaticResource HintText}" Text="Current version: "/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Version}"/>
        </StackPanel>

        <Rectangle Height="1"
                   Margin="0,14,0,0"
                   Fill="{DynamicResource HairlineBrush}"/>

        <controls:SectionHeader Text="AUTOMATIC"/>
        <controls:SettingsGroup>
            <controls:SettingCard Title="Check for updates on startup"
                               Hint="Look for a new version when CLIHub starts."
                               Icon="{x:Static themes:IconGlyphs.Sync}"
                               Grouped="True">
                <CheckBox HorizontalAlignment="Right"
                          IsChecked="{Binding CheckForUpdatesOnStartup, Mode=TwoWay}"
                          Style="{StaticResource ToggleCheckBox}"/>
            </controls:SettingCard>
            <controls:SettingCard Title="Automatically download updates"
                               Hint="Download an available update in the background."
                               Icon="{x:Static themes:IconGlyphs.Update}"
                               Grouped="True">
                <CheckBox HorizontalAlignment="Right"
                          IsChecked="{Binding AutoDownloadUpdates, Mode=TwoWay}"
                          Style="{StaticResource ToggleCheckBox}"/>
            </controls:SettingCard>
            <controls:SettingCard Title="Notify about stable releases"
                               Hint="Show a notification when a stable update is available."
                               Icon="{x:Static themes:IconGlyphs.Ringer}"
                               Grouped="True">
                <CheckBox HorizontalAlignment="Right"
                          IsChecked="{Binding NotifyStableUpdates, Mode=TwoWay}"
                          Style="{StaticResource ToggleCheckBox}"/>
            </controls:SettingCard>
            <controls:SettingCard Title="Notify about pre-release versions"
                               Hint="Include pre-release versions and notify when one is available."
                               Icon="{x:Static themes:IconGlyphs.Info}"
                               Grouped="True">
                <CheckBox HorizontalAlignment="Right"
                          IsChecked="{Binding NotifyPrereleaseUpdates, Mode=TwoWay}"
                          Style="{StaticResource ToggleCheckBox}"/>
            </controls:SettingCard>
        </controls:SettingsGroup>

        <controls:SectionHeader Text="MANUAL"/>
        <controls:SettingCard Title="Update status"
                           Hint="Run a check now and see the result."
                           Icon="{x:Static themes:IconGlyphs.Update}"
                           VerticalContentAlignment="Top">
            <controls:SpacedPanel Orientation="Vertical"
                                  Spacing="{StaticResource Sizing.Spacing}">
                <Button HorizontalAlignment="Right"
                        Command="{Binding CheckForUpdatesCommand}"
                        Content="Check for updates"
                        Style="{StaticResource NeutralButton}"/>
                <TextBlock MaxWidth="240" Text="{Binding UpdateMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusLine}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UpdateMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding UpdateMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </controls:SpacedPanel>
        </controls:SettingCard>
    </StackPanel>
</UserControl>
