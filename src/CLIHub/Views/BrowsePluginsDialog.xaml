<Window x:Class="CLIHub.Views.BrowsePluginsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:themes="clr-namespace:CLIHub.Theming"
        mc:Ignorable="d"
        Title="Browse Plugins"
        Icon="pack://application:,,,/app.ico"
        Background="{DynamicResource ChromeBgBrush}"
        FontFamily="{StaticResource Sizing.FontFamily.Text}"
        Height="600" Width="800"
        MinHeight="400" MinWidth="600"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource FieldStrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top highlight -->
            <Rectangle Grid.Row="0" Height="1" Fill="{DynamicResource TopHighlightBrush}"/>

            <!-- Header: title and close button -->
            <Grid Grid.Row="1" Style="{StaticResource WindowHeader}">
                <StackPanel Margin="12,0,0,0"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Width="16"
                           Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="pack://application:,,,/app.ico"/>
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Browse Plugins"/>
                </StackPanel>

                <Button HorizontalAlignment="Right"
                        Click="OnCloseClick"
                        Style="{StaticResource WindowCloseButton}"
                        ToolTip="Close">
                    <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                               FontSize="{StaticResource Sizing.FontSize.GlyphSmall}"
                               Text="{x:Static themes:IconGlyphs.Close}"/>
                </Button>
            </Grid>

            <Rectangle Grid.Row="2"
                       Height="1"
                       VerticalAlignment="Top"
                       Fill="{DynamicResource HairlineBrush}"/>

            <!-- Content -->
            <ScrollViewer Grid.Row="2"
                          Margin="0,1,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid Margin="24">
                    <!-- Loading state -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="14"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Text="Loading plugins..."/>
                    </StackPanel>

                    <!-- Error state -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="500"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource DangerBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"
                                   Text="Failed to load plugin feed"/>
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16"
                                   Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap"/>
                        <Button Command="{Binding RefreshCommand}"
                                Content="Retry"
                                HorizontalAlignment="Center"
                                Style="{StaticResource AccentButton}"/>
                    </StackPanel>

                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="14"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Text="No plugins available"/>
                    </StackPanel>

                    <!-- Plugin list -->
                    <ItemsControl ItemsSource="{Binding Plugins}"
                                  Visibility="{Binding HasPlugins, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ChromeBgBrush}"
                                        BorderBrush="{DynamicResource FieldStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,0,0,12"
                                        Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Name and version -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding Name}"/>
                                             <TextBlock Margin="8,0,0,0"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="{Binding VersionText}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Action button -->
                                        <Button Grid.Row="0" Grid.Column="1"
                                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding ActionText}"
                                                IsEnabled="{Binding CanInstall}"
                                                Visibility="{Binding ShowActionButton, Converter={StaticResource BoolToVisibility}}"
                                                Style="{StaticResource AccentButton}"/>

                                        <!-- Publisher and homepage -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" Orientation="Horizontal">
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="by "/>
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="{Binding Publisher}"/>
                                            <TextBlock Margin="8,0,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="•"
                                                       Visibility="{Binding HasHomepage, Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock Margin="8,0,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Text="{Binding Homepage}"
                                                       Visibility="{Binding HasHomepage, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>

                                        <!-- Description -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Margin="0,8,0,0"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding Description}"
                                                   TextWrapping="Wrap"/>

                                        <!-- Warning message -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Margin="0,8,0,0"
                                                   FontSize="12"
                                                   FontStyle="Italic"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Text="{Binding WarningMessage}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}"/>

                                        <!-- Blocked reason -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Margin="0,8,0,0"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   Text="{Binding BlockedReason}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding BlockedReason, Converter={StaticResource EmptyToCollapsedVisibility}}"/>

                                        <!-- Status indicator -->
                                        <Border Grid.Row="1" Grid.Column="1"
                                                Background="{DynamicResource AccentSelectionBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Margin="0,8,0,0"
                                                Padding="8,4"
                                                HorizontalAlignment="Right">
                                            <TextBlock FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Text="{Binding StatusText}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- Footer: Refresh and Close buttons -->
            <Border Grid.Row="3"
                    Background="{DynamicResource ChromeBgBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Command="{Binding RefreshCommand}"
                            Content="Refresh"
                            Margin="0,0,8,0"
                            Style="{StaticResource NeutralButton}"/>
                    <Button Click="OnCloseClick"
                            Content="Close"
                            Style="{StaticResource NeutralButton}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
