<UserControl x:Class="CLIHub.Views.SettingsAgentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CLIHub.Controls"
             xmlns:behaviors="clr-namespace:CLIHub.Behaviors"
             xmlns:themes="clr-namespace:CLIHub.Themes"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock Style="{StaticResource PageHeader}" Text="CLI Agents"/>
        <TextBlock Margin="0,6,0,0"
                   Style="{StaticResource HintText}"
                   Text="Installed CLI agents, the default agent, and probe settings."/>
        <TextBlock Margin="0,6,0,0"
                   Style="{StaticResource HintText}"
                   Text="{Binding AgentsState.Metrics}"/>

        <Rectangle Height="1"
                   Margin="0,14,0,0"
                   Fill="{DynamicResource HairlineBrush}"/>

        <controls:SectionHeader Text="MANAGEMENT"/>
        <controls:SettingCard Title="Default agent"
                           Hint="Preselected when the launch window opens."
                           Icon="{x:Static themes:IconGlyphs.Robot}">
            <ComboBox HorizontalAlignment="Right"
                      ItemsSource="{Binding AgentsState.DefaultAgentOptions}"
                      SelectedItem="{Binding AgentsState.SelectedDefaultAgent, Mode=TwoWay}"
                      Style="{StaticResource SettingsComboBox}"
                      behaviors:ComboBoxBehaviors.AutoWidthToItems="True">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingCard>

        <TextBlock Margin="0,8,0,8"
                   Style="{StaticResource FieldLabel}"
                   Text="Agents"/>
        <ItemsControl ItemsSource="{Binding AgentsState.Cards}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10"
                            Padding="12"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="32"
                                    Height="32"
                                    VerticalAlignment="Top"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding LogoPath, Converter={StaticResource PathToImage}}"
                                                Stretch="Uniform"/>
                                </Border.Background>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock FontSize="{StaticResource Sizing.FontSize.Body}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding Name}"/>
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource HintText}"
                                           Text="{Binding StatusText}"/>
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource HintText}"
                                           Text="{Binding Version, StringFormat=Version: {0}}"/>
                                <TextBlock Margin="0,2,0,0" Text="{Binding ConfigPath}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConfigPath}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ConfigPath}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource FieldLabel}"
                                           Text="Commands"/>
                                <TextBlock Style="{StaticResource HintText}" Text="{Binding CommandsText}"/>

                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource FieldLabel}"
                                           Text="Detection markers"/>
                                <TextBlock Style="{StaticResource HintText}" Text="{Binding HostMarkersText}"/>
                                <TextBlock Style="{StaticResource HintText}" Text="{Binding ProjectMarkersText}"/>

                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource StatusLine}"
                                           Text="{Binding Message}"
                                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}"/>

                                <controls:SpacedPanel Margin="0,10,0,0"
                                                      Orientation="Horizontal"
                                                      Spacing="{StaticResource Sizing.Spacing}">
                                    <Button Command="{Binding DataContext.AgentsState.TestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Test"
                                            Style="{StaticResource NeutralButton}"/>
                                    <Button Command="{Binding DataContext.AgentsState.UpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Update"
                                            IsEnabled="{Binding CanUpdate}"
                                            Style="{StaticResource NeutralButton}"/>
                                    <Button Command="{Binding DataContext.AgentsState.EditConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Edit Config"
                                            IsEnabled="{Binding CanEditConfig}"
                                            Style="{StaticResource NeutralButton}"/>
                                </controls:SpacedPanel>
                                <TextBlock Margin="0,4,0,0" Text="{Binding UpdateNote}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateNote}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateNote}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <controls:SectionHeader Text="PROBE"/>
        <controls:SettingCard Title="Agents probe"
                           Hint="Empty — use defaults."
                           Icon="{x:Static themes:IconGlyphs.Diagnostic}"
                           Placement="Stacked">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="TTL"/>
                    <controls:NumericField Margin="0,6,0,0"
                                           MinWidth="110"
                                           Minimum="1"
                                           Placeholder="{Binding ProbeTtlWatermark}"
                                           Text="{Binding ProbeTtlText, UpdateSourceTrigger=PropertyChanged}"
                                           Unit="min"
                                           Width="{Binding ElementName=ProbeTimeoutLabel, Path=ActualWidth}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="ProbeTimeoutLabel" Style="{StaticResource FieldLabel}" Text="Timeout"/>
                    <controls:NumericField Margin="0,6,0,0"
                                           MinWidth="110"
                                           Minimum="1"
                                           Placeholder="{Binding ProbeTimeoutWatermark}"
                                           Text="{Binding ProbeTimeoutText, UpdateSourceTrigger=PropertyChanged}"
                                           Unit="sec"
                                           Width="{Binding ElementName=ProbeTimeoutLabel, Path=ActualWidth}"/>
                </StackPanel>
            </Grid>
        </controls:SettingCard>
    </StackPanel>
</UserControl>
