<UserControl x:Class="CLIHub.Views.SettingsAgentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CLIHub.Controls"
             xmlns:behaviors="clr-namespace:CLIHub.Behaviors"
             xmlns:themes="clr-namespace:CLIHub.Theming"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- State chip next to the agent name: version when installed, danger state when missing;
             outlined like the origin badge via OutlineChipBorder (transparent surface, muted border) -->
        <Style x:Key="AgentStateChip" TargetType="Border" BasedOn="{StaticResource OutlineChipBorder}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding InstallState}" Value="NotInstalled">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AgentStateChipText" TargetType="TextBlock" BasedOn="{StaticResource VersionChipText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding InstallState}" Value="NotInstalled">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InvalidAgentStateChip" TargetType="Border" BasedOn="{StaticResource VersionChipBorder}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        </Style>

        <Style x:Key="InvalidAgentStateChipText" TargetType="TextBlock" BasedOn="{StaticResource VersionChipText}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>

        <!-- Advisory update chip next to the state chip: accent-styled so it reads as
             informational rather than as an error; shown only when an update is available -->
        <Style x:Key="AgentUpdateChip" TargetType="Border" BasedOn="{StaticResource VersionChipBorder}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style x:Key="AgentUpdateChipText" TargetType="TextBlock" BasedOn="{StaticResource VersionChipText}">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- Origin badge next to the state chip: neutral-muted for built-in and unknown
             origins, accent for plugins installed from a package; the tooltip carries the
             descriptor's version, publisher, and homepage when declared -->
        <Style x:Key="AgentOriginChip" TargetType="Border" BasedOn="{StaticResource OutlineChipBorder}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Origin}" Value="installed">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AgentOriginChipText" TargetType="TextBlock" BasedOn="{StaticResource VersionChipText}">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Origin}" Value="installed">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Actions-menu item templates for the plugin catalog menu. They live here, not in the
            styles dictionary, because an entry wires the page's click handler, which only a view
            with code-behind can resolve. This menu has only plain command entries, so the
            switching template needs just the action and separator cases; each entry is rendered
            by a ContentControl that swaps template by kind.
        -->
        <DataTemplate x:Key="ActionsMenuActionTemplate">
            <Button Click="OnMenuActionInvoked"
                    Command="{Binding Command}"
                    Style="{StaticResource ActionsMenuEntryButton}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="16"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                               FontSize="{StaticResource Sizing.FontSize.GlyphSmall}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="{Binding Glyph}"/>
                    <TextBlock VerticalAlignment="Center" Text="{Binding Label}"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ActionsMenuSeparatorTemplate">
            <Rectangle Height="1" Margin="8,4" Fill="{DynamicResource RowDividerBrush}"/>
        </DataTemplate>

        <DataTemplate x:Key="ActionsMenuItemTemplate">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource ActionsMenuActionTemplate}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource ActionsMenuSeparatorTemplate}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <controls:SectionHeader Text="MANAGEMENT"/>
        <controls:SettingCard Title="Default agent"
                           Hint="Preselected in the launch window."
                           Icon="{x:Static themes:IconGlyphs.Robot}">
            <ComboBox HorizontalAlignment="Right"
                      ItemsSource="{Binding AgentsState.DefaultAgentOptions}"
                      SelectedItem="{Binding AgentsState.SelectedDefaultAgent, Mode=TwoWay}"
                      Style="{StaticResource SettingsComboBox}"
                      behaviors:ComboBoxBehaviors.AutoWidthToItems="True">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource SettingsComboBoxItem}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding InstallState}" Value="NotInstalled">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingCard>

        <Grid>
            <controls:SectionHeader Text="AGENTS"/>
            <controls:SpacedPanel Margin="0,18,0,8"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Orientation="Horizontal"
                                  Spacing="8">
                <!-- Muted result of the last manual update check; collapses when empty so it
                     never takes space next to the buttons -->
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource HintText}"
                           Text="{Binding AgentsState.UpdateCheckSummary}"
                           Visibility="{Binding AgentsState.UpdateCheckSummary, Converter={StaticResource EmptyToCollapsedVisibility}}"/>
                <Button AutomationProperties.Name="Recheck each agent and its version"
                        Command="{Binding AgentsState.DetectCommand}"
                        IsEnabled="{Binding AgentsState.CanDetect}"
                        Style="{StaticResource SectionHeaderChipButton}"
                        ToolTip="Recheck each agent and its version">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                   FontSize="{StaticResource Sizing.FontSize.GlyphTiny}"
                                   Text="{x:Static themes:IconGlyphs.Refresh}"/>
                        <TextBlock Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource Sizing.FontSize.Section}"
                                   Text="Detect"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="Check all installed agents for updates"
                        Command="{Binding AgentsState.CheckUpdatesCommand}"
                        IsEnabled="{Binding AgentsState.CanCheckUpdates}"
                        Style="{StaticResource SectionHeaderChipButton}"
                        ToolTip="Check all installed agents for updates">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                   FontSize="{StaticResource Sizing.FontSize.GlyphTiny}"
                                   Text="{x:Static themes:IconGlyphs.Sync}"/>
                        <TextBlock Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource Sizing.FontSize.Section}"
                                   Text="Check updates"/>
                    </StackPanel>
                </Button>
                <!-- The plugin-catalog actions (install, browse, open folder, reload) are grouped
                     in one data-driven Actions menu; Detect and Check updates act on agents and
                     stay standalone buttons to its left. -->
                <ToggleButton x:Name="PluginActionsButton"
                              Content="ACTIONS"
                              Style="{StaticResource PaneActionsToggle}"/>
            </controls:SpacedPanel>
            <!-- Hosted outside the SpacedPanel so the spacing pass does not add a trailing gap
                 after the toggle; like the launch window's pane headers, the popup lives in the
                 header Grid and positions itself against its target when open. -->
            <Popup x:Name="PluginActionsPopup"
                   AllowsTransparency="True"
                   IsOpen="{Binding IsChecked, ElementName=PluginActionsButton, Mode=TwoWay}"
                   Opened="OnActionsPopupOpened"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=PluginActionsButton}"
                   PopupAnimation="Fade"
                   StaysOpen="False"
                   VerticalOffset="-1">
                <Grid PreviewKeyDown="OnActionsMenuPreviewKeyDown">
                    <Border Style="{StaticResource ActionsPopover}">
                        <ItemsControl ItemTemplate="{StaticResource ActionsMenuItemTemplate}"
                                      ItemsSource="{Binding AgentsState.PluginActions}"/>
                    </Border>
                    <!-- Masks the popover's top border under the open Actions control, so the
                         control and the popover read as one panel with no seam. -->
                    <Rectangle Width="{Binding ActualWidth, ElementName=PluginActionsButton}"
                               Height="1"
                               HorizontalAlignment="Right"
                               Margin="1,0,1,0"
                               VerticalAlignment="Top"
                               Fill="{DynamicResource PopoverOpenBrush}"/>
                </Grid>
            </Popup>
        </Grid>
        <ItemsControl ItemsSource="{Binding AgentsState.Cards}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8"
                            Padding="12"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
                                   Width="32"
                                   Height="32"
                                   VerticalAlignment="Top"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{Binding LogoPath, Converter={StaticResource PathToImage}}"
                                   Stretch="Uniform"/>

                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="{StaticResource Sizing.FontSize.Body}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding Name}"/>
                                    <Border Margin="8,0,0,0"
                                            Style="{StaticResource AgentStateChip}">
                                        <TextBlock Style="{StaticResource AgentStateChipText}"
                                                   Text="{Binding VersionChipText}"/>
                                    </Border>
                                    <Border Margin="8,0,0,0"
                                            AutomationProperties.Name="Plugin origin"
                                            Style="{StaticResource AgentOriginChip}"
                                            ToolTip="{Binding OriginBadgeTooltip}">
                                        <TextBlock Style="{StaticResource AgentOriginChipText}"
                                                   Text="{Binding OriginBadgeText}"/>
                                    </Border>
                                    <Border Margin="8,0,0,0"
                                            AutomationProperties.Name="Update available"
                                            Style="{StaticResource AgentUpdateChip}"
                                            ToolTip="Newer version available"
                                            Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource AgentUpdateChipText}"
                                                   Text="{Binding UpdateAvailabilityText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,3,0,0"
                                           AutomationProperties.Name="Supported commands"
                                           Style="{StaticResource HintText}">
                                    <Run xml:space="preserve">Supported commands: </Run>
                                    <Run Text="{Binding CommandsText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                <controls:SpacedPanel HorizontalAlignment="Right"
                                                      Orientation="Horizontal"
                                                      Spacing="2">
                                    <Button Width="{StaticResource Sizing.IconButton.Width}"
                                            Height="{StaticResource Sizing.IconButton.Height}"
                                            AutomationProperties.Name="Detect agent"
                                            Command="{Binding DataContext.AgentsState.DetectCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanDetect}"
                                            Style="{StaticResource ChipRemoveButton}"
                                            ToolTip="Recheck this agent and its version">
                                        <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                                   FontSize="{StaticResource Sizing.FontSize.Glyph}"
                                                   Text="{x:Static themes:IconGlyphs.Refresh}"/>
                                    </Button>
                                    <Button Width="{StaticResource Sizing.IconButton.Width}"
                                            Height="{StaticResource Sizing.IconButton.Height}"
                                            AutomationProperties.Name="Check this agent for updates"
                                            Command="{Binding DataContext.AgentsState.CheckCardUpdatesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanCheckUpdates}"
                                            Style="{StaticResource ChipRemoveButton}"
                                            ToolTip="Check this agent for updates">
                                        <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                                   FontSize="{StaticResource Sizing.FontSize.Glyph}"
                                                   Text="{x:Static themes:IconGlyphs.Sync}"/>
                                    </Button>
                                    <Button Width="{StaticResource Sizing.IconButton.Width}"
                                            Height="{StaticResource Sizing.IconButton.Height}"
                                            AutomationProperties.Name="Update agent"
                                            Command="{Binding DataContext.AgentsState.UpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanUpdate}"
                                            Style="{StaticResource ChipRemoveButton}"
                                            ToolTip="Run this agent's update command">
                                        <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                                   FontSize="{StaticResource Sizing.FontSize.Glyph}"
                                                   Text="{x:Static themes:IconGlyphs.Update}"/>
                                    </Button>
                                    <Button Width="{StaticResource Sizing.IconButton.Width}"
                                            Height="{StaticResource Sizing.IconButton.Height}"
                                            AutomationProperties.Name="Edit agent config"
                                            Command="{Binding DataContext.AgentsState.EditConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanEditConfig}"
                                            Style="{StaticResource ChipRemoveButton}"
                                            ToolTip="Open this agent's plugin.json">
                                        <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                                   FontSize="{StaticResource Sizing.FontSize.Glyph}"
                                                   Text="{x:Static themes:IconGlyphs.Document}"/>
                                    </Button>
                                    <Button Width="{StaticResource Sizing.IconButton.Width}"
                                            Height="{StaticResource Sizing.IconButton.Height}"
                                            AutomationProperties.Name="Disable plugin"
                                            Command="{Binding DataContext.AgentsState.DisablePluginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ChipRemoveButton}"
                                            ToolTip="Disable this plugin without deleting its files">
                                        <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                                   FontSize="{StaticResource Sizing.FontSize.Glyph}"
                                                   Text="{x:Static themes:IconGlyphs.Blocked}"/>
                                    </Button>
                                </controls:SpacedPanel>
                                <TextBlock Margin="0,2,0,0"
                                           MaxWidth="{StaticResource Sizing.AgentRow.TextMaxWidth}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource StatusLine}"
                                           FontSize="{StaticResource Sizing.FontSize.Section}"
                                           Text="{Binding Message}"
                                           TextAlignment="Right"
                                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <controls:SectionHeader Text="DISABLED"
                                Visibility="{Binding AgentsState.HasDisabledPlugins, Converter={StaticResource BoolToVisibility}}"/>
        <ItemsControl ItemsSource="{Binding AgentsState.DisabledCards}"
                      Visibility="{Binding AgentsState.HasDisabledPlugins, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8"
                            Padding="12"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Card}"
                            Opacity="0.7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
                                   Width="32"
                                   Height="32"
                                   VerticalAlignment="Top"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{Binding LogoPath, Converter={StaticResource PathToImage}}"
                                   Stretch="Uniform"/>

                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="{StaticResource Sizing.FontSize.Body}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding Name}"/>
                                    <Border Margin="8,0,0,0"
                                            Style="{StaticResource InvalidAgentStateChip}">
                                        <TextBlock Style="{StaticResource InvalidAgentStateChipText}"
                                                   Text="{Binding VersionChipText}"/>
                                    </Border>
                                    <Border Margin="8,0,0,0"
                                            AutomationProperties.Name="Plugin origin"
                                            Style="{StaticResource AgentOriginChip}"
                                            ToolTip="{Binding OriginBadgeText}">
                                        <TextBlock Style="{StaticResource AgentOriginChipText}"
                                                   Text="{Binding OriginBadgeText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource HintText}"
                                           Text="Disabled"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                <Button Width="{StaticResource Sizing.IconButton.Width}"
                                        Height="{StaticResource Sizing.IconButton.Height}"
                                        AutomationProperties.Name="Enable plugin"
                                        Command="{Binding DataContext.AgentsState.EnablePluginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ChipRemoveButton}"
                                        ToolTip="Enable this plugin">
                                    <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                               FontSize="{StaticResource Sizing.FontSize.Glyph}"
                                               Text="{x:Static themes:IconGlyphs.Checkmark}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding AgentsState.InvalidCards}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8"
                            Padding="12"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Card}"
                            Opacity="0.6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center"
                                   Source="{Binding LogoPath, Converter={StaticResource PathToImage}}" Stretch="Uniform"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center" FontSize="{StaticResource Sizing.FontSize.Body}"
                                           FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding Name}"/>
                                <Border Margin="8,0,0,0" Style="{StaticResource InvalidAgentStateChip}">
                                    <TextBlock Style="{StaticResource InvalidAgentStateChipText}" Text="Invalid"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Style="{StaticResource HintText}" Text="{Binding Reason}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
