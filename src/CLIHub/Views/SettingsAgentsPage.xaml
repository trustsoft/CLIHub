<UserControl x:Class="CLIHub.Views.SettingsAgentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CLIHub.Controls"
             xmlns:behaviors="clr-namespace:CLIHub.Behaviors"
             xmlns:themes="clr-namespace:CLIHub.Themes"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- State chip next to the agent name: version when installed, danger state when missing;
             uses the footer version chip look -->
        <Style x:Key="AgentStateChip" TargetType="Border" BasedOn="{StaticResource VersionChipBorder}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AgentStateChipText" TargetType="TextBlock" BasedOn="{StaticResource VersionChipText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Ghost chip with the launcher footer behavior: hover/pressed overlays, dimmed when disabled -->
        <Style x:Key="AgentsHeaderChipButton" TargetType="Button" BasedOn="{StaticResource IconChipButton}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="{StaticResource Sizing.CornerRadius.Chip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <controls:SectionHeader Text="MANAGEMENT"/>
        <controls:SettingCard Title="Default agent"
                           Hint="Preselected when the launch window opens."
                           Icon="{x:Static themes:IconGlyphs.Robot}">
            <ComboBox HorizontalAlignment="Right"
                      ItemsSource="{Binding AgentsState.DefaultAgentOptions}"
                      SelectedItem="{Binding AgentsState.SelectedDefaultAgent, Mode=TwoWay}"
                      Style="{StaticResource SettingsComboBox}"
                      behaviors:ComboBoxBehaviors.AutoWidthToItems="True">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource SettingsComboBoxItem}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingCard>

        <Grid>
            <controls:SectionHeader Text="AGENTS"/>
            <Button Margin="0,18,0,8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Re-detect installed agents"
                    Command="{Binding AgentsState.DetectCommand}"
                    IsEnabled="{Binding AgentsState.CanDetect}"
                    Style="{StaticResource AgentsHeaderChipButton}"
                    ToolTip="Re-detect installed agents and refresh the lists">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                               FontSize="12"
                               Text="{x:Static themes:IconGlyphs.Refresh}"/>
                    <TextBlock Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource Sizing.FontSize.Section}"
                               Text="Refresh"/>
                </StackPanel>
            </Button>
        </Grid>
        <ItemsControl ItemsSource="{Binding AgentsState.Cards}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8"
                            Padding="12"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="32"
                                    Height="32"
                                    VerticalAlignment="Top"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding LogoPath, Converter={StaticResource PathToImage}}"
                                                Stretch="Uniform"/>
                                </Border.Background>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="{StaticResource Sizing.FontSize.Body}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding Name}"/>
                                    <Border Margin="8,0,0,0"
                                            Style="{StaticResource AgentStateChip}">
                                        <TextBlock Style="{StaticResource AgentStateChipText}"
                                                   Text="{Binding VersionChipText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,3,0,0"
                                           AutomationProperties.Name="Supported commands"
                                           Style="{StaticResource HintText}">
                                    <Run xml:space="preserve">Supported commands: </Run>
                                    <Run Text="{Binding CommandsText, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource StatusLine}"
                                           Text="{Binding Message}"
                                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>

                            <controls:SpacedPanel Grid.Column="2"
                                                  VerticalAlignment="Top"
                                                  Orientation="Horizontal"
                                                  Spacing="2">
                                <Button Width="{StaticResource Sizing.IconButton.Width}"
                                        Height="{StaticResource Sizing.IconButton.Height}"
                                        AutomationProperties.Name="Test agent"
                                        Command="{Binding DataContext.AgentsState.TestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ChipRemoveButton}"
                                        ToolTip="Probe installation and version">
                                    <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                               FontSize="16"
                                               Text="{x:Static themes:IconGlyphs.Diagnostic}"/>
                                </Button>
                                <Button Width="{StaticResource Sizing.IconButton.Width}"
                                        Height="{StaticResource Sizing.IconButton.Height}"
                                        AutomationProperties.Name="Update agent"
                                        Command="{Binding DataContext.AgentsState.UpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding CanUpdate}"
                                        Style="{StaticResource ChipRemoveButton}"
                                        ToolTip="Run the agent's update command">
                                    <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                               FontSize="16"
                                               Text="{x:Static themes:IconGlyphs.Update}"/>
                                </Button>
                                <Button Width="{StaticResource Sizing.IconButton.Width}"
                                        Height="{StaticResource Sizing.IconButton.Height}"
                                        AutomationProperties.Name="Edit agent config"
                                        Command="{Binding DataContext.AgentsState.EditConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding CanEditConfig}"
                                        Style="{StaticResource ChipRemoveButton}"
                                        ToolTip="Open the agent's plugin.json">
                                    <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                               FontSize="16"
                                               Text="{x:Static themes:IconGlyphs.Document}"/>
                                </Button>
                            </controls:SpacedPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <controls:SectionHeader Text="PROBE"/>
        <controls:SettingCard Title="Agents probe"
                           Hint="How long agent availability is cached and how long a single probe may take. Empty — use defaults."
                           Icon="{x:Static themes:IconGlyphs.Diagnostic}"
                           Placement="Stacked">
            <controls:SpacedPanel Orientation="Horizontal" Spacing="15">
                <controls:SpacedPanel Orientation="Vertical" Spacing="6">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="TTL"/>
                    <controls:NumericField MinWidth="110"
                                           Minimum="1"
                                           Placeholder="{Binding ProbeTtlWatermark}"
                                           Text="{Binding ProbeTtlText, UpdateSourceTrigger=PropertyChanged}"
                                           Unit="min"/>
                </controls:SpacedPanel>
                <controls:SpacedPanel Orientation="Vertical" Spacing="6">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Timeout"/>
                    <controls:NumericField MinWidth="110"
                                           Minimum="1"
                                           Placeholder="{Binding ProbeTimeoutWatermark}"
                                           Text="{Binding ProbeTimeoutText, UpdateSourceTrigger=PropertyChanged}"
                                           Unit="sec"/>
                </controls:SpacedPanel>
            </controls:SpacedPanel>
        </controls:SettingCard>
    </StackPanel>
</UserControl>
