<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:CLIHub.Converters">

    <!--
        Launch window styles. Merged from LaunchWindow.xaml (not from App.xaml) so that styling is
        scoped to this window and other windows keep their own look. Styles are keyed, because a
        ContextMenu lives outside the window's visual tree and cannot use implicit window styles.
        Merging Controls.xaml brings the palette and sizing tokens transitively: StaticResource
        inside a dictionary resolves only against that dictionary's own merged dictionaries.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/Controls.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <conv:IndexToDividerVisibilityConverter x:Key="IndexToDividerVisibility"/>

    <!-- Both panes: surface and header geometry -->
    <Style x:Key="PaneSurface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StripBgBrush}"/>
    </Style>

    <Style x:Key="PaneHeader" TargetType="Grid">
        <Setter Property="Height" Value="{StaticResource Sizing.PaneHeader.Height}"/>
        <Setter Property="Margin" Value="{StaticResource Sizing.PaneHeader.Margin}"/>
    </Style>

    <!-- Play glyph shared by the launch button and the resume ring -->
    <PathGeometry x:Key="PlayGlyph" Figures="M0,0 L0,8 L7,4 Z"/>

    <!-- Icons and separators inside the Actions menus -->
    <Style x:Key="MenuIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sizing.FontFamily.Icon}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    </Style>

    <!-- Footer icon glyphs (open data folder, settings, pin, exit) -->
    <Style x:Key="FooterIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sizing.FontFamily.Icon}"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="MenuSeparator" TargetType="Separator">
        <Setter Property="Margin" Value="4,4"/>
    </Style>

    <!-- Pane header "Actions" button: chrome appears on hover only -->
    <Style x:Key="PaneActionsButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource SectionLabelBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Section}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Height="20"
                            CornerRadius="5"
                            Padding="6,0,4,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Path Data="M5.5,8 L10,12.5 L14.5,8"
                                  Stroke="{StaticResource TextMutedBrush}"
                                  StrokeThickness="1.6"
                                  StrokeLineJoin="Round"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  Margin="4,1,0,0"
                                  VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChipStrokeBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark popover context menu -->
    <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
        <Setter Property="MinWidth" Value="180"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}"
                            Background="{StaticResource PopoverBgBrush}"
                            BorderBrush="{StaticResource FieldStrokeBrush}"
                            BorderThickness="1"
                            Padding="4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="12" Opacity="0.45"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource MenuItemBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd"
                            Height="30"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                            Padding="8,0"
                            Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="IconHost"
                                              Grid.Column="0"
                                              ContentSource="Icon"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1"
                                              ContentSource="Header"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSelectionBrush}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Footer icon button (open data folder / settings / exit) -->
    <Style x:Key="PopupIconButton" TargetType="Button" BasedOn="{StaticResource IconChipButton}">
        <Setter Property="Width" Value="{StaticResource Sizing.IconButton.Width}"/>
        <Setter Property="Height" Value="{StaticResource Sizing.IconButton.Height}"/>
    </Style>

    <!-- Footer pin toggle -->
    <Style x:Key="PopupToggleIconButton" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Width" Value="{StaticResource Sizing.IconButton.Width}"/>
        <Setter Property="Height" Value="{StaticResource Sizing.IconButton.Height}"/>
        <Setter Property="Foreground" Value="{StaticResource IconBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                            Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedOverlayBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Footer text button (update check) -->
    <Style x:Key="FooterTextButton" TargetType="Button" BasedOn="{StaticResource QuietChipButton}">
        <Setter Property="Foreground" Value="{StaticResource IconBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Section}"/>
        <Setter Property="Padding" Value="10,3"/>
    </Style>

    <!-- Agent row action button (launch / resume); disabled rows dim to the divider tone -->
    <Style x:Key="AgentActionButton" TargetType="Button" BasedOn="{StaticResource QuietChipButton}">
        <Setter Property="Width" Value="{StaticResource Sizing.ActionButton.Width}"/>
        <Setter Property="Height" Value="{StaticResource Sizing.ActionButton.Height}"/>
        <Setter Property="Foreground" Value="{StaticResource IconBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource RowDividerBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RowDividerBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Project row: accent bar on the selected row -->
    <Style x:Key="ProjectRowContainer" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="AccentBar"
                                   Width="3"
                                   Height="22"
                                   RadiusX="2"
                                   RadiusY="2"
                                   Fill="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="3,0,0,0"
                                   Visibility="Collapsed"/>
                        <Border x:Name="Bd"
                                CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}"
                                Background="Transparent"
                                Padding="{StaticResource Sizing.ProjectRow.Padding}">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSelectionBrush}"/>
                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Agent row: hairline divider between rows -->
    <Style x:Key="AgentRowContainer" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <StackPanel>
                        <Rectangle Height="1"
                                   Fill="{StaticResource RowDividerBrush}"
                                   Margin="10,0,12,0"
                                   Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToDividerVisibility}}"/>
                        <Border x:Name="Bd"
                                CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}"
                                Background="Transparent"
                                Padding="{StaticResource Sizing.AgentRow.Padding}">
                            <ContentPresenter/>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List defaults (the lists themselves are declared in the window) -->
    <Style x:Key="PaneList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="MaxHeight" Value="{StaticResource Sizing.PaneList.MaxHeight}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard"/>
    </Style>

</ResourceDictionary>
