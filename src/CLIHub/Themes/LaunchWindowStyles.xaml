<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:CLIHub.Converters">

    <!--
        Launch window styles. Merged from LaunchWindow.xaml (not from App.xaml) so that styling is
        scoped to this window and other windows keep their own look. Styles are keyed, because a
        ContextMenu lives outside the window's visual tree and cannot use implicit window styles.
        Merging Controls.xaml brings the palette and sizing tokens transitively: StaticResource
        inside a dictionary resolves only against that dictionary's own merged dictionaries.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/Controls.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <conv:IndexToDividerVisibilityConverter x:Key="IndexToDividerVisibility"/>

    <!-- Both panes: surface and header geometry -->
    <Style x:Key="PaneSurface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StripBgBrush}"/>
    </Style>

    <Style x:Key="PaneHeader" TargetType="Grid">
        <Setter Property="Height" Value="{StaticResource Sizing.PaneHeader.Height}"/>
        <Setter Property="Margin" Value="{StaticResource Sizing.PaneHeader.Margin}"/>
    </Style>

    <!-- Play glyph shared by the launch button and the resume ring -->
    <PathGeometry x:Key="PlayGlyph" Figures="M0,0 L0,8 L7,4 Z"/>

    <!-- Footer icon glyphs (open data folder, settings, pin, exit) -->
    <Style x:Key="FooterIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sizing.FontFamily.Icon}"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <!-- Icons and separators inside the Actions menus are data-driven: see ActionsPopover and the
         entry styles below, plus the item templates declared in the window. -->

    <!-- Actions menu popover card. A Popup (not a ContextMenu) hosts it, so the card lives in the
         window's own tree and these resources resolve without being keyed for a separate tree.
         The card sizes to its content. Its top-left and bottom corners are rounded; its top-right
         is square because it sits under the open Actions control, which supplies that corner. -->
    <Style x:Key="ActionsPopover" TargetType="Border">
        <Setter Property="MinWidth" Value="{StaticResource Sizing.ActionsMenu.MinWidth}"/>
        <Setter Property="CornerRadius" Value="8,0,8,8"/>
        <Setter Property="Background" Value="{StaticResource PopoverOpenBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ActionsBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <!-- Actions menu entry: a full-width pill that highlights on hover and dims when disabled -->
    <Style x:Key="ActionsMenuEntryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource MenuItemBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Height="30"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                            Padding="8,0"
                            Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Checkable entry (the availability filter toggle) -->
    <Style x:Key="ActionsMenuEntryToggle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource MenuItemBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Height="30"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                            Padding="8,0"
                            Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSelectionBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pane header "Actions" toggle: uppercase and SemiBold like the section label, in a slightly
         smaller size; chrome appears on hover and stays while its menu is open -->
    <Style x:Key="PaneActionsToggle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource SectionLabelBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Height="24"
                            CornerRadius="5"
                            Padding="7,0,5,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Path Data="M5.5,8 L10,12.5 L14.5,8"
                                  Stroke="{StaticResource TextMutedBrush}"
                                  StrokeThickness="1.6"
                                  StrokeLineJoin="Round"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  Margin="4,1,0,0"
                                  VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChipStrokeBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- Open: merge with the menu into one panel. The bottom edge is left
                                 open and the top corners squared, so the card's top edge continues
                                 the outline as a header divider. The extra bottom padding compensates
                                 the removed bottom border, so the label and chevron do not move. -->
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PopoverOpenBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ActionsBorderBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1,1,1,0"/>
                            <Setter TargetName="Bd" Property="Padding" Value="7,0,5,1"/>
                            <Setter TargetName="Bd" Property="CornerRadius" Value="5,5,0,0"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Footer icon button (open data folder / settings / exit) -->
    <Style x:Key="PopupIconButton" TargetType="Button" BasedOn="{StaticResource IconChipButton}">
        <Setter Property="Width" Value="{StaticResource Sizing.IconButton.Width}"/>
        <Setter Property="Height" Value="{StaticResource Sizing.IconButton.Height}"/>
    </Style>

    <!-- Footer pin toggle -->
    <Style x:Key="PopupToggleIconButton" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Width" Value="{StaticResource Sizing.IconButton.Width}"/>
        <Setter Property="Height" Value="{StaticResource Sizing.IconButton.Height}"/>
        <Setter Property="Foreground" Value="{StaticResource IconBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                            Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedOverlayBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Footer text button (update control): muted chip when idle, accent border and text
         while it offers the update or restart action -->
    <Style x:Key="FooterTextButton" TargetType="Button" BasedOn="{StaticResource QuietChipButton}">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Section}"/>
        <Setter Property="Padding" Value="10,2"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding UpdateControl.IsUpdateActionAvailable}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Agent row action button (launch / resume); disabled rows dim to the divider tone -->
    <Style x:Key="AgentActionButton" TargetType="Button" BasedOn="{StaticResource QuietChipButton}">
        <Setter Property="Width" Value="{StaticResource Sizing.ActionButton.Width}"/>
        <Setter Property="Height" Value="{StaticResource Sizing.ActionButton.Height}"/>
        <Setter Property="Foreground" Value="{StaticResource IconBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource RowDividerBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RowDividerBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Project row: selected rows get a soft accent fill -->
    <Style x:Key="ProjectRowContainer" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}"
                            Background="Transparent"
                            Padding="{StaticResource Sizing.ProjectRow.Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSelectionBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Agent row: hairline divider between rows -->
    <Style x:Key="AgentRowContainer" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <StackPanel>
                        <Rectangle Height="1"
                                   Fill="{StaticResource RowDividerBrush}"
                                   Margin="10,0,12,0"
                                   Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToDividerVisibility}}"/>
                        <Border x:Name="Bd"
                                CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}"
                                Background="Transparent"
                                Padding="{StaticResource Sizing.AgentRow.Padding}">
                            <ContentPresenter/>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List defaults (the lists themselves are declared in the window) -->
    <Style x:Key="PaneList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="MaxHeight" Value="{StaticResource Sizing.PaneList.MaxHeight}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard"/>
        <!--
            Own template: the default ListBox template hardcodes a 1px Border padding, which
            shaves the scroll viewport to 432px, while MaxHeight is tuned to exactly seven 62px
            rows (434px); that 2px deficit makes the item-based ScrollViewer report a scrollable
            overflow and show the scrollbar even though every row fits.
        -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                  Focusable="false"
                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <!--
                ScrollViewer for the pane lists: the scrollbar renders inside its own column at the
                list's right edge. The column exists only while the bar is displayed, so no space
                is reserved for a hidden bar and the rows reach the list's full width.
            -->
            <Style TargetType="ScrollViewer">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <!-- Takes the bar's width while it is displayed, collapses otherwise. -->
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                        Grid.Column="0"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                        Margin="{TemplateBinding Padding}"/>
                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           Grid.Column="1"
                                           Cursor="Arrow"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           Minimum="0"
                                           Orientation="Vertical"
                                           Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- While the bar is displayed the content keeps a 4px standoff from
                                     it; with the bar hidden the standoff collapses, so both panes'
                                     rows end the same 10px away from the pane's edge. -->
                                <Trigger SourceName="PART_VerticalScrollBar" Property="Visibility" Value="Visible">
                                    <Setter TargetName="PART_ScrollContentPresenter" Property="Margin" Value="0,0,4,0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
    </Style>

</ResourceDictionary>
