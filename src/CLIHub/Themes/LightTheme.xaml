<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light palette. Defines the same keys as DarkTheme.xaml (the dark palette) so the application
        can override the active palette at runtime for DynamicResource lookups. Merged on top of the
        base palette only when the effective theme is light.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="ChromeBgBrush" Color="#FFF3F3F5"/>
    <SolidColorBrush x:Key="StripBgBrush" Color="#0A000000"/>
    <SolidColorBrush x:Key="PopoverBgBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="PopoverOpenBrush" Color="#FFEDEDF0"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="#14000000"/>

    <!-- Strokes and overlays -->
    <SolidColorBrush x:Key="FieldStrokeBrush" Color="#22000000"/>
    <SolidColorBrush x:Key="ActionsBorderBrush" Color="#FFD0D0D6"/>
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#24000000"/>
    <SolidColorBrush x:Key="ChipBgBrush" Color="#0D000000"/>
    <SolidColorBrush x:Key="ChipStrokeBrush" Color="#16000000"/>
    <SolidColorBrush x:Key="ThumbBgBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="RowDividerBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="AccentSelectionBrush" Color="#1F4CC2FF"/>
    <SolidColorBrush x:Key="TopHighlightBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33000000"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1B1B1F"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF5F5F66"/>
    <SolidColorBrush x:Key="SectionLabelBrush" Color="#FF6B6B72"/>
    <SolidColorBrush x:Key="BrandBrush" Color="#FF4A4A50"/>
    <SolidColorBrush x:Key="IconBrush" Color="#FF2A2A2E"/>
    <SolidColorBrush x:Key="MenuItemBrush" Color="#FF1E1E22"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#FFA0A0A6"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4CC2FF"/>

    <!-- Status -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FFC0392B"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF107C41"/>
    <SolidColorBrush x:Key="SuccessSelectionBrush" Color="#1F107C41"/>

</ResourceDictionary>
