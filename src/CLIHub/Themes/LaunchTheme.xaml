<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Launch window palette. Brushes only: the palette is shared application-wide, while the
        launch window's styles live in LaunchWindowStyles.xaml so other windows keep their own look.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0E1116"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#14181E"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1A1F27"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#212733"/>
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#16232E"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#232A33"/>

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E6EAF0"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9AA4B2"/>
    <SolidColorBrush x:Key="DimmedTextBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#55606E"/>

    <!-- Accent and interaction -->
    <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#1E4A63"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#7DD3FC"/>

    <!-- Controls -->
    <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#1E242E"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#2A323F"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#161B22"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#39414D"/>

</ResourceDictionary>
