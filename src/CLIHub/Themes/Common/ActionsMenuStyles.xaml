<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shared Actions-menu styles: the popover card, the plain and checkable entry styles, and the
        header "Actions" toggle. Used by the launch-window panes and the Settings CLI Agents page
        header. Merged at application level from SettingsStyles.xaml (so Settings page UserControls
        reach the styles before they attach to a window tree) and from LaunchWindow.xaml (window
        scope). Merging Controls.xaml brings the sizing tokens transitively: StaticResource inside a
        dictionary resolves only against its own merged dictionaries. Palette brushes resolve from
        the application-level palette through DynamicResource.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/Common/Controls.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Actions menu popover card. A Popup (not a ContextMenu) hosts it, so the card lives in the
         window's own tree and these resources resolve without being keyed for a separate tree.
         The card sizes to its content. Its top-left and bottom corners are rounded; its top-right
         is square because it sits under the open Actions control, which supplies that corner. -->
    <Style x:Key="ActionsPopover" TargetType="Border">
        <Setter Property="MinWidth" Value="{StaticResource Sizing.ActionsMenu.MinWidth}"/>
        <Setter Property="CornerRadius" Value="8,0,8,8"/>
        <Setter Property="Background" Value="{DynamicResource PopoverOpenBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ActionsBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <!-- Actions menu entry: a full-width pill that highlights on hover and dims when disabled -->
    <Style x:Key="ActionsMenuEntryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuItemBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Hint}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Height="30"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                            Padding="8,0"
                            Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Checkable entry (the availability filter toggle) -->
    <Style x:Key="ActionsMenuEntryToggle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuItemBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Hint}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Height="30"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                            Padding="8,0"
                            Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header "Actions" toggle: SemiBold at the section-label and header-chip text size, so the
         label lines up with the adjacent chip buttons; on hover or press the label lifts from the
         muted section tone to the icon tone those chips use, and chrome appears on hover and stays
         while its menu is open -->
    <Style x:Key="PaneActionsToggle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource SectionLabelBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Section}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Height="24"
                            CornerRadius="5"
                            Padding="7,0,5,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Path Data="M5.5,8 L10,12.5 L14.5,8"
                                  Stroke="{DynamicResource TextMutedBrush}"
                                  StrokeThickness="1.6"
                                  StrokeLineJoin="Round"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  Margin="4,1,0,0"
                                  VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ChipStrokeBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- Open: merge with the menu into one panel. The bottom edge is left
                                 open and the top corners squared, so the card's top edge continues
                                 the outline as a header divider. The extra bottom padding compensates
                                 the removed bottom border, so the label and chevron do not move.
                                 The label keeps the chip tone while the menu is open, so the active
                                 control reads the same as it does on hover and press. -->
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PopoverOpenBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ActionsBorderBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1,1,1,0"/>
                            <Setter TargetName="Bd" Property="Padding" Value="7,0,5,1"/>
                            <Setter TargetName="Bd" Property="CornerRadius" Value="5,5,0,0"/>
                            <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
                        </Trigger>
                        <!-- Last, so a disabled control keeps the muted tone even while the mouse
                             pointer still rests over it. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
