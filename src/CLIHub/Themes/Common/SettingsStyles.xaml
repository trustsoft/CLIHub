<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CLIHub.Controls">
    <!--
        Settings window and page chrome: sidebar, footer, headers, and implicit styles for
        CLIHub.Controls custom types. Merged at application level because Settings pages are UserControls
        built before they attach to the window tree. This dictionary is the application-level entry point:
        it merges Controls.xaml (shared keyed bases), PickerData.xaml (preview + picker styles),
        SettingsControls.xaml (input/control templates), and ActionsMenuStyles.xaml (the shared
        Actions-menu styles), and each of those merges Sizing.xaml for its own token lookups.
    -->

    <ResourceDictionary.MergedDictionaries>
        <!--
            StaticResource inside a dictionary resolves only against this dictionary and its merges.
            Controls.xaml supplies the shared keyed bases this file builds on (QuietChipButton,
            VersionChipBorder, VersionChipText); PickerData.xaml brings the theme and accent picker
            keys, SettingsControls.xaml the input/control templates and the text styles (HintText). The
            two leaf dictionaries merge Sizing.xaml themselves because a loose dictionary cannot reach
            application-level siblings.
        -->
        <ResourceDictionary Source="/Themes/Common/Controls.xaml"/>
        <ResourceDictionary Source="/Themes/Common/PickerData.xaml"/>
        <ResourceDictionary Source="/Themes/Common/SettingsControls.xaml"/>
        <!-- Shared Actions-menu styles (popover, entries, header toggle), reused by the launch
             window and the CLI Agents page header. Merges Controls.xaml itself for its token
             lookups. -->
        <ResourceDictionary Source="/Themes/Common/ActionsMenuStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Footer buttons -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ChromeBgBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="{StaticResource Sizing.Button.FooterPadding}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource ThumbBgBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NeutralButton" TargetType="Button" BasedOn="{StaticResource QuietChipButton}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="Padding" Value="{StaticResource Sizing.Button.FooterPadding}"/>
    </Style>

    <!-- Icon-only chip button: same surface as NeutralButton, compact padding -->
    <Style x:Key="SettingsIconButton" TargetType="Button" BasedOn="{StaticResource NeutralButton}">
        <Setter Property="Padding" Value="9,7"/>
    </Style>

    <!-- Compact metadata chips used in the page header -->
    <Style x:Key="HeaderChip" TargetType="Border">
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Background" Value="{DynamicResource ThumbBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Sizing.CornerRadius.Chip}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HeaderChipLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Chip}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HeaderChipValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Chip}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Footer strip: brand + version chip on the left, Save/Cancel on the right -->
    <Style x:Key="FooterStrip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource StripBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="{StaticResource Sizing.Footer.VerticalPadding}"/>
    </Style>

    <!-- Sidebar navigation -->
    <Style x:Key="SidebarGroupLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Section}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Margin" Value="10,12,0,4"/>
    </Style>

    <Style x:Key="SidebarItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Margin="0,1"
                            Padding="10,7"
                            CornerRadius="5"
                            Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SidebarItem}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- Page header -->
    <Style x:Key="PageHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Name}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- Section header: uppercase muted label with an optional accent marker -->
    <Style TargetType="{x:Type controls:SectionHeader}">
        <Setter Property="Margin" Value="0,18,0,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SectionHeader}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Marker"
                                Width="3"
                                Height="12"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="2"/>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="{StaticResource Sizing.FontSize.Section}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{TemplateBinding Text}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowMarker" Value="False">
                            <Setter TargetName="Marker" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Setting card: leading icon + title + optional badge + hint, with the control inline -->
    <Style TargetType="{x:Type controls:SettingCard}">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingCard}">
                    <Border x:Name="Card"
                            Padding="12"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Header: icon block + title (+ badge) + hint -->
                            <Grid Grid.Row="0" Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="IconBox"
                                        Grid.Column="0"
                                        Width="28"
                                        Height="28"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource ThumbBgBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{TemplateBinding Icon}"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="{StaticResource Sizing.FontSize.Body}"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{TemplateBinding Title}"/>
                                        <Border x:Name="BadgeBox"
                                             Margin="8,0,0,0"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource VersionChipBorder}">
                                            <TextBlock x:Name="BadgeText"
                                                       Style="{StaticResource VersionChipText}"
                                                       FontWeight="SemiBold"
                                                       Text="{TemplateBinding Badge}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{StaticResource HintText}"
                                               Text="{TemplateBinding Hint}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Control -->
                            <ContentPresenter x:Name="ContentHost"
                                              Grid.Row="0"
                                              Grid.Column="1"
                                              Margin="16,0,0,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="">
                            <Setter TargetName="IconBox" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Badge" Value="">
                            <Setter TargetName="BadgeBox" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="BadgeTone" Value="Accent">
                            <Setter TargetName="BadgeBox" Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                            <Setter TargetName="BadgeBox" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="BadgeTone" Value="Success">
                            <Setter TargetName="BadgeBox" Property="Background" Value="{DynamicResource SuccessSelectionBrush}"/>
                            <Setter TargetName="BadgeBox" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        </Trigger>
                        <Trigger Property="Placement" Value="Stacked">
                            <Setter TargetName="ContentHost" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="ContentHost" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="ContentHost" Property="Grid.ColumnSpan" Value="2"/>
                            <Setter TargetName="ContentHost" Property="Margin" Value="0,12,0,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Trigger>
                        <Trigger Property="Grouped" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Card" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="Card" Property="CornerRadius" Value="0"/>
                            <Setter TargetName="Card" Property="Padding" Value="12,11"/>
                            <Setter Property="Margin" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Grouped settings: one bordered surface, hairline separators between rows -->
    <Style TargetType="{x:Type controls:SettingsGroup}">
        <Setter Property="AlternationCount" Value="1000000"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ContentControl">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ContentControl">
                                <Border x:Name="Separator"
                                        BorderBrush="{DynamicResource HairlineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                        <Setter TargetName="Separator" Property="BorderThickness" Value="0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingsGroup}">
                    <Border Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Page-header summary card: label, value, optional detail line, icon block, and an optional
        danger indicator made of two parts: a compact chip sitting inline with the value and a count
        badge overlaying the icon block's top-right corner. The icon always uses the primary text
        brush so it matches the value line and the palette. The value tones are applied by triggers
        on the templated parent, so the brushes stay palette-driven: Neutral (the default) is the
        primary text tone, and the badge is always danger. The label and value reserve the icon
        block's column, while the detail line spans both columns below the icon row, so its right
        edge is the card's right content edge. The value and the chip share a WrapPanel rather than
        a horizontal StackPanel so the value keeps its character-ellipsis trimming; a chip combined
        with a long value may wrap to the next line, which is acceptable.
    -->
    <Style TargetType="{x:Type controls:SummaryCard}">
        <!-- A card is a read-only metric, not an input: it must not take part in the tab order. -->
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SummaryCard}">
                    <Border Padding="9"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="{StaticResource Sizing.FontSize.Section}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{TemplateBinding Label}"/>
                                <!-- A WrapPanel, not a horizontal StackPanel: the panel must give
                                     the value a finite measure width or its trimming would stop. -->
                                <WrapPanel>
                                    <TextBlock x:Name="ValueText"
                                               Margin="0,2,0,0"
                                               FontSize="{StaticResource Sizing.FontSize.SummaryValue}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{TemplateBinding Value}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               ToolTip="{TemplateBinding ValueToolTip}"/>
                                    <Border x:Name="BadgeChip"
                                            Margin="8,3,0,0"
                                            Padding="5,1"
                                            VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource DangerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                                            ToolTip="{TemplateBinding BadgeTooltip}"
                                            Visibility="Collapsed">
                                        <TextBlock AutomationProperties.HelpText="{TemplateBinding BadgeTooltip}"
                                                   FontSize="{StaticResource Sizing.FontSize.Chip}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   Text="{TemplateBinding BadgeText}"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                            <Grid Grid.Column="1"
                                  Width="24"
                                  Height="24"
                                  VerticalAlignment="Top">
                                <Border Background="{DynamicResource ThumbBgBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Sizing.CornerRadius.IconBox}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{TemplateBinding Icon}"/>
                                </Border>
                                <Border x:Name="BadgeCountOverlay"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        MinWidth="18"
                                        Height="18"
                                        Margin="0,-7,-7,0"
                                        Padding="3,0"
                                        Background="{DynamicResource DangerBrush}"
                                        BorderBrush="{DynamicResource PopoverBgBrush}"
                                        BorderThickness="2"
                                        CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                                        Grid.ZIndex="1"
                                        ToolTip="{TemplateBinding BadgeTooltip}"
                                        Visibility="Collapsed">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource ChromeBgBrush}"
                                               Text="{TemplateBinding BadgeCount}"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1"
                                        Grid.ColumnSpan="2">
                                <TextBlock x:Name="DetailText"
                                           Margin="0,2,0,0"
                                           Style="{StaticResource HintText}"
                                           Text="{TemplateBinding Detail}"
                                           ToolTip="{TemplateBinding DetailToolTip}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Value tone: Neutral keeps the primary text tone set on the value above. -->
                        <Trigger Property="ValueTone" Value="Muted">
                            <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                        </Trigger>
                        <Trigger Property="ValueTone" Value="Accent">
                            <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="ValueTone" Value="Success">
                            <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        </Trigger>
                        <Trigger Property="ValueTone" Value="Danger">
                            <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                        </Trigger>

                        <!-- The detail line drops out while it has no text. -->
                        <Trigger Property="Detail" Value="{x:Null}">
                            <Setter TargetName="DetailText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Detail" Value="">
                            <Setter TargetName="DetailText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- The badges need both the flag and non-empty text; the last four
                             triggers win, so null/empty always collapses regardless of the flag. -->
                        <Trigger Property="IsBadgeVisible" Value="True">
                            <Setter TargetName="BadgeChip" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="BadgeCountOverlay" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="BadgeText" Value="{x:Null}">
                            <Setter TargetName="BadgeChip" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="BadgeText" Value="">
                            <Setter TargetName="BadgeChip" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="BadgeCount" Value="{x:Null}">
                            <Setter TargetName="BadgeCountOverlay" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="BadgeCount" Value="">
                            <Setter TargetName="BadgeCountOverlay" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost chip with the launcher footer behavior: hover/pressed overlays, dimmed when disabled -->
    <Style x:Key="SectionHeaderChipButton" TargetType="Button" BasedOn="{StaticResource IconChipButton}">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
