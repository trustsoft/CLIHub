<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:CLIHub.Converters">

    <!--
        Launch window styles. Merged from LaunchWindow.xaml (not from App.xaml) so that styling is
        window-scoped and other windows keep their own look. Styles are keyed, because a ContextMenu
        lives outside the window's visual tree and cannot use implicit window styles. Merging
        Controls.xaml brings the sizing tokens transitively: StaticResource inside a dictionary
        resolves only against that dictionary's own merged dictionaries. Palette brushes resolve
        from the application-level palette through DynamicResource.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/Common/Controls.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <conv:IndexToDividerVisibilityConverter x:Key="IndexToDividerVisibility"/>

    <!-- Both panes: surface and header geometry -->
    <Style x:Key="PaneSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource StripBgBrush}"/>
    </Style>

    <Style x:Key="PaneHeader" TargetType="Grid">
        <Setter Property="Height" Value="{StaticResource Sizing.PaneHeader.Height}"/>
        <Setter Property="Margin" Value="{StaticResource Sizing.PaneHeader.Margin}"/>
    </Style>

    <!-- Play glyph shared by the launch button and the resume ring -->
    <PathGeometry x:Key="PlayGlyph" Figures="M0,0 L0,8 L7,4 Z"/>

    <!-- Footer icon glyphs (open data folder, settings, pin, exit) -->
    <Style x:Key="FooterIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sizing.FontFamily.Icon}"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <!-- Icons and separators inside the Actions menus are data-driven: the shared ActionsPopover,
         entry, and header-toggle styles live in ActionsMenuStyles.xaml (merged at application
         level from SettingsStyles.xaml and from LaunchWindow.xaml), together with the item
         templates declared in each view that shows a menu. -->

    <!-- Footer icon button (open data folder / settings / exit) -->
    <Style x:Key="PopupIconButton" TargetType="Button" BasedOn="{StaticResource IconChipButton}">
        <Setter Property="Width" Value="{StaticResource Sizing.IconButton.Width}"/>
        <Setter Property="Height" Value="{StaticResource Sizing.IconButton.Height}"/>
    </Style>

    <!-- Footer pin toggle -->
    <Style x:Key="PopupToggleIconButton" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Width" Value="{StaticResource Sizing.IconButton.Width}"/>
        <Setter Property="Height" Value="{StaticResource Sizing.IconButton.Height}"/>
        <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                            Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Footer text button (update control): muted chip when idle, accent border and text
         while it offers the update or restart action -->
    <Style x:Key="FooterTextButton" TargetType="Button" BasedOn="{StaticResource QuietChipButton}">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Section}"/>
        <Setter Property="Padding" Value="10,2"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding UpdateControl.IsUpdateActionAvailable}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Agent row action button (launch / resume); disabled rows dim to the divider tone -->
    <Style x:Key="AgentActionButton" TargetType="Button" BasedOn="{StaticResource QuietChipButton}">
        <Setter Property="Width" Value="{StaticResource Sizing.ActionButton.Width}"/>
        <Setter Property="Height" Value="{StaticResource Sizing.ActionButton.Height}"/>
        <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource RowDividerBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource RowDividerBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Project row: selected rows get a soft accent fill -->
    <Style x:Key="ProjectRowContainer" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Card}"
                            Background="Transparent"
                            Padding="{StaticResource Sizing.ProjectRow.Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Agent row: hairline divider between rows -->
    <Style x:Key="AgentRowContainer" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <StackPanel>
                        <Rectangle Height="1"
                                   Fill="{DynamicResource RowDividerBrush}"
                                   Margin="12,0,12,0"
                                   Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToDividerVisibility}}"/>
                        <Border x:Name="Bd"
                                CornerRadius="{StaticResource Sizing.CornerRadius.Card}"
                                Background="Transparent"
                                Padding="{StaticResource Sizing.AgentRow.Padding}">
                            <ContentPresenter/>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List defaults (the lists themselves are declared in the window) -->
    <Style x:Key="PaneList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="MaxHeight" Value="{StaticResource Sizing.PaneList.MaxHeight}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard"/>
        <!--
            Own template: the default ListBox template hardcodes a 1px Border padding, which
            shaves the scroll viewport to 432px, while MaxHeight is tuned to exactly seven 62px
            rows (434px); that 2px deficit makes the item-based ScrollViewer report a scrollable
            overflow and show the scrollbar even though every row fits.
        -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                  Focusable="false"
                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <!--
                ScrollViewer for the pane lists: the scrollbar renders inside its own column at the
                list's right edge. The column exists only while the bar is displayed, so no space
                is reserved for a hidden bar and the rows reach the list's full width.
            -->
            <Style TargetType="ScrollViewer">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <!-- Takes the bar's width while it is displayed, collapses otherwise. -->
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                        Grid.Column="0"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                        Margin="{TemplateBinding Padding}"/>
                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           Grid.Column="1"
                                           Cursor="Arrow"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           Minimum="0"
                                           Orientation="Vertical"
                                           Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- While the bar is displayed the content keeps a 4px standoff from
                                     it; with the bar hidden the standoff collapses. It is added on
                                     top of the row's 12 DIP trailing padding, so both panes' rows
                                     end 16 DIP from the list edge while the bar is visible. -->
                                <Trigger SourceName="PART_VerticalScrollBar" Property="Visibility" Value="Visible">
                                    <Setter TargetName="PART_ScrollContentPresenter" Property="Margin" Value="0,0,4,0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
    </Style>

</ResourceDictionary>
