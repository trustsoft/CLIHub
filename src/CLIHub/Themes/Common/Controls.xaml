<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CLIHub.Controls">

    <!--
        Shared styles: typography and control templates used by more than one window. Palette brushes
        are referenced with DynamicResource and resolve from the application-level palette, so this
        dictionary merges only the structural sizing tokens. Styles are keyed so windows keep their
        own look — the one exception is the implicit BusyMarker custom-control style, which must sit
        at application level to reach both of its hosts (Settings pages and the launch window).
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/Common/Sizing.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        Typography
    -->

    <!-- Pane header: section label -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Section}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SectionLabelBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Drawn window header: the title a chromeless window does not get from the OS -->
    <Style x:Key="WindowTitle" TargetType="TextBlock">
        <Setter Property="Margin" Value="14,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- Brand and version chip -->
    <Style x:Key="BrandText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="VersionChipBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Sizing.CornerRadius.Chip}"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Background" Value="{DynamicResource ChipBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ChipStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="VersionChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Chip}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <Style x:Key="OutlineChipBorder" TargetType="Border" BasedOn="{StaticResource VersionChipBorder}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <!-- Project row provenance mark: the compact "M"/"D" source indicator shared by the Settings
         Projects page and the launch window project list. Both marks use TextMutedBrush; the
         character is the only distinction between manual and discovered projects. -->
    <Style x:Key="ProjectProvenanceMark" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Section}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <!--
        Drawn chrome
    -->

    <!-- Header strip of a drawn-chrome window: drag area behind the title and close button -->
    <Style x:Key="WindowHeader" TargetType="Grid">
        <Setter Property="Height" Value="{StaticResource Sizing.WindowHeader.Height}"/>
        <Setter Property="Background" Value="{DynamicResource StripBgBrush}"/>
    </Style>

    <!--
        Dark popover tooltip: the little sibling of the actions popover. Keyed here as the base for
        the application-level implicit ToolTip style in App.xaml — tooltips live outside the
        window visual tree, so only an application-level implicit style reaches them.
    -->
    <Style x:Key="DarkToolTip" TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border CornerRadius="{StaticResource Sizing.CornerRadius.Card}"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            Padding="10,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="5" Opacity="0.4"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Buttons
    -->

    <!--
        Icon button: a transparent chip whose chrome appears on hover only. The close buttons of
        the drawn-chrome windows and the launch window's footer icon buttons are built on it.
    -->
    <Style x:Key="IconChipButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                            Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close button of a drawn-chrome window: the counterpart of the OS close box -->
    <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource IconChipButton}">
        <Setter Property="Width" Value="{StaticResource Sizing.IconButton.Width}"/>
        <Setter Property="Height" Value="{StaticResource Sizing.IconButton.Height}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--
        Quiet chip button: chip-toned surface with a hairline stroke, hover brightens both.
        The template reads Background, BorderBrush and Padding off the button, so variants set
        them (and extra triggers) instead of redeclaring the template.
    -->
    <Style x:Key="QuietChipButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource ChipBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ChipStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Busy marker: implicit custom-control style for the braille busy glyph shared by the agent
        card state chip and the update control button. Application-level implicit is required
        because the marker renders in both a Settings page and the launch window. The glyph is
        decorative (the adjacent label carries the meaning) and the control's automation peer
        removes it from the automation tree, so screen readers never announce it or its per-frame
        changes. The slot collapses while the marker is not busy, so resolved labels keep today's
        layout. MinWidth holds the slot fixed while frames cycle. Tone triggers switch the glyph
        and its brush; the animation state itself is driven by the control's timer, which writes
        CurrentFrame.
    -->
    <Style TargetType="{x:Type controls:BusyMarker}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BusyMarker}">
                    <TextBlock x:Name="Glyph"
                               MinWidth="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Focusable="False"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{TemplateBinding CurrentFrame}"
                               TextAlignment="Center"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsBusy" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="MarkerTone" Value="Success">
                            <Setter TargetName="Glyph" Property="Text" Value="✓"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        </Trigger>
                        <Trigger Property="MarkerTone" Value="Failure">
                            <Setter TargetName="Glyph" Property="Text" Value="✗"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
