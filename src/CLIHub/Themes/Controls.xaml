<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shared styles: typography and control templates used by more than one window. Merged from
        the window style dictionaries, not from App.xaml: StaticResource inside a dictionary
        resolves only against that dictionary's own merged dictionaries, so every consumer merges
        its dependencies explicitly (palette and Sizing first, then this dictionary). All styles
        are keyed - nothing here is implicit, so windows keep their own look.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/LaunchTheme.xaml"/>
        <ResourceDictionary Source="/Themes/Sizing.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        Typography
    -->

    <!-- Pane header: section label -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Section}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource SectionLabelBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Drawn window header: the title a chromeless window does not get from the OS -->
    <Style x:Key="WindowTitle" TargetType="TextBlock">
        <Setter Property="Margin" Value="14,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- Brand and version chip -->
    <Style x:Key="BrandText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource BrandBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="VersionChipBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="Background" Value="{StaticResource ChipBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ChipStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="VersionChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Section}"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    </Style>

    <!--
        Drawn chrome
    -->

    <!-- Header strip of a drawn-chrome window: drag area behind the title and close button -->
    <Style x:Key="WindowHeader" TargetType="Grid">
        <Setter Property="Height" Value="{StaticResource Sizing.WindowHeader.Height}"/>
        <Setter Property="Background" Value="{StaticResource StripBgBrush}"/>
    </Style>

    <!--
        Dark popover tooltip: the little sibling of the actions popover. Keyed here as the base for
        the application-level implicit ToolTip style in App.xaml — tooltips live outside the
        window visual tree, so only an application-level implicit style reaches them.
    -->
    <Style x:Key="DarkToolTip" TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}"
                            Background="{StaticResource PopoverBgBrush}"
                            BorderBrush="{StaticResource FieldStrokeBrush}"
                            BorderThickness="1"
                            Padding="10,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="5" Opacity="0.4"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Buttons
    -->

    <!--
        Icon button: a transparent chip whose chrome appears on hover only. The close buttons of
        the drawn-chrome windows and the launch window's footer icon buttons are built on it.
    -->
    <Style x:Key="IconChipButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource IconBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                            Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close button of a drawn-chrome window: the counterpart of the OS close box -->
    <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource IconChipButton}">
        <Setter Property="Width" Value="{StaticResource Sizing.IconButton.Width}"/>
        <Setter Property="Height" Value="{StaticResource Sizing.IconButton.Height}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--
        Quiet chip button: chip-toned surface with a hairline stroke, hover brightens both.
        The template reads Background, BorderBrush and Padding off the button, so variants set
        them (and extra triggers) instead of redeclaring the template.
    -->
    <Style x:Key="QuietChipButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{StaticResource ChipBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ChipStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
