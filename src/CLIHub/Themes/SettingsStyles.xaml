<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="clr-namespace:CLIHub.Themes"
                    xmlns:views="clr-namespace:CLIHub.Views">

    <!--
        Settings window styles. Merged from SettingsWindow.xaml (not from App.xaml) so styling
        stays scoped to this window. Reuses the launch-window palette: the only dedicated tokens
        are structural (no new colors beyond the shared DangerBrush). Merging Controls.xaml brings
        the palette and sizing tokens transitively: StaticResource inside a dictionary resolves
        only against that dictionary's own merged dictionaries.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/Controls.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Section rhythm: uppercase muted label, optional hint under the fields -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Section}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="StatusLine" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Dark input field: rounded popover-toned box, accent border while capturing -->
    <Style x:Key="SettingsInput" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource PopoverBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FieldStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            <!-- Watermark: Tag holds the hint text, shown while the field is
                                 empty and unfocused (so the caret never overlaps it) -->
                            <TextBlock x:Name="Watermark"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       IsHitTestVisible="False"
                                       Text="{TemplateBinding Tag}"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hotkey capture field: a focusable chip host, not a text box -->
    <Style x:Key="HotkeyField" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopoverBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FieldStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Sizing.CornerRadius.Chip}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HotkeyChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThumbBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Sizing.CornerRadius.Chip}"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HotkeyChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- Checkbox: dark box, accent check -->
    <Style x:Key="SettingsCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <Border x:Name="Box"
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                CornerRadius="4"
                                Background="{DynamicResource ThumbBgBrush}"
                                BorderBrush="{DynamicResource ControlStrokeBrush}"
                                BorderThickness="1">
                            <TextBlock x:Name="Check"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="{x:Static themes:IconGlyphs.Checkmark}"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="9,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented selector: bordered group, accent-tinted selected segment -->
    <Style x:Key="SegmentItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Margin="0"
                            Padding="14,5"
                            CornerRadius="5"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentGroup" TargetType="ListBox">
        <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentItem}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FieldStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <!-- Padding 1 + item border 1 = the 2px vertical inset, matching the 2px
                         gap between neighbouring segments (border + zero margin + border). -->
                    <Border CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="1">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Projects & Paths: bordered multi-row list of editable string entries -->
    <Style x:Key="SettingsListItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsList" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource PopoverBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FieldStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsListItem}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="0,0,2,0"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dropdown: dark combo box matching the input surface -->
    <Style x:Key="SettingsComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="4">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource PopoverBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FieldStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItem}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      ClickMode="Press"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{DynamicResource PopoverBgBrush}"
                                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}">
                                        <TextBlock Margin="0,0,10,0"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{x:Static themes:IconGlyphs.ChevronDown}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="True">
                                            <Setter TargetName="Bd" Property="CornerRadius" Value="6,6,0,0"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="9,0,26,0"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup x:Name="Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Border x:Name="PopupBorder"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0"
                                    Background="{DynamicResource PopoverBgBrush}"
                                    BorderBrush="{DynamicResource FieldStrokeBrush}"
                                    BorderThickness="1,0,1,1"
                                    ClipToBounds="True"
                                    CornerRadius="0,0,6,6">
                                <ScrollViewer Margin="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="PopupBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Footer buttons -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ChromeBgBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource ThumbBgBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NeutralButton" TargetType="Button" BasedOn="{StaticResource QuietChipButton}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="Padding" Value="18,7"/>
    </Style>

    <!-- Icon-only chip button: same surface as NeutralButton, compact padding -->
    <Style x:Key="SettingsIconButton" TargetType="Button" BasedOn="{StaticResource NeutralButton}">
        <Setter Property="Padding" Value="9,7"/>
    </Style>

    <!-- Footer strip: brand + version chip on the left, Save/Cancel on the right -->
    <Style x:Key="FooterStrip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource StripBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="20,10"/>
    </Style>

    <!-- Sidebar navigation -->
    <Style x:Key="SidebarGroupLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Section}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Margin" Value="10,12,0,4"/>
    </Style>

    <Style x:Key="SidebarItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Margin="0,1"
                            Padding="10,7"
                            CornerRadius="5"
                            Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SidebarItem}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- Page header -->
    <Style x:Key="PageHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Name}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="EmptyStateText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Section header: uppercase muted label with an optional accent marker -->
    <Style TargetType="{x:Type views:SectionHeader}">
        <Setter Property="Margin" Value="0,18,0,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:SectionHeader}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Marker"
                                Width="3"
                                Height="12"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="2"/>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="{StaticResource Sizing.FontSize.Section}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{TemplateBinding Text}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowMarker" Value="False">
                            <Setter TargetName="Marker" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Setting card: leading icon + title + optional badge + hint, with the control inline -->
    <Style TargetType="{x:Type views:SettingCard}">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:SettingCard}">
                    <Border x:Name="Card"
                            Padding="12"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Header: icon block + title (+ badge) + hint -->
                            <Grid Grid.Row="0" Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="IconBox"
                                        Grid.Column="0"
                                        Width="28"
                                        Height="28"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource ThumbBgBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{TemplateBinding Icon}"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="{StaticResource Sizing.FontSize.Body}"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{TemplateBinding Title}"/>
                                        <Border x:Name="BadgeBox"
                                                Margin="8,0,0,0"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource ThumbBgBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <TextBlock x:Name="BadgeText"
                                                       FontSize="{StaticResource Sizing.FontSize.Section}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="{TemplateBinding Badge}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{StaticResource HintText}"
                                               Text="{TemplateBinding Hint}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Control -->
                            <ContentPresenter x:Name="ContentHost"
                                              Grid.Row="0"
                                              Grid.Column="1"
                                              Margin="16,0,0,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="">
                            <Setter TargetName="IconBox" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Badge" Value="">
                            <Setter TargetName="BadgeBox" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="BadgeTone" Value="Accent">
                            <Setter TargetName="BadgeBox" Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                            <Setter TargetName="BadgeBox" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="BadgeTone" Value="Success">
                            <Setter TargetName="BadgeBox" Property="Background" Value="{DynamicResource SuccessSelectionBrush}"/>
                            <Setter TargetName="BadgeBox" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        </Trigger>
                        <Trigger Property="Placement" Value="Stacked">
                            <Setter TargetName="ContentHost" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="ContentHost" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="ContentHost" Property="Grid.ColumnSpan" Value="2"/>
                            <Setter TargetName="ContentHost" Property="Margin" Value="0,12,0,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Trigger>
                        <Trigger Property="Grouped" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Card" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="Card" Property="CornerRadius" Value="0"/>
                            <Setter TargetName="Card" Property="Padding" Value="12,11"/>
                            <Setter Property="Margin" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Grouped settings: one bordered surface, hairline separators between rows -->
    <Style TargetType="{x:Type views:SettingsGroup}">
        <Setter Property="AlternationCount" Value="1000000"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ContentControl">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ContentControl">
                                <Border x:Name="Separator"
                                        BorderBrush="{DynamicResource HairlineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                        <Setter TargetName="Separator" Property="BorderThickness" Value="0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:SettingsGroup}">
                    <Border Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
