<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CLIHub.Controls">
    <!--
        Settings window and page chrome: theme picker preview data, footer buttons, sidebar navigation,
        page headers, and implicit styles for CLIHub.Controls custom types (SectionHeader, SettingCard,
        SettingsGroup). Merged at application level because Settings pages are UserControls built before
        they attach to the window tree.
    -->

    <ResourceDictionary.MergedDictionaries>
        <!--
            StaticResource inside a dictionary resolves only against this dictionary and its merges.
            SettingsControls.xaml brings Controls.xaml (button/chip bases) and its Sizing tokens.
        -->
        <ResourceDictionary Source="/Themes/SettingsControls.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Theme picker: preview cards in one equal-width row. The preview palette below is theme
         data, not application chrome: all four samples must read the same under either theme. -->
    <SolidColorBrush x:Key="ThemePreviewDarkBrush" Color="#FF0A0C14"/>
    <SolidColorBrush x:Key="ThemePreviewLightBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ThemePreviewBlueBrush" Color="#FF232833"/>
    <LinearGradientBrush x:Key="ThemePreviewSystemBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FF0A0C14"/>
        <GradientStop Offset="0.4" Color="#FF0A0C14"/>
        <GradientStop Offset="0.62" Color="#FF4B5160"/>
        <GradientStop Offset="0.78" Color="#FFE7E8EC"/>
        <GradientStop Offset="1" Color="#FFFFFFFF"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ThemePreviewDotMutedBrush" Color="#FF8B8F99"/>
    <SolidColorBrush x:Key="ThemePreviewBarDarkBrush" Color="#FF4B5160"/>
    <SolidColorBrush x:Key="ThemePreviewBarLightBrush" Color="#FFB6BAC4"/>
    <SolidColorBrush x:Key="ThemePreviewBarBlueBrush" Color="#FF3E4C66"/>

    <Style x:Key="ThemeOptionItem" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <!-- The group cancels this trailing gap with a matching negative margin, keeping the row
             flush with the setting card while neighbours stay 8px apart. -->
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Card"
                                Padding="10"
                                Background="{DynamicResource ChipBgBrush}"
                                BorderBrush="{DynamicResource FieldStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}">
                            <ContentPresenter/>
                        </Border>
                        <!-- Selection ring drawn over the card edge, so selecting never shifts content -->
                        <Border x:Name="SelectionRing"
                                Margin="-1"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemeOptionGroup" TargetType="ListBox">
        <Setter Property="ItemContainerStyle" Value="{StaticResource ThemeOptionItem}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent picker: compact swatch cards on the same chrome as the theme cards. Three columns
         keep the name and hex readable at the window's minimum width; the group cancels the last
         row's trailing margin so the custom field below stays close to the grid. -->
    <Style x:Key="AccentOptionItem" TargetType="ListBoxItem" BasedOn="{StaticResource ThemeOptionItem}">
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>

    <Style x:Key="AccentOptionGroup" TargetType="ListBox" BasedOn="{StaticResource ThemeOptionGroup}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource AccentOptionItem}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Footer buttons -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ChromeBgBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="{StaticResource Sizing.Button.FooterPadding}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource ThumbBgBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NeutralButton" TargetType="Button" BasedOn="{StaticResource QuietChipButton}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="Padding" Value="{StaticResource Sizing.Button.FooterPadding}"/>
    </Style>

    <!-- Icon-only chip button: same surface as NeutralButton, compact padding -->
    <Style x:Key="SettingsIconButton" TargetType="Button" BasedOn="{StaticResource NeutralButton}">
        <Setter Property="Padding" Value="9,7"/>
    </Style>

    <!-- Compact metadata chips used in the page header -->
    <Style x:Key="HeaderChip" TargetType="Border">
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Background" Value="{DynamicResource ThumbBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Sizing.CornerRadius.Chip}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HeaderChipLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Chip}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HeaderChipValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Chip}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Footer strip: brand + version chip on the left, Save/Cancel on the right -->
    <Style x:Key="FooterStrip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource StripBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="20,10"/>
    </Style>

    <!-- Sidebar navigation -->
    <Style x:Key="SidebarGroupLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Section}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Margin" Value="10,12,0,4"/>
    </Style>

    <Style x:Key="SidebarItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Margin="0,1"
                            Padding="10,7"
                            CornerRadius="5"
                            Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SidebarItem}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- Page header -->
    <Style x:Key="PageHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Name}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="EmptyStateText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Section header: uppercase muted label with an optional accent marker -->
    <Style TargetType="{x:Type controls:SectionHeader}">
        <Setter Property="Margin" Value="0,18,0,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SectionHeader}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Marker"
                                Width="3"
                                Height="12"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="2"/>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="{StaticResource Sizing.FontSize.Section}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{TemplateBinding Text}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowMarker" Value="False">
                            <Setter TargetName="Marker" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Setting card: leading icon + title + optional badge + hint, with the control inline -->
    <Style TargetType="{x:Type controls:SettingCard}">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingCard}">
                    <Border x:Name="Card"
                            Padding="12"
                            Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Header: icon block + title (+ badge) + hint -->
                            <Grid Grid.Row="0" Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="IconBox"
                                        Grid.Column="0"
                                        Width="28"
                                        Height="28"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource ThumbBgBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource Sizing.FontFamily.Icon}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{TemplateBinding Icon}"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="{StaticResource Sizing.FontSize.Body}"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{TemplateBinding Title}"/>
                                        <Border x:Name="BadgeBox"
                                             Margin="8,0,0,0"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource VersionChipBorder}">
                                            <TextBlock x:Name="BadgeText"
                                                       Style="{StaticResource VersionChipText}"
                                                       FontWeight="SemiBold"
                                                       Text="{TemplateBinding Badge}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{StaticResource HintText}"
                                               Text="{TemplateBinding Hint}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Control -->
                            <ContentPresenter x:Name="ContentHost"
                                              Grid.Row="0"
                                              Grid.Column="1"
                                              Margin="16,0,0,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="">
                            <Setter TargetName="IconBox" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Badge" Value="">
                            <Setter TargetName="BadgeBox" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="BadgeTone" Value="Accent">
                            <Setter TargetName="BadgeBox" Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                            <Setter TargetName="BadgeBox" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="BadgeTone" Value="Success">
                            <Setter TargetName="BadgeBox" Property="Background" Value="{DynamicResource SuccessSelectionBrush}"/>
                            <Setter TargetName="BadgeBox" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        </Trigger>
                        <Trigger Property="Placement" Value="Stacked">
                            <Setter TargetName="ContentHost" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="ContentHost" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="ContentHost" Property="Grid.ColumnSpan" Value="2"/>
                            <Setter TargetName="ContentHost" Property="Margin" Value="0,12,0,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Trigger>
                        <Trigger Property="Grouped" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Card" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="Card" Property="CornerRadius" Value="0"/>
                            <Setter TargetName="Card" Property="Padding" Value="12,11"/>
                            <Setter Property="Margin" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Grouped settings: one bordered surface, hairline separators between rows -->
    <Style TargetType="{x:Type controls:SettingsGroup}">
        <Setter Property="AlternationCount" Value="1000000"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ContentControl">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ContentControl">
                                <Border x:Name="Separator"
                                        BorderBrush="{DynamicResource HairlineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                        <Setter TargetName="Separator" Property="BorderThickness" Value="0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingsGroup}">
                    <Border Background="{DynamicResource PopoverBgBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            CornerRadius="{StaticResource Sizing.CornerRadius.Chip}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
