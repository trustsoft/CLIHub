<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Theme and accent picker data: the preview swatch palette and the option styles used by the
        Appearance page. Merged by SettingsStyles.xaml only — never by App.xaml directly — so the keys
        are reachable from Settings pages (UserControls built before they attach to the window tree)
        through that merge chain.
    -->

    <ResourceDictionary.MergedDictionaries>
        <!--
            StaticResource inside a dictionary resolves only against this dictionary and its merges.
            The picker styles use only Sizing tokens, so this dictionary merges the tokens directly
            instead of Controls.xaml — otherwise the shared styles would be loaded a second time.
        -->
        <ResourceDictionary Source="/Themes/Sizing.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Theme picker: preview cards in one equal-width row. The preview palette below is theme
         data, not application chrome: all four samples must read the same under either theme. -->
    <SolidColorBrush x:Key="ThemePreviewDarkBrush" Color="#FF0A0C14"/>
    <SolidColorBrush x:Key="ThemePreviewLightBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ThemePreviewBlueBrush" Color="#FF232833"/>
    <LinearGradientBrush x:Key="ThemePreviewSystemBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FF0A0C14"/>
        <GradientStop Offset="0.4" Color="#FF0A0C14"/>
        <GradientStop Offset="0.62" Color="#FF4B5160"/>
        <GradientStop Offset="0.78" Color="#FFE7E8EC"/>
        <GradientStop Offset="1" Color="#FFFFFFFF"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ThemePreviewDotMutedBrush" Color="#FF8B8F99"/>
    <SolidColorBrush x:Key="ThemePreviewBarDarkBrush" Color="#FF4B5160"/>
    <SolidColorBrush x:Key="ThemePreviewBarLightBrush" Color="#FFB6BAC4"/>
    <SolidColorBrush x:Key="ThemePreviewBarBlueBrush" Color="#FF3E4C66"/>

    <Style x:Key="ThemeOptionItem" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <!-- The group cancels this trailing gap with a matching negative margin, keeping the row
             flush with the setting card while neighbours stay 8px apart. -->
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Card"
                                Padding="10"
                                Background="{DynamicResource ChipBgBrush}"
                                BorderBrush="{DynamicResource FieldStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Sizing.CornerRadius.Card}">
                            <ContentPresenter/>
                        </Border>
                        <!-- Selection ring drawn over the card edge, so selecting never shifts content -->
                        <Border x:Name="SelectionRing"
                                Margin="-1"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Sizing.CornerRadius.Card}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemeOptionGroup" TargetType="ListBox">
        <Setter Property="ItemContainerStyle" Value="{StaticResource ThemeOptionItem}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent picker: compact swatch cards on the same chrome as the theme cards. Three columns
         keep the name and hex readable at the window's minimum width; the group cancels the last
         row's trailing margin so the custom field below stays close to the grid. -->
    <Style x:Key="AccentOptionItem" TargetType="ListBoxItem" BasedOn="{StaticResource ThemeOptionItem}">
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>

    <Style x:Key="AccentOptionGroup" TargetType="ListBox" BasedOn="{StaticResource ThemeOptionGroup}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource AccentOptionItem}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
