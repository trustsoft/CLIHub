<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark tooltip style, shared by the dark-chrome windows (launch window, What's New). Merged
        from their window style dictionaries so the look stays scoped to those windows; tooltips
        are applied explicitly per control, like the dark context menus.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/LaunchTheme.xaml"/>
        <ResourceDictionary Source="/Themes/Sizing.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Dark popover tooltip: the little sibling of DarkContextMenu -->
    <Style x:Key="DarkToolTip" TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource Sizing.FontSize.Body}"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border CornerRadius="{StaticResource Sizing.CornerRadius.Chunky}"
                            Background="{StaticResource PopoverBgBrush}"
                            BorderBrush="{StaticResource FieldStrokeBrush}"
                            BorderThickness="1"
                            Padding="10,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="5" Opacity="0.4"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
