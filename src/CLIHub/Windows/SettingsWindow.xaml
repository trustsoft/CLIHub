<Window x:Class="CLIHub.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:themes="clr-namespace:CLIHub.Themes"
        mc:Ignorable="d"
        Title="Settings"
        Background="{StaticResource ChromeBgBrush}"
        FontFamily="{StaticResource Sizing.FontFamily.Text}"
        Height="480" Width="420"
        MinHeight="480" MinWidth="420"
        KeyDown="OnKeyDown"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        SourceInitialized="OnSourceInitialized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Window-scoped styles: this window's dark form styling. -->
        <ResourceDictionary Source="/Themes/SettingsStyles.xaml"/>
    </Window.Resources>

    <Border BorderBrush="{StaticResource FieldStrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Inset top highlight (shared chrome) -->
            <Rectangle Grid.Row="0" Height="1" Fill="{StaticResource TopHighlightBrush}"/>

            <!-- Drawn header: title, close button, drag -->
            <Grid Grid.Row="1"
                  MouseLeftButtonDown="OnHeaderMouseDown"
                  Style="{StaticResource WindowHeader}">
                <TextBlock Style="{StaticResource WindowTitle}" Text="Settings"/>
                <Button HorizontalAlignment="Right"
                        Click="OnCloseClick"
                        Style="{StaticResource WindowCloseButton}"
                        ToolTip="Close">
                    <TextBlock FontFamily="{StaticResource Sizing.FontFamily.Icon}" FontSize="14" Text="{x:Static themes:IconGlyphs.Close}"/>
                </Button>
            </Grid>

            <Rectangle Grid.Row="1"
                       Height="1"
                       VerticalAlignment="Bottom"
                       Fill="{StaticResource HairlineBrush}"/>

            <!-- Sections -->
            <ScrollViewer Grid.Row="2"
                          Padding="20,6,20,16"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Margin="0,14,0,8" Style="{StaticResource SectionLabel}" Text="STARTUP"/>
                    <CheckBox HorizontalAlignment="Left"
                              Content="Start with Windows"
                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                              Style="{StaticResource SettingsCheck}"/>
                    <CheckBox HorizontalAlignment="Left"
                              Margin="0,8,0,0"
                              Content="Show window on startup"
                              IsChecked="{Binding ShowWindowOnStartup, Mode=TwoWay}"
                              Style="{StaticResource SettingsCheck}"/>

                    <TextBlock Margin="0,24,0,8" Style="{StaticResource SectionLabel}" Text="DEFAULT RUNTIME"/>
                    <ListBox HorizontalAlignment="Left"
                             ItemsSource="{Binding Runtimes}"
                             SelectedItem="{Binding SelectedRuntime, Mode=TwoWay}"
                             Style="{StaticResource SegmentGroup}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Segment}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource HintText}"
                               Text="Runtime used to open interactive agent commands."/>

                    <TextBlock Margin="0,24,0,8" Style="{StaticResource SectionLabel}" Text="APPEARANCE"/>
                    <ListBox HorizontalAlignment="Left"
                             ItemsSource="{Binding PathDisplays}"
                             SelectedItem="{Binding SelectedPathDisplay, Mode=TwoWay}"
                             Style="{StaticResource SegmentGroup}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Segment}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource HintText}"
                               Text="How long project paths are shortened in the launch window."/>

                    <TextBlock Margin="0,24,0,8" Style="{StaticResource SectionLabel}" Text="GLOBAL HOTKEY"/>
                    <Border x:Name="HotkeyField"
                            HorizontalAlignment="Left"
                            PreviewKeyDown="HotkeyField_PreviewKeyDown"
                            Style="{StaticResource HotkeyField}">
                        <StackPanel Orientation="Horizontal">
                            <!-- -6 cancels the last chip's trailing margin, so the left and right
                                 insets of the field stay equal -->
                            <ItemsControl Margin="0,0,-6,0" ItemsSource="{Binding HotkeyParts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource HotkeyChip}">
                                            <TextBlock Style="{StaticResource HotkeyChipText}" Text="{Binding}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle Width="1.5"
                                       Height="18"
                                       Fill="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsKeyboardFocusWithin, ElementName=HotkeyField, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource HintText}"
                               Text="Press a combination in the field. Esc cancels capture."/>

                    <TextBlock Margin="0,24,0,8" Style="{StaticResource SectionLabel}" Text="AGENTS PROBE"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="TTL, minutes"/>
                            <TextBox Margin="0,6,0,0"
                                     Style="{StaticResource SettingsInput}"
                                     Text="{Binding ProbeTtlText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="{Binding ElementName=ProbeTimeoutLabel, Path=ActualWidth}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ProbeTimeoutLabel" Style="{StaticResource FieldLabel}" Text="Timeout, seconds"/>
                            <TextBox Margin="0,6,0,0"
                                     Style="{StaticResource SettingsInput}"
                                     Text="{Binding ProbeTimeoutText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="{Binding ElementName=ProbeTimeoutLabel, Path=ActualWidth}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource HintText}"
                               Text="Empty — use defaults."/>

                    <TextBlock Margin="0,24,0,8" Style="{StaticResource SectionLabel}" Text="UPDATES"/>
                    <CheckBox HorizontalAlignment="Left"
                              Content="Check for updates on startup"
                              IsChecked="{Binding CheckForUpdatesOnStartup, Mode=TwoWay}"
                              Style="{StaticResource SettingsCheck}"/>
                    <Button Margin="0,12,0,0"
                            Command="{Binding CheckForUpdatesCommand}"
                            Content="Check for updates"
                            HorizontalAlignment="Left"
                            Style="{StaticResource NeutralButton}"/>
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource StatusLine}"
                               Text="{Binding UpdateMessage}"/>

                    <TextBlock Margin="0,12,0,0"
                               Style="{StaticResource ErrorText}"
                               Text="{Binding ValidationError}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer: brand + version chip, Save/Cancel -->
            <Border Grid.Row="3" Style="{StaticResource FooterStrip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BrandText}" Text="CLIHub"/>
                        <Border Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource VersionChipBorder}">
                            <TextBlock Style="{StaticResource VersionChipText}" Text="{Binding Version}"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding SaveCommand}"
                            Content="Save"
                            IsDefault="True"
                            Margin="0,0,10,0"
                            Style="{StaticResource AccentButton}"/>
                    <Button Grid.Column="2"
                            Command="{Binding CancelCommand}"
                            Content="Cancel"
                            Style="{StaticResource NeutralButton}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
