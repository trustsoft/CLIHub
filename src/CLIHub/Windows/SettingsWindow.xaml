<Window x:Class="CLIHub.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CLIHub.Windows"
        mc:Ignorable="d"
        Title="Settings"
        Height="560" Width="460"
        MinHeight="480" MinWidth="420"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20,10">
            <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- Sections -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,15">
            <StackPanel>

                <TextBlock Text="STARTUP" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D"/>
                <CheckBox Margin="0,6,0,0"
                          Content="Start with Windows"
                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>
                <CheckBox Margin="0,6,0,0"
                          Content="Show window on startup"
                          IsChecked="{Binding ShowWindowOnStartup, Mode=TwoWay}"/>

                <TextBlock Text="DEFAULT RUNTIME" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,20,0,0"/>
                <ComboBox x:Name="RuntimeBox"
                          Margin="0,6,0,0"
                          Width="260"
                          HorizontalAlignment="Left"
                          ItemsSource="{Binding Runtimes}"
                          SelectedItem="{Binding SelectedRuntime, Mode=TwoWay}"
                          DisplayMemberPath="Name"/>
                <TextBlock Text="Runtime used to open interactive agent commands."
                           FontSize="11" Foreground="Gray" Margin="0,4,0,0"/>

                <TextBlock Text="GLOBAL HOTKEY" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,20,0,0"/>
                <TextBox x:Name="HotkeyBox"
                         Margin="0,6,0,0"
                         Width="260"
                         HorizontalAlignment="Left"
                         Padding="6,4"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="False"
                         Text="{Binding HotkeyText, Mode=OneWay}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                <TextBlock Text="Press a combination in the field. Esc cancels capture."
                           FontSize="11" Foreground="Gray" Margin="0,4,0,0"/>

                <TextBlock Text="AGENTS PROBE" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,20,0,0"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="TTL, minutes" FontSize="12" Foreground="#2C3E50"/>
                        <TextBox Margin="0,4,0,0" Width="120" Padding="6,4"
                                 Text="{Binding ProbeTtlText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Timeout, seconds" FontSize="12" Foreground="#2C3E50"/>
                        <TextBox Margin="0,4,0,0" Width="120" Padding="6,4"
                                 Text="{Binding ProbeTimeoutText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Empty — use defaults."
                           FontSize="11" Foreground="Gray" Margin="0,4,0,0"/>

                <TextBlock Text="UPDATES" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,20,0,0"/>
                <CheckBox Margin="0,6,0,0"
                          Content="Check for updates on startup"
                          IsChecked="{Binding CheckForUpdatesOnStartup, Mode=TwoWay}"/>
                <Button Content="Check for updates"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Padding="10,5"
                        Command="{Binding CheckForUpdatesCommand}"/>
                <TextBlock Text="{Binding UpdateMessage}"
                           FontSize="12" Foreground="#2C3E50" Margin="0,6,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="{Binding ValidationError}"
                           FontSize="12" Foreground="#C0392B" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#ECF0F1" BorderBrush="#D0D7DE" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CLIHub" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                    <Border Background="#DDE3E8" CornerRadius="8" Padding="8,2" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Version}" FontSize="11" Foreground="#2C3E50"/>
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Content="Save" IsDefault="True" Padding="16,5" Margin="0,0,8,0"
                        Background="#3498DB" Foreground="White" BorderThickness="0"
                        Command="{Binding SaveCommand}"/>
                <Button Grid.Column="2" Content="Cancel" Padding="16,5"
                        Command="{Binding CancelCommand}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
