<Window x:Class="CLIHub.Windows.LaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:CLIHub.Converters"
        mc:Ignorable="d"
        Title="CLIHub - AI Agent Launcher"
        Height="640" Width="980"
        MinHeight="440" MinWidth="760"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Window-scoped implicit styles: the dark theme applies to this window only. -->
                <ResourceDictionary Source="/Themes/LaunchWindowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:PathToImageConverter x:Key="PathToImage"/>
            <conv:MiddleEllipsisConverter x:Key="MiddleEllipsis"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10,10,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Panes -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.6*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- PROJECTS pane -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="10"
                    Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="PROJECTS"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"/>
                        <Menu HorizontalAlignment="Right" VerticalAlignment="Center">
                            <MenuItem Header="Actions">
                                <MenuItem Header="Add Project..."
                                          Command="{Binding AddProjectCommand}"/>
                                <MenuItem Header="Remove Project"
                                          Command="{Binding RemoveProjectCommand}"/>
                                <MenuItem Header="Toggle Favorite"
                                          Command="{Binding ToggleFavoriteCommand}"/>
                                <Separator/>
                                <MenuItem Header="Refresh"
                                          Command="{Binding RefreshCommand}"/>
                            </MenuItem>
                        </Menu>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Projects}"
                             SelectedItem="{Binding SelectedProject, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            CornerRadius="8">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding LogoPath, Converter={StaticResource PathToImage}}"
                                                        Stretch="Uniform"/>
                                        </Border.Background>
                                    </Border>

                                    <StackPanel x:Name="ProjectRowText" Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11"
                                                   Foreground="{StaticResource DimmedTextBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource MiddleEllipsis}">
                                                    <Binding Path="Path"/>
                                                    <Binding Path="ActualWidth" ElementName="ProjectRowText"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="★"
                                               FontSize="13"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- AGENTS pane -->
            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="10"
                    Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="AGENTS"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"/>
                        <Menu HorizontalAlignment="Right" VerticalAlignment="Center">
                            <MenuItem Header="Actions">
                                <MenuItem Header="Launch"
                                          Command="{Binding LaunchCommand}"/>
                                <MenuItem Header="Resume Session"
                                          Command="{Binding ResumeCommand}"/>
                                <MenuItem Header="Initialize"
                                          Command="{Binding InitCommand}"/>
                                <MenuItem Header="Update"
                                          Command="{Binding UpdateCommand}"/>
                                <MenuItem Header="Show Version"
                                          Command="{Binding VersionCommand}"/>
                                <Separator/>
                                <MenuItem Header="Only agents available in project"
                                          IsCheckable="True"
                                          IsChecked="{Binding ShowOnlyProjectAgents, Mode=TwoWay}"/>
                                <Separator/>
                                <MenuItem Header="Refresh"
                                          Command="{Binding RefreshCommand}"/>
                            </MenuItem>
                        </Menu>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Agents}"
                             SelectedItem="{Binding SelectedAgent, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Opacity="{Binding RowOpacity}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="28"
                                            Height="28"
                                            CornerRadius="6"
                                            VerticalAlignment="Center">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding LogoPath, Converter={StaticResource PathToImage}}"
                                                        Stretch="Uniform"/>
                                        </Border.Background>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Version}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="▶"
                                                Width="32"
                                                Height="28"
                                                Padding="0"
                                                Focusable="False"
                                                FontSize="12"
                                                ToolTip="Launch"
                                                Command="{Binding DataContext.LaunchAgentCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="↻"
                                                Width="32"
                                                Height="28"
                                                Padding="0"
                                                Margin="6,0,0,0"
                                                Focusable="False"
                                                FontSize="12"
                                                ToolTip="Resume session"
                                                Command="{Binding DataContext.ResumeAgentCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Padding="10,8"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource SeparatorBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="CLIHub"
                           FontSize="15"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Border Grid.Column="1"
                        Margin="10,0,0,0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Background="{StaticResource ControlSurfaceBrush}"
                        CornerRadius="10">
                    <TextBlock Text="{Binding VersionText}"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                </Border>

                <Button Grid.Column="2"
                        Margin="10,0,0,0"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Content="Check for updates"
                        Command="{Binding CheckForUpdatesCommand}"/>

                <TextBlock Grid.Column="3"
                           Margin="12,0"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Width="34"
                            Height="28"
                            Padding="0"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            ToolTip="Add project"
                            Content="&#xE8B7;"
                            Command="{Binding AddProjectCommand}"/>
                    <Button Width="34"
                            Height="28"
                            Padding="0"
                            Margin="6,0,0,0"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            ToolTip="Settings"
                            Content="&#xE713;"
                            Command="{Binding OpenSettingsCommand}"/>
                    <Button Width="34"
                            Height="28"
                            Padding="0"
                            Margin="6,0,0,0"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            ToolTip="Exit CLIHub"
                            Content="&#xE7E8;"
                            Command="{Binding ExitCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
