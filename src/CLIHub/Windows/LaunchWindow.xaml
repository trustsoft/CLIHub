<Window x:Class="CLIHub.Windows.LaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:themes="clr-namespace:CLIHub.Themes"
        mc:Ignorable="d"
        Title="CLIHub"
        Background="{StaticResource ChromeBgBrush}"
        FontFamily="{StaticResource Sizing.FontFamily.Text}"
        KeyDown="OnKeyDown"
        Deactivated="OnDeactivated"
        PreviewMouseLeftButtonDown="OnWindowMouseDown"
        PreviewMouseLeftButtonUp="OnSplitterMouseUp"
        PreviewMouseMove="OnSplitterMouseMove"
        MinHeight="240"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        SourceInitialized="OnSourceInitialized"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Window.Resources>
        <!-- Window-scoped styles: the dark theme applies to this window only. -->
        <ResourceDictionary Source="/Themes/LaunchWindowStyles.xaml"/>
    </Window.Resources>

    <Border BorderBrush="{StaticResource FieldStrokeBrush}" BorderThickness="1">
        <StackPanel>

            <!-- Inset top highlight (mockup chrome) -->
            <Rectangle Height="1" Fill="{StaticResource TopHighlightBrush}"/>

            <!-- Panes -->
            <Grid x:Name="PanesGrid">
                <Grid.ColumnDefinitions>
                    <!-- Projects pane hugs its list; the splitter still resizes it on drag, but never
                         below the width its list needs. -->
                    <ColumnDefinition Width="Auto" MinWidth="{StaticResource Sizing.Width.MinProjectPane}"/>
                    <!-- Optional splitter column: sized by the thumb, so the drag area is wider than the hairline. -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Agents pane and its rows are content sized too, so the window fits its content. -->
                    <ColumnDefinition Width="Auto" MinWidth="{StaticResource Sizing.Width.MinAgentPane}"/>
                </Grid.ColumnDefinitions>

                <!-- Projects pane -->
                <Border Grid.Column="0" Style="{StaticResource PaneSurface}">
                    <DockPanel Margin="{StaticResource Sizing.PaneMargin}">
                        <Grid DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                            <TextBlock Margin="2,0,0,0" Style="{StaticResource SectionLabel}" Text="PROJECTS"/>
                            <Button x:Name="ProjectsActionsButton"
                                    HorizontalAlignment="Right"
                                    Click="OnOpenProjectsMenu"
                                    Content="Actions"
                                    Style="{StaticResource PaneActionsButton}">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource DarkContextMenu}">
                                        <ContextMenu.Resources>
                                            <!-- Items are styled implicitly; MenuSeparator keeps its explicit style -->
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItem}"/>
                                        </ContextMenu.Resources>
                                        <MenuItem Command="{Binding AddProjectCommand}"
                                                  Header="Add Project...">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuIcon}" Text="{x:Static themes:IconGlyphs.Add}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Command="{Binding RemoveProjectCommand}"
                                                  Header="Remove Project">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuIcon}" Text="{x:Static themes:IconGlyphs.Delete}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Command="{Binding ToggleFavoriteCommand}"
                                                  Header="Toggle Favorite">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuIcon}" Text="{x:Static themes:IconGlyphs.FavoriteStar}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Command="{Binding RefreshCommand}"
                                                  Header="Refresh">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuIcon}" Text="{x:Static themes:IconGlyphs.Refresh}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>

                        <ListBox ItemContainerStyle="{StaticResource ProjectRowContainer}"
                                 ItemsSource="{Binding Projects}"
                                 MinWidth="{StaticResource Sizing.Width.MinProjectList}"
                                 SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                 Style="{StaticResource PaneList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="{StaticResource Sizing.Height.ProjectLogo}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Star column so the row fills the list width, while the
                                                 item's own desired width stays content driven. -->
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="{StaticResource Sizing.Width.ProjectLogo}"
                                                Height="{StaticResource Sizing.Height.ProjectLogo}"
                                                Background="{StaticResource ThumbBgBrush}"
                                                BorderBrush="{StaticResource FieldStrokeBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Sizing.CornerRadius.ProjectLogo}">
                                            <Border Margin="1" CornerRadius="{StaticResource Sizing.CornerRadius.ProjectLogo}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding LogoPath, Converter={StaticResource PathToImage}}"
                                                                Stretch="Uniform"/>
                                                </Border.Background>
                                            </Border>
                                        </Border>

                                        <StackPanel
                                                    Grid.Column="1"
                                                    Margin="15,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock FontSize="{StaticResource Sizing.FontSize.Name}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="{StaticResource Sizing.FontSize.Body}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource PathDisplay}"
                                                                  ConverterParameter="{StaticResource Sizing.ProjectRowTextInsets}">
                                                        <Binding Path="Path"/>
                                                        <!-- The list's measured width: the path is the elastic part of a row,
                                                             so it is trimmed to whatever the list currently offers. The list's
                                                             own width converges to its 300px minimum (or to a manually dragged
                                                             pane width), because each layout pass trims the path a little more. -->
                                                        <Binding Path="ActualWidth"
                                                                 RelativeSource="{RelativeSource AncestorType={x:Type ListBox}}"/>
                                                        <Binding Path="DataContext.DisplayStyle"
                                                                 RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                                                        <!-- Favourite marker widens the row, the TextBlock measures the text. -->
                                                        <Binding Path="IsFavorite"/>
                                                        <Binding RelativeSource="{RelativeSource Self}"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Text="â˜…"
                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Pane divider: hairline with a wider splitter hit area -->
                <Border Grid.Column="1" Background="{StaticResource StripBgBrush}"/>
                <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Center" Fill="{StaticResource FieldStrokeBrush}"/>
                <Rectangle x:Name="PaneSplitter"
                           Grid.Column="1"
                           Width="{StaticResource Sizing.SplitterHitWidth}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Stretch"
                           Cursor="SizeWE"
                           Fill="Transparent"/>

                <!-- Agents pane -->
                <Border Grid.Column="2" Style="{StaticResource PaneSurface}">
                    <DockPanel Margin="{StaticResource Sizing.PaneMargin}">
                        <Grid DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                            <TextBlock Margin="2,0,0,0" Style="{StaticResource SectionLabel}" Text="AGENTS"/>
                            <Button x:Name="AgentsActionsButton"
                                    HorizontalAlignment="Right"
                                    Click="OnOpenAgentsMenu"
                                    Content="Actions"
                                    Style="{StaticResource PaneActionsButton}">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource DarkContextMenu}">
                                        <ContextMenu.Resources>
                                            <!-- Items are styled implicitly; MenuSeparator keeps its explicit style -->
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItem}"/>
                                        </ContextMenu.Resources>
                                        <MenuItem Command="{Binding LaunchCommand}"
                                                  Header="Launch">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuIcon}" Text="{x:Static themes:IconGlyphs.Play}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Command="{Binding ResumeCommand}"
                                                  Header="Resume Session">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuIcon}" Text="{x:Static themes:IconGlyphs.Refresh}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Command="{Binding InitCommand}"
                                                  Header="Initialize">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuIcon}" Text="{x:Static themes:IconGlyphs.Initialize}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Command="{Binding UpdateCommand}"
                                                  Header="Update">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuIcon}" Text="{x:Static themes:IconGlyphs.Update}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Command="{Binding VersionCommand}"
                                                  Header="Show Version">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuIcon}" Text="{x:Static themes:IconGlyphs.Version}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Style="{StaticResource MenuSeparator}"/>
                                        <MenuItem Header="Only agents available in project"
                                                  IsCheckable="True"
                                                  IsChecked="{Binding ShowOnlyProjectAgents, Mode=TwoWay}">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuIcon}" Text="{x:Static themes:IconGlyphs.Filter}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Style="{StaticResource MenuSeparator}"/>
                                        <MenuItem Command="{Binding RefreshCommand}"
                                                  Header="Refresh">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuIcon}" Text="{x:Static themes:IconGlyphs.Refresh}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>

                        <ListBox AlternationCount="100000"
                                 ItemContainerStyle="{StaticResource AgentRowContainer}"
                                 ItemsSource="{Binding Agents}"
                                 SelectedItem="{Binding SelectedAgent, Mode=TwoWay}"
                                 Style="{StaticResource PaneList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="{StaticResource Sizing.Height.AgentRow}" Opacity="{Binding RowOpacity}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Spacer: pushes the action buttons to the row's right edge,
                                                 while the row's own width stays content driven. -->
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Width="{StaticResource Sizing.Width.AgentLogo}"
                                               Height="{StaticResource Sizing.Height.AgentLogo}"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding LogoPath, Converter={StaticResource PathToImage}}"
                                               Stretch="Uniform"/>

                                        <StackPanel Grid.Column="1"
                                                    Margin="{StaticResource Sizing.Margin.AgentRowText}"
                                                    MaxWidth="{StaticResource Sizing.Width.MaxAgentText}"
                                                    VerticalAlignment="Center">
                                            <TextBlock FontSize="{StaticResource Sizing.FontSize.Name}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="0,1,0,0"
                                                       FontSize="{StaticResource Sizing.FontSize.Section}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="{Binding Version}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <Button Margin="0,0,6,0"
                                                    Command="{Binding DataContext.LaunchAgentCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource AgentActionButton}"
                                                    ToolTip="Launch">
                                                <Path Width="10"
                                                      Height="10"
                                                      Data="{StaticResource PlayGlyph}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Stretch="Uniform"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.ResumeAgentCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource AgentActionButton}"
                                                    ToolTip="Resume session">
                                                <Grid Width="14" Height="14">
                                                    <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                             StrokeThickness="1.4"/>
                                                    <Path Width="6"
                                                          Height="6"
                                                          Margin="1.5,0,0,0"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="{StaticResource PlayGlyph}"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Stretch="Uniform"/>
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <Rectangle Height="1" Margin="12,0" Fill="{StaticResource HairlineBrush}"/>

            <!-- Footer: brand and version left, update check beside it, status centered, actions right -->
            <Grid Height="{StaticResource Sizing.Height.Footer}" Background="{StaticResource StripBgBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Style="{StaticResource BrandText}" Text="CLIHub"/>
                    <Border Margin="12,2,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource VersionChipBorder}">
                        <TextBlock Style="{StaticResource VersionChipText}" Text="{Binding VersionText}"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding CheckForUpdatesCommand}"
                        Content="Check for updates"
                        Style="{StaticResource FooterTextButton}"/>

                <TextBlock Grid.Column="2"
                           Margin="12,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource Sizing.FontSize.Body}"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="{Binding StatusMessage}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="3"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Command="{Binding OpenDataFolderCommand}"
                            Style="{StaticResource PopupIconButton}"
                            ToolTip="Open data folder">
                        <TextBlock Style="{StaticResource FooterIcon}" Text="{x:Static themes:IconGlyphs.FolderOpen}"/>
                    </Button>
                    <Button Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource PopupIconButton}"
                            ToolTip="Settings">
                        <TextBlock Style="{StaticResource FooterIcon}" Text="{x:Static themes:IconGlyphs.Settings}"/>
                    </Button>
                    <ToggleButton IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                  Style="{StaticResource PopupToggleIconButton}"
                                  ToolTip="Keep the window open when it loses focus">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource FooterIcon}" TargetType="TextBlock">
                                    <Setter Property="Text" Value="{x:Static themes:IconGlyphs.Pin}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Text" Value="{x:Static themes:IconGlyphs.Pinned}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ToggleButton>
                    <Button Command="{Binding ExitCommand}"
                            Style="{StaticResource PopupIconButton}"
                            ToolTip="Exit CLIHub">
                        <TextBlock Style="{StaticResource FooterIcon}" Text="{x:Static themes:IconGlyphs.Exit}"/>
                    </Button>
                </StackPanel>
            </Grid>

        </StackPanel>
    </Border>
</Window>
