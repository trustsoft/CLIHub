<Window x:Class="CLIHub.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CLIHub.Windows"
        xmlns:conv="clr-namespace:CLIHub.Converters"
        mc:Ignorable="d"
        Title="CLIHub - AI Agent Launcher" 
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:PathToImageConverter x:Key="PathToImage"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="CLIHub" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="White" 
                          VerticalAlignment="Center"/>
                <TextBlock Text="AI Agent Launcher" 
                          FontSize="14" 
                          Foreground="#BDC3C7" 
                          VerticalAlignment="Center"
                          Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Projects List -->
            <GroupBox Grid.Column="0" Header="Projects" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="ProjectList"
                             Grid.Row="0"
                             Margin="5"
                             SelectionChanged="ProjectList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Image Width="32" Height="32" Margin="0,0,8,0"
                                           Source="{Binding LogoPath, Converter={StaticResource PathToImage}}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="1"
                            Content="Add Project..."
                            Margin="5"
                            Padding="10,5"
                            Click="AddProject_Click"/>
                </Grid>
            </GroupBox>

            <!-- Agents List -->
            <GroupBox Grid.Column="1" Header="AI Agents">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="AgentList"
                             Grid.Row="0"
                             Margin="5"
                             SelectionChanged="AgentList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Image Width="24" Height="24" Margin="0,0,8,0"
                                           Source="{Binding LogoPath, Converter={StaticResource PathToImage}}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="Gray"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="1" Margin="5">
                        <Button Content="Launch" Margin="0,0,5,5" Padding="10,5" Click="Launch_Click"/>
                        <Button Content="Resume" Margin="0,0,5,5" Padding="10,5" Click="Resume_Click"/>
                        <Button Content="Init" Margin="0,0,5,5" Padding="10,5" Click="Init_Click"/>
                        <Button Content="Update" Margin="0,0,5,5" Padding="10,5" Click="Update_Click"/>
                        <Button Content="Version" Margin="0,0,5,5" Padding="10,5" Click="Version_Click"/>
                    </WrapPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#34495E" Padding="10,5">
            <TextBlock x:Name="StatusText" 
                      Text="CLIHub ready" 
                      Foreground="#BDC3C7" 
                      FontSize="12"
                      TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
