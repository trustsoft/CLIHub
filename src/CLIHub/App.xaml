<Application x:Class="CLIHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CLIHub.Converters"
             xmlns:local="clr-namespace:CLIHub"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Palette only: shared brushes, no implicit styles, so other windows are unaffected. -->
                <ResourceDictionary Source="/Themes/LaunchTheme.xaml"/>
                <!-- Shared keyed styles (button templates, typography, DarkToolTip). -->
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
                <!--
                    The slim dark scrollbar lives here, not in a window dictionary: implicit styles
                    from window resources do not reach the scrollbars inside ScrollViewer and ListBox
                    templates — only application-level implicit styles do.
                -->
                <ResourceDictionary Source="/Themes/DarkScrollBar.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared converters, referenced from window content by key. -->
            <conv:PathToImageConverter x:Key="PathToImage"/>
            <conv:PathDisplayConverter x:Key="PathDisplay"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

            <!--
                Dark tooltips everywhere: like scrollbars, tooltips live outside the window's visual
                tree, so the implicit style must sit at the application level.
            -->
            <Style TargetType="ToolTip" BasedOn="{StaticResource DarkToolTip}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
