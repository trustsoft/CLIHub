<Application x:Class="CLIHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CLIHub.Converters"
             xmlns:local="clr-namespace:CLIHub"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Palette only: shared brushes, no implicit styles, so other windows are unaffected. -->
                <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
                <!-- Shared keyed styles (button templates, typography, DarkToolTip). -->
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
                <!--
                    The slim scrollbar lives here, not in a window dictionary: implicit styles
                    from window resources do not reach the scrollbars inside ScrollViewer and ListBox
                    templates — only application-level implicit styles do.
                -->
                <ResourceDictionary Source="/Themes/SlimScrollBar.xaml"/>
                <!--
                    Settings input/control templates: shared across Settings pages (UserControls).
                    Merged at application level because UserControls are built before they attach
                    to the window tree — window-scoped resources are not reachable during XAML load.
                    Contains the NumericField implicit style used by Settings pages.
                -->
                <ResourceDictionary Source="/Themes/SettingsControls.xaml"/>
                <!--
                    Settings window styles and page chrome: shared with the extracted Settings pages
                    (UserControls). A UserControl is built before it attaches to the window tree, so
                    window-scoped resources are not reachable during its load — application-level
                    placement is required, like the scrollbar and tooltip styles above. Note: this
                    dictionary contains 3 implicit (keyless) styles for CLIHub.Controls custom types
                    (SectionHeader, SettingCard, SettingsGroup); they are intentional and currently
                    used only by Settings pages.
                -->
                <ResourceDictionary Source="/Themes/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared converters, referenced from window content by key. The PathToImage
                 converter is assigned at startup from the DI container (see ApplicationHost),
                 backed by the shared decoded-image cache. -->
            <conv:PathDisplayConverter x:Key="PathDisplay"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

            <!--
                Dark tooltips everywhere: like scrollbars, tooltips live outside the window's visual
                tree, so the implicit style must sit at the application level.
            -->
            <Style TargetType="ToolTip" BasedOn="{StaticResource DarkToolTip}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
