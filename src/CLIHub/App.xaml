<Application x:Class="CLIHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CLIHub.Converters"
             xmlns:local="clr-namespace:CLIHub"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Palette only: shared brushes, no implicit styles, so other windows are unaffected. -->
                <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
                <!--
                    The slim scrollbar lives here, not in a window dictionary: implicit styles
                    from window resources do not reach the scrollbars inside ScrollViewer and ListBox
                    templates — only application-level implicit styles do.
                -->
                <ResourceDictionary Source="/Themes/SlimScrollBar.xaml"/>
                <!--
                    Settings window and page chrome. SettingsStyles.xaml is the application-level entry
                    point for the settings layer: it merges Controls.xaml (shared keyed styles),
                    ThemePickerData.xaml (theme/accent picker data), and SettingsControls.xaml
                    (input/control templates), while those dictionaries merge Sizing.xaml for their own
                    token lookups. Together they provide settings chrome, picker data, input templates,
                    sizing tokens, and the implicit custom-control styles (SectionHeader, SettingCard,
                    SettingsGroup, NumericField). Merged at application level because Settings pages are
                    UserControls built before they attach to the window tree — window-scoped resources are
                    not reachable during their XAML load. Controls.xaml is loaded exactly once for the
                    application, through this entry.
                -->
                <ResourceDictionary Source="/Themes/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared converters, referenced from window content by key. The PathToImage
                 converter is assigned at startup from the DI container (see ApplicationHost),
                 backed by the shared decoded-image cache. -->
            <conv:PathDisplayConverter x:Key="PathDisplay"/>
            <conv:ThemeBrushKeyConverter x:Key="ThemeBrushKey"/>
            <!--
                Page host wiring: page metadata names the header and summary templates, and these
                converters turn a key into the slot's ContentTemplate and visibility. The template
                lookup starts at the slot element because SettingsWindow declares those templates in
                its own window resources, which Application.TryFindResource cannot reach.
            -->
            <conv:ResourceKeyToTemplateConverter x:Key="ResourceKeyToTemplate"/>
            <conv:EmptyToCollapsedVisibilityConverter x:Key="EmptyToCollapsedVisibility"/>
            <conv:PageKeyVisibilityConverter x:Key="PageKeyVisibility"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

            <!--
                Dark tooltips everywhere: like scrollbars, tooltips live outside the window's visual
                tree, so the implicit style must sit at the application level.
            -->
            <Style TargetType="ToolTip" BasedOn="{StaticResource DarkToolTip}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
