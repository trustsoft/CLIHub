{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "scryer": {
      "type": "local",
      "command": [
        "scryer-mcp"
      ],
      "enabled": true
    }
  }
}
