{
  "schemaVersion": 1,
  "id": "opencode",
  "name": "OpenCode",
  "actions": {
    "run": { "command": "opencode" },
    "resume": { "command": "opencode --continue" },
    "update": { "command": "opencode upgrade", "runtime": "ps" },
    "version": { "command": "opencode --version" }
  },
  "detect": { "project": ["opencode.json", "opencode.jsonc", ".opencode"] }
}
